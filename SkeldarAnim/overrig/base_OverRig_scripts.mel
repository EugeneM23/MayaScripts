frameLayout -ann $Overrig_version
	-p "ovrrig_columnLayout1_ui"
	-bgc $red[0] $red[1] $red[2]
	-ebg true
	-bv false
	-cl 0
	-cll true
	-l "miscellaneous"
	-la "top"
	-lw 0
	-mw 0
	-cc "catchQuiet(`window -e -h 100 basicOverRigScripts`)"
	misc_BOR_fr_lay_ui;
{
int $l_p_h=20;
	columnLayout -rs 2 -p "misc_BOR_fr_lay_ui" -adj 1 misc_BOR_fr_lay_ui_colmn;
	rowLayout  -p "misc_BOR_fr_lay_ui_colmn"  -nc 4 -adj 3    -cal 1 left -cal 2 right "misc_mt_ui";
		button -l "X"
			-w 20
			-ann "kill ALL motion trails"
			-c "BOVER_10_2_cab45c22668192720cf5bc40a90b9717()"
			mt_delete;
		button -l "MT all"
			-w 43
			-bgc 0.7 0.755 0.780
			-c "bar_create_multiply_fast_motion_trail(0, 0, 1)"
			-ann "scene MotionTrail."
			mt_rngAll;
		nodeIconButton -style "iconAndTextHorizontal"
    -image1 "nudgeDown.png" -l "MT ranged"
			-w 63
			-h 23
			-bgc 0.7 0.755 0.780
			-ann "ranged MotionTrail. RMB for set trail RANGE and SPACE"
			-c "bar_create_multiply_fast_motion_trail(0, 0, 0)"
			mt_rngRng;
			popupMenu -button 3 -parent mt_rngRng;
				menuItem -divider true -dividerLabel "trail range";
