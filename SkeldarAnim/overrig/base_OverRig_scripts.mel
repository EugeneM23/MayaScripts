		if(!`getAttr -lock ($obj + ".tx") `)
			setAttr ($obj + ".tx") 0;
		if(!`getAttr  -lock ($obj + ".ty") `)
			setAttr ($obj + ".ty") 0;
		if(!`getAttr  -lock ($obj + ".tz")`)
			setAttr ($obj + ".tz") 0;
	}
}
global proc BOVER_10_2_931471e30d3bd1b159549c01ad9a4cd2()
{
	string $selected[]= `ls -sl`;
	if(size($selected)==0)
	{
		warning "select something!!!!";
		return;
	}
	string $crvs[] = `keyframe -q -n`;
	float $statTime[] = `keyframe -index 0 -q -tc $crvs`;
	$statTime=`sort $statTime`;
	float $null_frame = $statTime[0] - 10;
	catchQuiet(`setKeyframe -v 0 -t $null_frame -at rotateX -at rotateY -at rotateZ`) ;
	catchQuiet(`filterCurve $selected.rotateX $selected.rotateY $selected.rotateZ`);
	selectKey -clear;
	catchQuiet(`cutKey -t $null_frame  -at rotateX -at rotateY -at rotateZ `);
	selectKey -clear;
}
