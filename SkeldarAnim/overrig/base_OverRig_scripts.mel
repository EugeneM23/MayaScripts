	euler_filter_on_selected;
	BOVER_10_2_f4b1a2b52ab1771321003f86cde63160;
	delete $dup_lock;
	for($j=0;$j<size($locators);$j++)
	    {
	        setAttr -lock 0 ($locators[$j] + ".sx");
	        connectAttr -f ($locators[$j] + ".speed") ($locators[$j] + ".scaleX");
	    }
	currentTime $time;
	select $locators;
	return $locators;
}
