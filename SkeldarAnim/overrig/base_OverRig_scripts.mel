global proc execute_overlap_command(int $chain, string $base_clth_j[], float $len, float $sdvig,  float $sdvig_side,float $smooth_end, int $cycle,int $abs_mode, int $save_edge)
{
	if (size ($base_clth_j)==0)
	{
		print "\n\n\n\nnothing selected!!! select something!\n";
		undoInfo -cck;
		return;
	}
	BOVER_10_2_692e2fda85cadfdf0f28e93323f58c08;
	undoInfo -ock -cn "execute_overlap_command";
    global string $gPlayBackSlider;
	float $selectedTime[]=`timeControl -q -ra $gPlayBackSlider`;
    int $partial_mode=0;
	float $min_frOld=`playbackOptions -q -ast`;
	float $max_frOld=`playbackOptions -q -aet`;
	float $min_in_frOld=`playbackOptions -q -min`;
	float $max_in_frOld=`playbackOptions -q -max`;
	float $min_fr=$min_frOld;
	float $max_fr=$max_frOld;
	if($selectedTime[1]-$selectedTime[0]>1)
	{
	    $partial_mode=1;
	    $min_fr=$selectedTime[0];
	    $max_fr=$selectedTime[1]-1;
	    playbackOptions -ast $min_fr -aet $max_fr;
	}
	int $zero_percent=($max_fr-$min_fr)/5;
	global string $BARN_curve_sword_remember_SOURCE[];
	clear $BARN_curve_sword_remember_SOURCE;
	$BARN_curve_sword_remember_SOURCE=`ls-fl-sl`;
	float $time=`currentTime -q`;
	string $object_type,$clth_j[];
	if($chain)
	{
		$base_clth_j=BOVER_10_2_4444d6118d676b89ef3372a0f3254e9f($base_clth_j);
    	for($obj in $base_clth_j)
    	{
    		select -cl  ;
    		select $obj;
    		$object_type=BOVER_10_2_c884f4200431a153fb44b960cecbef34($obj);
    		select -hi;
    		$clth_j=BOVER_10_2_1ed150b12535ee196bee8b74a6bf5f5c(`ls-sl`, $object_type);
    		BOVER_10_2_7f3473239f5affa2a0790f0c6db6aaf9($clth_j, $len,  $sdvig, $sdvig_side, $smooth_end, $cycle, $abs_mode, $save_edge, $min_fr, $max_fr, $zero_percent, $partial_mode);
    	}
	}
    else
        BOVER_10_2_7f3473239f5affa2a0790f0c6db6aaf9($base_clth_j, $len,  $sdvig, $sdvig_side, $smooth_end, $cycle, $abs_mode, $save_edge, $min_fr, $max_fr, $zero_percent, $partial_mode);
    if($partial_mode)
        playbackOptions -ast $min_frOld  -aet $max_frOld -min $min_in_frOld -max $max_in_frOld;
	print ("Overlap done.\n");
	select $BARN_curve_sword_remember_SOURCE;
	undoInfo -cck;
	BOVER_10_2_f4b1a2b52ab1771321003f86cde63160;
}
global proc bar_tail_overlap_window()
{
    if(`window -q -ex "BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86"`)deleteUI("BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86");
    window -mnb false   -mxb false -t "tail overlap" -bgc 1.0 0.9  0.8   -tb true -s 1 -tlb true -mb true "BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86";
		columnLayout -w 560  -p "BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86";
			int $col_size=70;
			rowLayout   -cw 1 $col_size  -cw 2 $col_size -cw 3 $col_size -cw 4 $col_size -cw 5 $col_size -cw 6 $col_size -nc 9;
				text -l "";
				text "softness";
				text "lag";
				text -l "";
				text "easing";
			rowLayout -cw 1 $col_size  -cw 2 $col_size -cw 3 $col_size -cw 4 $col_size -cw 5 $col_size -adj 8  -nc 8 -p "BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86";
				checkBox -ann "every selection - root of chain" -v 1 -l "hierarchy" "root_mode";
				floatField -v 2.0 -s 0.1 -pre 1 -ann "softness" "softness_overlap";
				floatField -v 1.0 -pre 1 -ann "lag every control" "lag_overlap";
				checkBox -ann "absolute mode - total lag" -l "abs offset" "abs_mode_overlap";
				floatField -v 0 -pre 1 -min 0 -ann "smooth movement - remove noise" "smooth_end_overlap";
				checkBox -ann "cycled or no" -l "cycled" "cycled_overlap";
				checkBox -ann "save edge poses in separate additive layer" -l "save poses" "save_pose_overlap";
				button -bgc 0.6 0.9 0.6
					-c "execute_overlap_command(`checkBox -q -v root_mode`,`ls-fl-sl`,`floatField -q -v softness_overlap`,`floatField -q -v lag_overlap`,0,`floatField -q -v smooth_end_overlap`,`checkBox -q -v cycled_overlap`,`checkBox -q -v abs_mode_overlap`,`checkBox -q -v save_pose_overlap`); "
					-l "execute" "execute";
		frameLayout
				-p "BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86"
				-bgc 0.2 0.555 0.580
				-ebg true
				-bv false
				-cl 1
				-cll true
				-l "help"
				-la "top"
				-lw 5
				-mw 5
				-mh 2
				-ec "catchQuiet(`window -e -h 225 BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86`)"
				-cc "catchQuiet(`window -e -h 80 BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86`)"
				tail_overlap_help;
			columnLayout  -w 550 -adj 1;
				textScrollList -allowMultiSelection 0  -ebg 1 -h 140 -bgc 1.0 0.9  0.8 -en 1 -highlightColor 0.2 0.555 0.580
					-append "    select a chain of bones from top to bottom, or the first objects in several chains "
					-append "     "
					-append "    hierarchy - selected objects are the first control of chains "
					-append "    softness - The smaller it is, the more overlapp there is"
					-append "    lag - lag of each link relative to the previous one - the greater the lag, the more flexible the chain"
					-append "    abs offset - lag of the whole chain in frames relative to the whole animation, recorded in the lag forw"
					-append "    easing - removes the shaking from the animation"
					-append "    cycled - loop or no"
					-append "    save poses - save edge poses in separate additive layer"
			myControlObj;
			separator -h 3 -style "none";
    showWindow "BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86";
    window -e   -h  80 BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86;
