global proc string[] BOVER_10_2_8376d3c88e88e41ef8187476da85d4e4(string $targets[], string $objects[], int $rotation, int $translation)
{
	global string $gPlayBackSlider;
	float $frame_range[]=`timeControl -q -ra $gPlayBackSlider`;
	if($rotation==0&&$translation==0)
	{
		warning "incorrect operation mode";
		return {};
	}
	BOVER_10_2_bb5805895dc14a829576cd013ec234e4($objects);
	select $objects;
	string $temp_locators[]= create_normalised_locators_on_selected();
	$temp_locators=BOVER_10_2_c9088e941b7677113499bb19ad80f9bf ("par_in_", $objects);
	BOVER_10_2_c89bf830cdb2b9cc874e6c8604e8b257;
	BOVER_10_2_29941243f77aa0343e79460d48136072 (8);
	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(18);
	BOVER_10_2_3323b46f97bc12510f86536ae21ff525;
	global int $barnev_OverRig_RotateOrder;
			if($barnev_OverRig_RotateOrder==6)
				BOVER_10_2_d1b73d0512bac8d20998bdbab9b3aed7($objects, $temp_locators);
			else
				BOVER_10_2_d04a25c84de52f4787d68215d32315e0($barnev_OverRig_RotateOrder,$temp_locators);
	delete (BOVER_10_2_ac2021d0d7ff3ecfad4dbca9f9f88248 ($objects,$temp_locators));
	print "==================================\n";
	print $rotation;
	print "==================================\n";
	print $translation;
	if($rotation==1&&$translation==0)
		BOVER_10_2_6c6f83c66f3818896ad0dc0e721c7361($objects, $temp_locators);
	if($rotation==1&&$translation==1)
		BOVER_10_2_17431451b1be026fdeee93b86579c6b6($objects, $temp_locators);
	if($rotation==0&&$translation==1)
		BOVER_10_2_6ad69c51dd9284075334f0933a4848c6($objects, $temp_locators);
	BOVER_10_2_32a3829df17c3736d9757e423eeaf0e3($targets,$temp_locators);
	select -r $temp_locators;
	if($frame_range[1]-$frame_range[0]>1)
	    BOVER_10_2_e02b9af8de573969d2834f5d4e4228fd(($frame_range[0]-1), $frame_range[1], $temp_locators);
	else
	    BOVER_10_2_de88efca2929f0080ae1d45ff5db42d4;
	if($rotation==1&&$translation==0)
		catch ($constr_names=BOVER_10_2_6c6f83c66f3818896ad0dc0e721c7361($temp_locators, $objects));
	if($rotation==1&&$translation==1)
		catch ($constr_names=BOVER_10_2_17431451b1be026fdeee93b86579c6b6($temp_locators, $objects));
	if($rotation==0&&$translation==1)
		catch ($constr_names=BOVER_10_2_6ad69c51dd9284075334f0933a4848c6($temp_locators, $objects));
	catch(BOVER_10_2_f0549514de82c9ee2236723b537462e7($temp_locators, $constr_names,"attach", $frame_range, 1));
	euler_filter_on_selected;
	return $temp_locators;
}
global proc string[] BOVER_10_2_f0549514de82c9ee2236723b537462e7(string $objects[], string $constr_names[], string $channel_name, float $frame_range[], int $rotate_quaternion)
{
	string $all_constr_nodes[]=`ls  "barn_logic_or_for_constr_blending*"`;
	for($node in $all_constr_nodes)
		if(!`connectionInfo -ies ($node + ".output[0]")`)
			delete $node;
	string $nodename;
	string $all_expression_names[];
	string $parent_constr_WL[];
	string $attr_name;
	string $p_blend_name[];
	for($i=0;$i<size($objects);$i++)
	{
		$attr_name=($objects[$i] + "." + $channel_name);
		addAttr -ln  $channel_name -nn $channel_name -at double -dv 1 $objects[$i];
		setAttr -e -keyable true  $attr_name;
		if($frame_range[1]-$frame_range[0]>1)
		{
			setKeyframe -itt flat -ott flat -t ($frame_range[0]-1)  -t ($frame_range[0])   -t ($frame_range[1]-1) -t ($frame_range[1]) -v 0 $attr_name;
			keyframe -e    -vc 1 -t ($frame_range[0])   -t ($frame_range[1]-1) $attr_name ;
		}
		setAttr -lock 1 $attr_name;
		$nodename=BOVER_10_2_5be180667c9ec255cdbc3827fe30f0f2($constr_names[$i], "barn_logic_or_for_constr_blending*");
		$p_blend_name=`listConnections  -d 1 -s 0 -scn 1 -type "pairBlend" $constr_names[$i]`;
		if($nodename!="")
			delete $nodename;
		$parent_constr_WL=`parentConstraint -q -wal $constr_names[$i]`;
		$all_expression_names[$i]=BOVER_10_2_a54e109972caf8ac808da7205e765e57("barn_logic_or_for_constr_blending", `size($parent_constr_WL)`);
		connectAttr -f ( $all_expression_names[$i] + ".output[0]") ($p_blend_name[0] + ".weight");
		for($j=0;$j<size($parent_constr_WL);$j++)
