        setKeyframe ($locators[$j] + ".speed");
    }
    playbackOptions   -ps 0;
    float $trans_prev[]={0,0,0};
    autoKeyframe -st 0;
    for($i=$minTR;$i<=$maxTR;$i++)
    {
        currentTime $i;
        BOVER_10_2_847308ac6f1debf8edcc8d63e128d64c($locators, $dup_lock);
        for($j=0;$j<size($locators);$j++)
        {
            $Trans=BOVER_10_2_e70d36ea08e9b8ec1fa4786146236d25($selected[$j]);
            move -rpr $Trans[0] $Trans[1] $Trans[2] $locators[$j];
            setAttr ($locators[$j] + ".speed") (BOVER_10_2_c7822f1f10b007a6803735c105e40799($locators[$j] , $dup_lock[$j]));
            setKeyframe ($locators[$j] + ".speed");
        }
        setKeyframe  $locators $dup_lock;
    }
    autoKeyframe -st 1;
    playbackOptions   -ps $playback_speed;
    select $locators $dup_lock;
    BOVER_10_2_b0a1523d18ddbfe3c562938d09574284;
    for($j=0;$j<size($locators);$j++)
        aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "scene"   $dup_lock[$j] $locators[$j];
    select $locators;
