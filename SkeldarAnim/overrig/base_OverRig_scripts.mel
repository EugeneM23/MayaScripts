global proc string[] BOVER_10_2_10df34add5a583f84d24608e860c1b4b()
{
	global string $select_joint[];
	global string $loc_joint[];
	global string $select_loc_top[];
	global string $select_loc_side[];
	string $constraints[] = {};
	for( $int_i = 0; $int_i < `size $select_joint`; $int_i++ )
	{
		select -r $select_joint[$int_i];
		select -add $select_loc_top[$int_i];
		$constraints[`size $constraints`] = stringArrayToString( `parentConstraint -mo -weight 1`, "" );
		select -r $select_joint[$int_i];
		select -add $select_loc_side[$int_i];
		$constraints[`size $constraints`] = stringArrayToString( `parentConstraint -mo -weight 1`, "" );
	}
	select -cl;
	select  $select_loc_top  $select_loc_side;
	BOVER_10_2_de88efca2929f0080ae1d45ff5db42d4;
	select -cl;
	delete $constraints;
	for( $int_i = 0; $int_i < `size $select_joint`; $int_i++ )
	{
		select -r $select_loc_top[$int_i];
		select -add $select_joint[$int_i];
		catchQuiet (`aimConstraint -mo -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject $select_loc_side[$int_i]`);
	}
	select $select_loc_top $select_loc_side;
	string $aims_lock_to_return[];
	$aims_lock_to_return=`ls-sl`;
	cutKey -cl -t ":" -f ":" -at "rx" -at "ry" -at "rz" $aims_lock_to_return;
	rotate -a 0 0 0 $aims_lock_to_return;
	BOVER_10_2_ef6700cd4efa166b5d6bde47732f420a;
	select -cl;
	select  $select_loc_top;
	return $aims_lock_to_return;
}
global proc string [] BOVER_10_2_c642429ed9a3aabf65a66eefcd97bfbb ()
{
	string $select[] = `ls -sl -l`;
	BOVER_10_2_ac692345fba3e827ad5d6e26de39ba07;
	global string $select_joint[];
	clear($select_joint);
	global string $loc_joint[];
	clear($loc_joint);
	global string $select_loc_top[];
	clear($select_loc_top);
	global string $select_loc_side[];
	clear($select_loc_side);
	$select_joint = $select;
	for( $joint in $select_joint )
	{
		if ( `match "|" $joint` == "" )
		{
			$loc_joint[`size $loc_joint`] = $joint;
		}
		else
		{
			$loc_joint[`size $loc_joint`] = `substitute ".*|" $joint ""`;
		}
	}
	for( $int_i = 0; $int_i < size( $select_joint ); $int_i++)
	{
		string $loc = stringArrayToString( `spaceLocator -name ( $loc_joint[$int_i] + "_top" )`, "" );
		$select_loc_top[$int_i] = $loc;
		eval("setAttr -k off " + $loc + ".scaleX");
		eval("setAttr -k off " + $loc + ".scaleY");
		eval("setAttr -k off " + $loc + ".scaleZ");
		eval("setAttr -k off " + $loc + ".visibility");
		select -r $select_joint[$int_i];
		select -add $loc;
		string $constraint = stringArrayToString( `parentConstraint -dc -weight 1`, "" );
		delete $constraint;
		$loc =  stringArrayToString( `spaceLocator -name ( $loc_joint[$int_i] + "_side" )`, "" );
		$select_loc_side[$int_i] = $loc;
		eval("setAttr -k off " + $loc + ".scaleX");
		eval("setAttr -k off " + $loc + ".scaleY");
		eval("setAttr -k off " + $loc + ".scaleZ");
		eval("setAttr -k off " + $loc + ".visibility");
		select -r $select_joint[$int_i];
		select -add $loc;
		$constraint = stringArrayToString( `parentConstraint -dc -weight 1`, "" );
		delete $constraint;
		setAttr ( $loc + ".overrideEnabled") 1;
		setAttr ( $loc + ".overrideColor") 21;
	}
	select -r $select_loc_top;
	BOVER_10_2_5fce4865a9fd47748e6796c1be9d64b2;
	select -add $select_loc_side;
	BOVER_10_2_3323b46f97bc12510f86536ae21ff525;
	string $aim_lock_to_return[];
	$aim_lock_to_return=`ls-sl`;
	BOVER_10_2_29941243f77aa0343e79460d48136072 (20);
	select -r $select_loc_top;
	return  $aim_lock_to_return;
}
