	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(18);
    string $constr2[]=BOVER_10_2_17431451b1be026fdeee93b86579c6b6($source_obj,$source_locks);
    parent  $source_locks[0] $Piv_Top_Side[0];
	if (size($source_locks)>1)
		parent   `ls -tail (size($source_locks)-1) $source_locks` $source_locks[0] ;
    select $source_locks $Piv_Top_Side;
    BOVER_10_2_de88efca2929f0080ae1d45ff5db42d4;
    euler_filter_on_selected;
    delete  $constr $constr2;
    BOVER_10_2_17431451b1be026fdeee93b86579c6b6($source_locks,$source_obj);
    BOVER_10_2_4b209c5c00abddc3e3509a14326e2488($source_locks,"OverRig_knots");
    cutKey -cl -t ":" -f ":" -at "rx" -at "ry" -at "rz" $Piv_Top_Side;
    aimConstraint -mo -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject $Piv_Top_Side[2]  $Piv_Top_Side[1] $Piv_Top_Side[0];
    select  $Piv_Top_Side;
    BOVER_10_2_5fce4865a9fd47748e6796c1be9d64b2;
    BOVER_10_2_b6a5017ee305f5ba0bbf3116243cc3af;
    select  $Piv_Top_Side[0];
    BOVER_10_2_3323b46f97bc12510f86536ae21ff525;
    print $source_locks;
}
