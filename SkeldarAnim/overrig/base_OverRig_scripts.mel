global proc BOVER_10_2_90caf8375dffdf325df3be666537a016()
{
	string $selection[]=`ls-sl`;
	if(size($selection))
	{
		if(`objExists ANIMATION`)
		{
				if((`objectType ANIMATION`== "objectSet"))
				{
					rename "ANIMATION" "ANIMATION1";
					sets -name ANIMATION;
				}
				else
				{
					sets -name CAUTION_WRONG_NAME_SET;
					warning "In scene exists obj with name ANIMATION!!!!!!!";
				}
		}
		else
			sets -name ANIMATION;
	}
	else
		warning "select somebody";
}
global proc BOVER_10_2_09bdb78af23637cc0a3c8a88a1e6ab24(string $t_axis, string $r_axis)
{
    string $curve[] = `keyframe -q -n -sl`;
	string $frames[]=BOVER_10_2_a01af7626635f090f4162490a6d9507d($curve);
    $t_axis=capitalizeString($t_axis);
	$r_axis=capitalizeString($r_axis);
    float $num_frame[] = `keyframe -q  -sl`;
    selectKey -clear ;
    $num_frame=`sort  $num_frame`;
    string $str_numFr[]=stringToStringArray(floatArrayToString($num_frame, " "), " ");
    string $tmooo[]=stringArrayAddPrefix(stringArrayRemoveDuplicates($str_numFr), " -t ");
    string $timees=stringArrayToString($tmooo, "") ;
    string $cmd="scaleKey  -vs -1 -vp 0 ";
    if($t_axis=="X")
        $cmd=$cmd  + "-at \"tx\" ";
    if($t_axis=="Y")
        $cmd=$cmd  + "-at \"ty\" ";
    if($t_axis=="Z")
        $cmd=$cmd  + "-at \"tz\" ";
    if($r_axis=="X")
        $cmd=$cmd  + "-at \"rz\" -at \"ry\"";
    if($r_axis=="Y")
        $cmd=$cmd  + "-at \"rx\" -at \"rz\"";
    if($r_axis=="Z")
        $cmd=$cmd  + "-at \"rx\" -at \"ry\"";
    $cmd=$cmd  +  $timees;
    eval($cmd);
    for($i=0; $i<size($curve); $i++)
		eval ("selectKey -add -k" + $frames[$i] + " " + $curve[$i]);
}
global proc string[] BOVER_10_2_a01af7626635f090f4162490a6d9507d(string $crvs[])
{
	string $all_frames[];
	string $temp_param="";
	for($i=0; $i<size($crvs); $i++)
	{
		$temp_param="";
		$temp_name_fr = `keyframe -q -sl  $crvs[$i]`;
		for($j=0; $j<size($temp_name_fr); $j++)
		{
			$temp_param = $temp_param + "-t " + $temp_name_fr[$j] + "  ";
		}
		$all_frames[$i] = $temp_param;
	}
	return $all_frames;
}
global proc int BOVER_10_2_2d92805242e50041994bf7f653f4e114(string $selection[], string $num_curve)
{
	int $curr_obj_number;
	  for($i=0; $i<size($selection); $i++)
	  {
	  string $crvs_obj[] = `keyframe -q -n $selection[$i]`;
		for($k=0; $k<size($crvs_obj); $k++)
		{
			if ($crvs_obj[$k] == $num_curve)
			{
				$curr_obj_number=$i;
			}
		}
	  }
	return $curr_obj_number;
}
global proc BOVER_10_2_3676fd34198e455bb82f6106192bc927(int $frame_count, int $uniform)
{
    string $curves[]=`keyframe -q -n -sl`;int $deln;
    if(size($curves)==0)
        return;
    if(!$uniform)
        for($cu in $curves)
        {
            $cu_time=`keyframe -q -sl $cu`;
            floatArrayRemoveAtIndex(0, $cu_time);
            floatArrayRemoveAtIndex(size($cu_time)-1, $cu_time);
            for($i=0;$i<$frame_count;$i++)
            {
                if(size($cu_time)>0)
                {
                    $deln=floor (  rand (size($cu_time) ));
                    if($deln>=0)
                    {
                        $framedd=$cu_time[$deln];
                        cutKey  -t $framedd $cu;
                        floatArrayRemoveAtIndex($deln, $cu_time);
                    }
                }
            }
        }
    else
        {
           $cu_time=`keyframe -q -sl $curves[0]`;
            floatArrayRemoveAtIndex(0, $cu_time);
            floatArrayRemoveAtIndex(size($cu_time)-1, $cu_time);
            for($i=0;$i<$frame_count;$i++)
            {
                if(size($cu_time)>0)
                {
                    $deln=floor (  rand (size($cu_time) ));
                    if($deln>=0)
                    {
                        $framedd=$cu_time[$deln];
                        cutKey  -t $framedd $curves;
                        floatArrayRemoveAtIndex($deln, $cu_time);
                    }
                }
            }
        }
}
global proc BOVER_10_2_7bd26c8b37f4670d39bdb4c4c27816c3(float $scale_size, int $num_frames, int $uniform)
{
	$curve=`keyframe -q -sl -n`;
	float $range[]=BOVER_10_2_cba6da1b519f7600c71b7de0d52d2c3e();
	float $min_time=$range[0];
	float $max_time=$range[1];
	float $rand_frame[],$rand_base;
	float $rand_value[];
	float $selected_range=$max_time - $min_time;
	float $step_for_random=$selected_range/$num_frames;
	int $i=1;
	if ($min_time<$max_time)
	{
		if(!$uniform)
    		for ($f=0;$f<size($curve);$f++)
    		{
    			$rand_base= $min_time;
    			$prev_rand_base=$min_time;
    			for($i=0;$i<$num_frames;$i++)
    				{
    					$rand_frame[$i]=BOVER_10_2_b970808d076db3299a05dc858ee1a1e0(($rand_base), ($rand_base+$step_for_random), $curve[$f]);
    					$rand_base=$rand_base+$step_for_random;
    					$rand_value[$i]=(`rand -1 1`)*$scale_size;
    					$prev_rand_base=$rand_base;
    				}
    				for($i=0;$i<$num_frames;$i++)
    					    setKeyframe -id -dd true -t $rand_frame[$i]  $curve[$f];
    				for($i=0;$i<$num_frames;$i++)
    					    keyframe -e -iub true -r -t $rand_frame[$i] -o over -vc $rand_value[$i] $curve[$f];
    		}
    	else
    	    {
    	        $rand_base= $min_time;
    			$prev_rand_base=$min_time;
    			for($i=0;$i<$num_frames;$i++)
    				{
    					$rand_frame[$i]=BOVER_10_2_b970808d076db3299a05dc858ee1a1e0(($rand_base), ($rand_base+$step_for_random), $curve[0]);
    					$rand_base=$rand_base+$step_for_random;
    					$rand_value[$i]=(`rand -1 1`)*$scale_size;
    					$prev_rand_base=$rand_base;
    				}
    				for($i=0;$i<$num_frames;$i++)
    					    setKeyframe -id -dd true -t $rand_frame[$i]  $curve;
    				for($i=0;$i<$num_frames;$i++)
    					    keyframe -e -iub true -r -t $rand_frame[$i] -o over -vc $rand_value[$i] $curve;
    	    }
		selectKey -r -t ($min_time + ":" + $max_time)  $curve;
		keyTangent -itt spline -ott spline;
	}
}
global proc float[] BOVER_10_2_8658db3767d3086054bf3959e3ff6b41()
