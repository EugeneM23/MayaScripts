global proc BOVER_10_2_5126dfef64e23ef1640df4563e0e5113()
{
    string $selected[]=`ls-type nucleus-sl`;
    string $axis=`upAxis -q -axis`;
    global string $gActiveNucleusNode;
    if (size($selected)==0)
        $selected[0]=$gActiveNucleusNode;
    string $gr_plane_ctrl[];
    float $scale;
    string $sqr_lock[];
    for($s in $selected)
    {
        $scale = BOVER_10_2_92215d442ec8600b7dd12365e6b3d7f0({$s},1);
        $gr_plane_ctrl = BOVER_10_2_518c144ece64ffa54be80bdb48935d74("ground", $scale,1);
        BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(5);
		$gr_plane_ctrl[1]=`rename $gr_plane_ctrl[1] ("ground_" + $s)`;
		$gr_plane_ctrl[0]=`rename $gr_plane_ctrl[0] ("ground_gr_" + $s)`;
		$sqr_lock =`spaceLocator`;
		parent $sqr_lock $gr_plane_ctrl[1];
		move -ls -a 0 0 0 $sqr_lock;
		rotate -a 0 0 0 $sqr_lock;
		setAttr ($sqr_lock[1] + ".localScaleX") ($scale*3);
		setAttr ($sqr_lock[1] + ".localScaleY") ($scale*3);
		setAttr ($sqr_lock[1] + ".localScaleZ") 0;
		BOVER_10_2_2973884331c16c616ab40f590c680aa4();
		BOVER_10_2_8071326ac26a590fcb224ddba406d389();
		connectAttr -f ($gr_plane_ctrl[1] + ".pos_x") ($s +  ".planeOriginX");
		connectAttr -f ($gr_plane_ctrl[1] + ".pos_y") ($s +  ".planeOriginY");
		connectAttr -f ($gr_plane_ctrl[1] + ".pos_z") ($s +  ".planeOriginZ");
		connectAttr -f ($gr_plane_ctrl[1] + ".direction_x") ($s +  ".planeNormalX");
		connectAttr -f ($gr_plane_ctrl[1] + ".direction_y") ($s +  ".planeNormalY");
		connectAttr -f ($gr_plane_ctrl[1] + ".direction_z") ($s +  ".planeNormalZ");
		addAttr -ln "plane_collision"  -at bool   $gr_plane_ctrl[1];
		setAttr -e -keyable 1 -channelBox true ($gr_plane_ctrl[1] + ".plane_collision") 1;
		connectAttr -f ($gr_plane_ctrl[1] + ".plane_collision") ($s +  ".usePlane");
		addAttr -ln "bounce"  -at double  -min 0  $gr_plane_ctrl[1];
		setAttr -e -keyable 1 -channelBox true ($gr_plane_ctrl[1] + ".bounce") 0;
		connectAttr -f ($gr_plane_ctrl[1] + ".bounce") ($s +  ".planeBounce");
		addAttr -ln "friction"  -at double  -min 0  $gr_plane_ctrl[1];
		setAttr -e -keyable 1 -channelBox true ($gr_plane_ctrl[1] + ".friction") 0.1;
		connectAttr -f ($gr_plane_ctrl[1] + ".friction") ($s +  ".planeFriction");
		addAttr -ln "stickiness"  -at double  -min 0  $gr_plane_ctrl[1];
		setAttr -e -keyable 1 -channelBox true ($gr_plane_ctrl[1] + ".stickiness") 0;
		connectAttr -f ($gr_plane_ctrl[1] + ".stickiness") ($s +  ".planeStickiness");
		if($axis=="y")
			rotate -a -os -fo -90 0 0 $gr_plane_ctrl[1];
		else
			rotate -a -os -fo 0 0 0 $gr_plane_ctrl[1];
	}
	BOVER_10_2_4b209c5c00abddc3e3509a14326e2488({$gr_plane_ctrl[0]},"OverRig_dynamic_system");
    select $gr_plane_ctrl[1];
}
global proc BOVER_10_2_c54219da8c8352f00ddf7099c972d90d(string $mesh)
{
	$selected=`ls -l -sl`;
	global string $gActiveNucleusNode;
	vector $avg_pos;
	string $axis=`upAxis -q -axis`;
	string $geo[];
	string $tmp_lock[];
	float $bboxss[];
	string $col_gr="colliders_gr";
	if (!`objExists("colliders_gr")`)
		$col_gr=`group -em -n "colliders_gr"`;
	string $finGeo[];
	string $obj;
	for($obj in $selected)
	{
		$childrens=` listRelatives  -c -f -type "transform" $obj`;
		$constraints=` listRelatives  -c -f  -type "parentConstraint"  -type "orientConstraint" -type "pointConstraint" -type "aimConstraint" -type "scaleConstraint" $obj`;
		$diff=stringArrayRemove($constraints,$childrens);
		$diff[size($diff)]=$obj;
		if(size($diff)>1)
		{
			$tmp_lock=BOVER_10_2_526c020cd7c9a859fd08d49719a4fddf($diff);
			$bboxss=`exactWorldBoundingBox  $tmp_lock`;
			delete $tmp_lock;
		}
		else
		{
			if(objectType ($obj)!="joint")
				$bboxss=`exactWorldBoundingBox  $obj`;
			else
			{
				$tmp_lock=BOVER_10_2_526c020cd7c9a859fd08d49719a4fddf({$obj});
				select  $tmp_lock;
				BOVER_10_2_6de8028af587b467034457b4d6349f89(1);
			    $bboxss=`exactWorldBoundingBox  $tmp_lock`;
			    delete $tmp_lock;
		    }
		}
		$avg_pos=BOVER_10_2_e3bea614176fbceebe7c7aae67e953b0({<<$bboxss[0],$bboxss[1],$bboxss[2]>>,<<$bboxss[3],$bboxss[4],$bboxss[5]>>});
		float $len=max( abs($bboxss[0] - $bboxss[3]),abs($bboxss[1] - $bboxss[4]) );
		$len=max( $len,abs($bboxss[2] - $bboxss[5]));
		if($len<0.1)
			$len = 0.1;
		if($mesh=="box")
			$geo=`polyCube -n ($obj + "_" + $gActiveNucleusNode + "_collis#") -w $len -h $len -d $len -sx 1 -sy 1 -sz 1 -ax 0 1 0 -cuv 4 -ch 0`;
		if($mesh=="capsule")
			if($axis=="y")
				$geo=`polyCylinder -n ($obj + "_" + $gActiveNucleusNode + "_collis#") -r ($len/2) -h $len -sx 20 -sy 1 -sz 4 -ax 0 1 0 -rcp 1 -cuv 3 -ch 0`;
			else
				$geo=`polyCylinder -n ($obj + "_" + $gActiveNucleusNode + "_collis#") -r ($len/2) -h $len -sx 20 -sy 1 -sz 4 -ax 0 0 1 -rcp 1 -cuv 3 -ch 0`;
		if($mesh=="sphere")
			$geo=`polySphere -n ($obj + "_" + $gActiveNucleusNode + "_collis#") -r ($len/2) -sx 10 -sy 10 -ax 0 1 0 -cuv 2  -ch 0`;
		move  ($avg_pos.x) ($avg_pos.y) ($avg_pos.z)  $geo;
		$tmp_lock=`spaceLocator -n ($obj + "_att#")`;
		BOVER_10_2_e8fab4220afb7ebae48fab83681f71a5(0);
		parent  $tmp_lock $col_gr;
		parentConstraint $obj  $tmp_lock ;
		parent  $geo $tmp_lock;
		rotate -a 0 0 0 $geo ;
		$finGeo[size($finGeo)]=$geo[0];
		BOVER_10_2_4b209c5c00abddc3e3509a14326e2488($tmp_lock,"OverRig_dynamic_system");
		BOVER_10_2_4b209c5c00abddc3e3509a14326e2488({$col_gr},"OverRig_dynamic_system");
	}
	select $finGeo;
}
