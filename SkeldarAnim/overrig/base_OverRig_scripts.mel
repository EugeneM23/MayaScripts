    return  $bar_recalc_main_groupp;
}
global proc string[] BOVER_10_2_87d25ed1beaad9175ea166fe53a7c619(string $items[], int $from_selected, string $mode)
{
	undoInfo -ock -cn ("fast_pivot_" + $mode);
    global string $bend_tool_selections[];
    $bend_tool_selections={};
	global string $bend_tool_group_to_delete[];
	$bend_tool_group_to_delete={};
	string $selected_first[]=`ls-sl`;
    string $item;
    string $selected[];
	string $buffer[];
    string $ik_controls_all[]={};
    if($from_selected)
	    $items[0]=stringArrayToString($selected_first,";");
    for($item in $items)
	{
	    tokenize $item ";" $buffer;
    	$selected=$buffer;
    	appendStringArray ($bend_tool_selections,$selected,size($selected));
    	select -cl;
        select $selected;
		string $selected_first_from_selected[]=BOVER_10_2_8c3a61b60f8c5db31e62d0f42ad9d5d1($selected_first , $selected);
        if($mode=="4IK")
		{
			if(size($selected)<3)
			{
				warning "select 3 or more objects";
				undoInfo -cck;
				return {};
			}
			if(size($selected)>=4)
				$bend_tool_group_to_delete[size($bend_tool_group_to_delete)]=BOVER_10_2_5d6e75a027ef6994c6678a4d98754732( $selected, 0.5);
			if(size($selected)==3)
				$bend_tool_group_to_delete[size($bend_tool_group_to_delete)]=BOVER_10_2_38eaad6f292b362a1183b9640863e6bb( $selected);
        }
        if($mode=="4IK_var")
		{
			if(size($selected)<3)
			{
				warning "select 3 or more objects";
				undoInfo -cck;
				return {};
			}
			if(size($selected)>=4)
				$bend_tool_group_to_delete[size($bend_tool_group_to_delete)]=BOVER_10_2_74bb48eac8cce2ff4c54ec200786facc( $selected, 0.5);
			if(size($selected)==3)
				$bend_tool_group_to_delete[size($bend_tool_group_to_delete)]=BOVER_10_2_38eaad6f292b362a1183b9640863e6bb( $selected);
        }
		if($mode=="3IK")
		{
			if(size($selected)<3)
			{
				warning "select 3 or more objects";
				undoInfo -cck;
				return {};
			}
			else
				$bend_tool_group_to_delete[size($bend_tool_group_to_delete)]=BOVER_10_2_38eaad6f292b362a1183b9640863e6bb( $selected);
		}
		if($mode=="bend")
		{
			if(size($selected)<3)
			{
				warning "select 3 or more objects";
				undoInfo -cck;
				return {};
			}
			else
			$bend_tool_group_to_delete[size($bend_tool_group_to_delete)]=BOVER_10_2_14afa0678ff0c658f1f377ff020d13d2($selected);
		}
		if($mode=="rot_piv")
			$bend_tool_group_to_delete[size($bend_tool_group_to_delete)]=BOVER_10_2_1afac16a3399d6741e69e0271fb33863( $selected,$selected_first_from_selected);
		if($mode=="twist")
		{
			if(size($selected)<3)
			{
				warning "select 3 or more objects";
				undoInfo -cck;
				return {};
			}
			else
				$bend_tool_group_to_delete[size($bend_tool_group_to_delete)]=BOVER_10_2_60ce0a216db7fc1576af68c7b2f058fe( $selected,$selected_first_from_selected);
		}
		appendStringArray($ik_controls_all,`ls-sl`,size(`ls-sl`));
	}
	select $ik_controls_all;
	if($mode=="rot_piv"||$mode=="twist")
	{
		setToolTo RotateSuperContext;
		manipRotateContext -e -ah 3 -mode 4 Rotate;
	}
	if($mode=="3IK"||$mode=="4IK_var"||$mode=="4IK")
	{
		setToolTo moveSuperContext;
		manipMoveContext -edit -ah 3 -mode 0 Move;
	}
	$bend_tool_group_to_delete[size($bend_tool_group_to_delete)]="ovr_temp_rotate_piv_gr*";
	string $cmd="scriptJob -ro 1 -cf \"SomethingSelected\" \"BOVER_10_2_add99febc6d5e08f48377f2f81bcb82e($bend_tool_selections, $bend_tool_group_to_delete)\"";
	eval ($cmd);
    return  $bend_tool_group_to_delete;
}
