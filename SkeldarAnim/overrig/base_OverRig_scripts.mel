global proc string BOVER_10_2_7895ec20650f9411ffd9ffcca61a04fb(int $continuation_of_chain)
{
    string $selected[]=`ls-sl`;
    float $spine_lenght=BOVER_10_2_a358a7c27f7a7b80712d695138ed032e($selected, 0)/BOVER_10_2_f71c299bf7b53f7243b078a9990e581c(1);
    global string $bar_recalc_basee_lock[];
    global string $bar_recalc_selected_objects[];
    global string $bar_recalc_main_groupp;
    $bar_recalc_selected_objects=$selected;
    int $num=size($selected)-1;
    $bar_recalc_main_groupp=BOVER_10_2_6d7498dd5c0b89568073ed9206fd5cd0($continuation_of_chain,0);
    $bar_recalc_basee_lock=`ls-sl`;
    global string $bar_recalc_arrow[];
    string $arrow[]=BOVER_10_2_392c409eb0bea2c8283faf3d2f697294($spine_lenght);
    appendStringArray ($bar_recalc_arrow,$arrow,2);
    BOVER_10_2_ea29f12459b08b7b0796eaa3f3cb0ac6(1);
	BOVER_10_2_19c8ef40419bea353742fe791e238558($arrow, 3);
    BOVER_10_2_17431451b1be026fdeee93b86579c6b6($bar_recalc_basee_lock, $arrow);
    $arrow=BOVER_10_2_e52ed91bd5c84901d59d7d8a0117fc7e ($spine_lenght);
    BOVER_10_2_ea29f12459b08b7b0796eaa3f3cb0ac6(2);
	BOVER_10_2_19c8ef40419bea353742fe791e238558($arrow, 4);
    rotate -r -os   0 0 -90 $arrow;
    appendStringArray ($bar_recalc_arrow,$arrow,2);
    BOVER_10_2_17431451b1be026fdeee93b86579c6b6($bar_recalc_basee_lock, $arrow);
    BOVER_10_2_1b3bfd1d62d966ea966f5caca72bac5d($bar_recalc_arrow, 1);
    select $selected[0] $selected[$num];
    BOVER_10_2_8c16c9163e07a819fc2186f2d338a280(1);
    select $bar_recalc_basee_lock;
	BOVER_10_2_9a8d2e62249cad27916aacc736478655;
    return  $bar_recalc_main_groupp;
}
global proc string BOVER_10_2_56198b33b19d3947083feaf628154297(int $continuation_of_chain)
{
   	string $selected[]=`ls-sl`;
	global string $bar_recalc_selected_objects[];
