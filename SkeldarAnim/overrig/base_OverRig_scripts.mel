global proc BOVER_10_2_fc9a5a809318602860f6fb1135723ed7(string $rOrder_str)
{
	string $selection[]=`ls-sl`;
	int $rOrder;
	switch ($rOrder_str)
	{
	    case "xyz" :
	        $rOrder = 0;
	        break;
	    case "yzx" :
	        $rOrder = 1;
	        break;
	    case "zxy" :
	        $rOrder = 2;
	        break;
	    case "xzy" :
	        $rOrder = 3;
	        break;
	    case "yxz" :
	        $rOrder = 4;
	        break;
	    case "zyx" :
	        $rOrder = 5;
	        break;
	}
	float $all_keytime[]=`keyframe -at rotate  -query $selection`;
	int $no_key;
	float $time_pref[],$curr_time;
	$curr_time=`currentTime -q`;
	if(`size($all_keytime)`==0)
	{
		setKeyframe -attribute rotate $selection;
		$no_key=1;
		$all_keytime={$curr_time};
	}
	$all_keytime=sort($all_keytime);
	$time_pref=BOVER_10_2_9bcfe87821f81f923d9a4d502efb9945();
	playbackOptions -ast  $all_keytime[0];
	playbackOptions -aet  $all_keytime[size( $all_keytime)-1];
	string $lock[]=BOVER_10_2_43aae6ab29019a62e5f1055f1a9e5d1f();
	float $is_frame[];
	BOVER_10_2_d04a25c84de52f4787d68215d32315e0($rOrder, $selection);
	for($fr in $all_keytime)
	{
		currentTime $fr;
		for($obj in $selection)
		{
			$is_frame=`keyframe -at rotate -t $fr -query  $obj`;
			if(`size($is_frame)`!=0)
				setKeyframe -attribute rotate -t $fr $obj;
		}
	}
	delete $lock;
	BOVER_10_2_d9f7ba947826f7f00ce2215bc1417109($time_pref);
	currentTime $curr_time;
	select $selection;
}
global proc BOVER_10_2_d18150d077ed5b67c6812087cb8711c2(float $poseBias, float $add_scale)
{
	global int $bar_tween_val_UI_posiiton;
	global int $bar_tween_val_UI_posiiton_prev;
	waitCursor -state on ;
	if($bar_tween_val_UI_posiiton>$bar_tween_val_UI_posiiton_prev)
	{
		BOVER_10_2_419ebd630d5f306b0e072ae65d2736e8(1+$add_scale,  $poseBias);
	}
	else
	{
		BOVER_10_2_419ebd630d5f306b0e072ae65d2736e8(1-$add_scale,  $poseBias);
	}
	waitCursor -state off ;
	$bar_tween_val_UI_posiiton_prev=$bar_tween_val_UI_posiiton;
}
global proc BOVER_10_2_9a8d2e62249cad27916aacc736478655()
