global proc setKey_on_attach_attr(float $value)
{
    float $frame_range[]=BOVER_10_2_dfc2513778a513e560ec81c8f3df6563();
    string $obj;
    for($obj in `ls-sl`)
        if (attributeExists ("attach", $obj))
        {
            setAttr -lock 0 ($obj + ".attach");
            if(($frame_range[1]-1)- $frame_range[0]>=1)
            {
                setKeyframe -v $value -at attach   -t $frame_range[0] -t ($frame_range[1]-1) -itt flat -ott flat $obj;
            }
            else
                setKeyframe -v $value -at attach   -t $frame_range[0]   -itt flat -ott flat $obj;
            setAttr -lock 1 ($obj + ".attach");
        }
	currentTime -e `currentTime-q`;
}
