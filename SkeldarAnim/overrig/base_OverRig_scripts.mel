	button -ann "toggle timeslider range"
				-c "time_slider_range(24);"
				-w (45)
				-h $height_small
				-l "ts "
				bts;
	button -ann "move time slider to mid selection position"
				-c "set_currenttime_to_mid_selection()"
				-w (45)
				-h $height_small
				-l ">.<"
				bL_L;
}
frameLayout -ann $Overrig_version
		-p "ovrrig_columnLayout1_ui"
		-bgc $red[0] $red[1] $red[2]
		-ebg true -bv false -cl 0 -cll 1
		-l "selector"
		-la "top"
