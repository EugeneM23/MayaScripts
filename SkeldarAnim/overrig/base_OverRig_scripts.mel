						-st "iconOnly"
						-ann "set play Every Frame, max Real Time"
						-onc "playbackOptions -e -playbackSpeed 0 -maxPlaybackSpeed 1;inViewMessage -smg \"play Every Frame, max Real Time\" -pos topRight -bkc 0x00000000 -fade -fst 1000;"
						-i1 "execute.png" -l "Every Frame";
