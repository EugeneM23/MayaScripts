	string $v[]=`filterExpand -sm 31 $objects`;
	string $buffer[];
	string $egr_v;
	if($v[0]!="")
	{
	    $egr_v=`group -r -em -n ("vtex")`;
	    setAttr ($egr_v + ".hiddenInOutliner") 1;
	    BOVER_10_2_44f98143a051a179f7a8f034b026e69b( $v[0], $egr_v);
	    $objects[0]=$egr_v;
	}
	$global_mt_name_base_object=$objects[0];
	$global_mtr_EGR_name=`group -r -em -n ($objects[0] + "_EGR")`;
	setAttr ($global_mtr_EGR_name + ".hiddenInOutliner") 1;
	setAttr ($global_mtr_EGR_name + ".displayHandle") 1;
	setAttr ($global_mtr_EGR_name + ".overrideEnabled") 1;
	setAttr ($global_mtr_EGR_name + ".overrideDisplayType") 2;
	$global_base_mtr_EGR_name=`group -r -n ($objects[0] + "_base_EBR")`;
	setAttr ($global_base_mtr_EGR_name + ".hiddenInOutliner") 1;
	setAttr ($global_base_mtr_EGR_name + ".overrideEnabled") 1;
	setAttr ($global_base_mtr_EGR_name + ".overrideDisplayType") 2;
	int $min=`playbackOptions -query -ast`;
    int $max=`playbackOptions -query -aet`;
	string $fr_cmd="setKeyframe ";
	for($i=$min; $i<=$max;$i++)
		$fr_cmd=$fr_cmd + " -t " + $i;
	$fr_cmd=$fr_cmd + " " + $global_mtr_EGR_name + ".tx";
	eval($fr_cmd);
    pointConstraint $objects[0] $global_mtr_EGR_name;
	select $global_mtr_EGR_name;
    $m_trail=BOVER_10_2_b9fa1d9928478b91ad38716608825bd6();
    if($static)
    {
        setAttr ($m_trail[0] + ".start") 0;
        setAttr ($m_trail[0] + ".end") 0;
    }
    $global_mt_name_base=$m_trail[0];
    $global_mt_name=$m_trail[1];
	$global_mt_name_base_shape=$m_trail[2];
	connectAttr ($global_mtr_EGR_name + ".worldMatrix[0]") ($m_trail[2] + ".inputMatrix");
	connectAttr ($global_mtr_EGR_name + ".message") ($m_trail[1] + ".transformToMove");
    $global_mt_name= BOVER_10_2_5a83676d63b5330872e526b5f6930549( $global_mtr_EGR_name);
    global int $scr_j_num;
    $cmd=" $scr_j_num=`scriptJob -kws -attributeChange \"" + $global_mtr_EGR_name + ".translate\"  \" $global_mt_name=BOVER_10_2_5a83676d63b5330872e526b5f6930549(\\\"" + $global_mtr_EGR_name + "\\\" "  + ")\"`";
    eval ($cmd);
    $kill_cmd="scriptJob -kws -nodeDeleted " + $global_mt_name + " \"scriptJob -kill " + $scr_j_num  + " -force;\"" ;
    eval ($kill_cmd);
    $kill_gr_cmd="scriptJob -kws   -nodeDeleted " + $global_mt_name + " \"  catchQuiet(`delete " + $global_base_mtr_EGR_name  + "`);  \"" ;
    eval ($kill_gr_cmd);
    string $kill_e_gr_gr_cmd;
    if($v[0]!="")
    {
        $kill_e_gr_gr_cmd="scriptJob -kws   -nodeDeleted " + $global_mt_name + " \"delete " + $egr_v  + ";\"" ;
        eval ($kill_e_gr_gr_cmd);
    }
	string $nodeName = `scriptNode -st 2 -n "mt_script"`;
    $scr_node_cmd= "catchQuiet( `delete " +  $global_mt_name_base + "`);";
    $scr_node_cmd= $scr_node_cmd + "catchQuiet( `delete " + $global_mt_name   + "`);";
    $scr_node_cmd= $scr_node_cmd + "catchQuiet( `delete " + $global_base_mtr_EGR_name   + "`);";
    $scr_node_cmd= $scr_node_cmd + "catchQuiet( `delete " + $egr_v + "`);";
    $scr_node_cmd= $scr_node_cmd + "catchQuiet( `delete " + $nodeName + "`);";
    scriptNode -e  -bs $scr_node_cmd $nodeName;
}
