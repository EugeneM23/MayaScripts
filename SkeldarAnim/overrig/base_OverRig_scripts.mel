global proc set_infinity_graphEditor(string $inf_type)
{
	if($inf_type=="constant")
		animCurveEditor -edit -displayInfinities 0 graphEditor1GraphEd;
	else
		animCurveEditor -edit -displayInfinities 1 graphEditor1GraphEd;
	setInfinity -pri $inf_type -poi $inf_type;
}
