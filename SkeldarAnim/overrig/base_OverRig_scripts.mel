global proc string BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86(float $hardness, float $sdvig, int $cycled, int $abs_mode )
{
	undoInfo -ock -cn "BOVER_10_2_38abc2ad8d0df7edc05b9cbbc4053b86";
	$selection=`ls-sl`;
	BOVER_10_2_9bad7ec683c4a9fc4b3098a039f34d33(8,1);
	$joints=`ls-sl`;
	float $lenght_aim_move;
	BOVER_10_2_c642429ed9a3aabf65a66eefcd97bfbb;
	$i=0;
	for($obj in `ls-sl`)
	{
	    select $obj;
    	if ($i!=`size($joints)`-1)
        {
            $lenght_aim_move=BOVER_10_2_c7822f1f10b007a6803735c105e40799($joints[$i], $joints[$i+1]);
        }
        else
    	{
    	    $lenght_aim_move=BOVER_10_2_c7822f1f10b007a6803735c105e40799($joints[$i], $joints[$i-1]);
    	}
    	move -r -os -wd ($lenght_aim_move*$hardness) 0 0 ;
    	pickWalk -d right;
    	move -r -os -wd 0 (-1*$lenght_aim_move*$hardness) 0 ;
    	$i++;
	}
	BOVER_10_2_10df34add5a583f84d24608e860c1b4b;
	$tops=`ls-sl`;
	if($abs_mode==1)
    {
        $sdvig=$sdvig/size($selection);
    }
	Lag_Key($sdvig);
	keyframe -e -iub true -r -o over -tc $sdvig;
	pickWalk -d right;
	$sides=`ls-sl`;
	Lag_Key($sdvig);
	keyframe -e -iub true -r -o over -tc $sdvig;
	if ($cycled)
	{
		select $tops $sides;
		animCurveEditor -edit -displayInfinities 1 graphEditor1GraphEd;
		setInfinity -pri cycle -poi cycle;
	}
	select $tops $sides $joints[0];
	string $gr_name=`group -n "hvost"`;  xform -os -piv 0 0 0;
	select $selection;
	undoInfo -cck;
	return $gr_name;
}
