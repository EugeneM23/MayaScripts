global proc string[] BOVER_10_2_526c020cd7c9a859fd08d49719a4fddf(string $objects[])
{
	string $selection[] = `ls -fl -os`;
	select -cl;
	string $locators[],$b[];
	if (size ($objects)>0)
	{
		for($obj in $objects)
		{
			$getPvPos=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($obj);
			$b=`spaceLocator -p 0 0 0`;
			appendStringArray($locators, $b, 1);
			move -a  $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
			rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
		}
	}
	else
		$locators = `spaceLocator -p 0 0 0`;
	select $selection;
	return $locators;
}
