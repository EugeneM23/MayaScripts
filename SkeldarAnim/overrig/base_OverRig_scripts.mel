        catchQuiet (`setAttr -l $lock_status ($obj + ".jointOrientX")`);
        catchQuiet (`setAttr -l $lock_status ($obj + ".jointOrientY")`);
        catchQuiet (`setAttr -l $lock_status ($obj + ".jointOrientZ")`);
    }
}
global proc string[] BOVER_10_2_e706e982298fe9e8f94ae04b06b5d6b2(string $prefix)
{
    string $uuids[],$uid;
    string $curr_obj[], $fin_obj[];
    $uuids=`ls  -uuid-sl`;
    for($uid in $uuids)
    {
        $curr_obj=`ls -uuid $uid`;
        rename $curr_obj[0] ($prefix  + "#");
    }
    select -cl;
    $fin_obj=`ls -uuid $uuids`;
    select $fin_obj;
    return $fin_obj;
}
global proc string [] BOVER_10_2_c9088e941b7677113499bb19ad80f9bf (string $prefix, string $name_massive[])
{
    string $uuids[];
    string $curr_obj[],$short_name_curr,$short_name,$namesps,$new_names[];
    $uuids=`ls  -uuid-sl`;
	for($i=0;$i<size($uuids);$i++)
	{
	    $namesps = `match "^.*:"  $name_massive[$i]`;
	    $short_name = `match "[^/\:]*$" $name_massive[$i]`;
		$fin_name=BOVER_10_2_c954f3ebe8232ef721ae19221935b64e( $namesps   + $prefix + $short_name);
		$curr_obj=`ls  -l -uuid $uuids[$i]`;
		$short_name_curr= `match "[^|\\]*$"$curr_obj[0]`;
		rename $curr_obj[0] $fin_name;
	}
	select -cl;
    $new_names=`ls -uuid $uuids`;
    select $new_names;
	return $new_names;
}
global proc string [] BOVER_10_2_10b1c67feba7e9570357d44ba9306692 (string $prefix, string $name_massive[],string $postfix)
{
    string $uuids[];
    string $curr_obj[], $fin_obj[],$short_name_curr;
    $uuids=`ls  -uuid-sl`;
	for($i=0;$i<size($uuids);$i++)
	{
	    $namesps = `match "^.*:"  $name_massive[$i]`;
	    $short_name = `match "[^/\:]*$" $name_massive[$i]`;
		$fin_name=BOVER_10_2_c954f3ebe8232ef721ae19221935b64e( $namesps   + $prefix + $short_name + $postfix + "#");
		$curr_obj=`ls  -l -uuid $uuids[$i]`;
		$short_name_curr= `match "[^|\\]*$"$curr_obj[0]`;
		rename $curr_obj[0] $fin_name;
	}
	select -cl;
    $new_names=`ls -uuid $uuids`;
    select $new_names;
	return $new_names;
}
