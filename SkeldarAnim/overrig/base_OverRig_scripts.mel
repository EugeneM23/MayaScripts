global proc string BOVER_10_2_bdd2d2262c150fe16a261bb2e2e76046(int $rotation_mod)
{
	string $selected[]=`ls-sl`;
	string $animLayer=`animLayer`;
	for($obj in `ls-sl`)
    {
        select $obj;
        catchQuiet(`animLayer -e -addSelectedObjects $animLayer`);
    }
	$cmd="setAttr " + $animLayer + ".rotationAccumulationMode " + $rotation_mod;
	eval ($cmd);
	select -cl;
	select $selected;
	BOVER_10_2_92974e563427b6856d49efc764f12d33($animLayer);
	return $animLayer;
}
global proc BOVER_10_2_92974e563427b6856d49efc764f12d33(string $layer)
{
	string $layers[]=`ls -type "animLayer"`;
	int $i;
	for($i=0; $i<size($layers); $i++)
		animLayer -e -selected 0 $layers[$i];
	animLayer -e -selected 1 $layer;
	animLayerEditorOnSelect $layer 1;
}
global proc BOVER_10_2_402263cc1b8de1e793411a0a2dc0e8ec(string $layers[], float $range[], float $side_fr, string $tangent, int $reverse)
{
    float $v0=0;
    float $v1=1;
    if($reverse)
    {
        $v0=1;
        $v1=0;
    }
    for($l in $layers)
    {
        setKeyframe -t ($range[0] - $side_fr) -v $v0  -itt $tangent -ott $tangent -at ($l + ".weight") ($l + ".weight") ;
        setKeyframe -t ($range[0])            -v $v1  -itt $tangent -ott $tangent -at ($l + ".weight") ($l + ".weight") ;
        setKeyframe -t ($range[1])            -v $v1  -itt $tangent -ott $tangent -at ($l + ".weight") ($l + ".weight") ;
        setKeyframe -t ($range[1] + $side_fr) -v $v0  -itt $tangent -ott $tangent -at ($l + ".weight") ($l + ".weight") ;
    }
}
global proc string[] BOVER_10_2_cfc20aa23531f881688ec3a171beaae5(string $m_path)
{
    string $connected_items_by_group[] =`listConnections  -d 1 $m_path`;
    string $buffer[];
    string $markers[];
    $j=0;
    for( $k = 0; $k <size($connected_items_by_group);$k++)
    {
        if(`gmatch $connected_items_by_group[$k] "*positionMarker*"`)
        {
            $markers[$j]=$connected_items_by_group[$k];
            $j++;
        }
    }
    string $obj;
    string $markers_all[];
    $j=0;
    for ($obj in $markers)
    {
        tokenize $obj "->" $buffer;
        $markers_all[$j]=$buffer[1];
        $j++;
    }
    return $markers_all;
}
