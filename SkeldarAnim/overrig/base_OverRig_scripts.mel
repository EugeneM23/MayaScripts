	string $fin_gr=`group -n "ovr_temp_rotate_piv_gr#" $group_lock_name $cluster_name $scaling_cluster_name$ik_name[0] $crve_name $marker_gr $joints[0]  $arl_transf`;
	select $drow_joint;
	return $fin_gr;
}
