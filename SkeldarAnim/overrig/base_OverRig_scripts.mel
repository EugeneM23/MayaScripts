					-w ($wt_small+3) -h $height_small
					-bgc 0.7 0.880 0.7
					-ebg true
					-l "!x"
					bnx;
rowLayout -p "keytool_BOR_clmn_lay_ui" -ebg true -nc 4 ;
		button -ann "set the same keyframe on the allocated time range on all channel"
					-c "set_key_time_range(\"all\")"
					-w (45)
					-h ($height_small + 2)
					-l "All"
					bAll;
		button -ann "set the same keyframe on the allocated time range on translates"
					-c "set_key_time_range(\"translate\")"
					-w (45)
					-h ($height_small + 2)
					-l "T"
