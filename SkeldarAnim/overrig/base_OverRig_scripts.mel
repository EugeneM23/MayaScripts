global proc string[] BOVER_10_2_e52ed91bd5c84901d59d7d8a0117fc7e(float $radius)
{
	$selection = `ls -fl -sl `;
	string $curve_sphere[];
	if(size($selection)>0)
	{
		for($i=0;$i<size($selection);$i++)
		{
			$curve_sphere[$i]=BOVER_10_2_7d16a2aa6cdd056e3f3dfb7d19faef75($radius);
		}
		BOVER_10_2_847308ac6f1debf8edcc8d63e128d64c( $selection, $curve_sphere);
		BOVER_10_2_7f958423a7cfe1774157efdcb79ac0be( $selection,$curve_sphere);
	}
	else
	{
		$curve_sphere[0]=BOVER_10_2_7d16a2aa6cdd056e3f3dfb7d19faef75($radius);
	}
   select $curve_sphere ;
   BOVER_10_2_a204d82b0cc11ef9adf835ab99270c74($curve_sphere);
   return $curve_sphere;
}
global proc string BOVER_10_2_7d16a2aa6cdd056e3f3dfb7d19faef75(float $radius)
{
	string $curves[];
	clear $curves;
	$crv=`curve -d 1 -p 0 0 0  -p 1 0 0 -p 0.69 0 -0.08 -p 1 0 0 -p  0.69 0 0.08 -p  1 0 0`;
	scale  $radius $radius $radius $crv;
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
	catchQuiet(`setAttr -lock true ($crv + ".rcurve")`);
	catchQuiet(`setAttr -lock true ($crv + ".cwdth")`);
	catchQuiet(`setAttr -lock true ($crv + ".srate")`);
	catchQuiet(`setAttr -lock true ($crv + ".ai_curve_shaderr")`);
	catchQuiet(`setAttr -lock true ($crv + ".ai_curve_shaderg")`);
	catchQuiet(`setAttr -lock true ($crv + ".ai_curve_shaderb")`);
	return $crv;
}
global proc string[] BOVER_10_2_392c409eb0bea2c8283faf3d2f697294(float $radius)
{
	$selection = `ls -fl -sl `;
	string $curve_sphere[];
	if(size($selection)>0)
	{
		for($i=0;$i<size($selection);$i++)
			$curve_sphere[$i]=BOVER_10_2_6536d64091cecf077f1c532c7861e778($radius);
		BOVER_10_2_847308ac6f1debf8edcc8d63e128d64c( $selection, $curve_sphere);
		BOVER_10_2_7f958423a7cfe1774157efdcb79ac0be( $selection,$curve_sphere);
	}
	else
		$curve_sphere[0]=BOVER_10_2_6536d64091cecf077f1c532c7861e778($radius);
	BOVER_10_2_a204d82b0cc11ef9adf835ab99270c74($curve_sphere);
	select $curve_sphere ;
	return $curve_sphere;
}
global proc string BOVER_10_2_6536d64091cecf077f1c532c7861e778(float $radius)
{
	string $curves[];
	clear $curves;
	$crv=`curve -d 1 -p 0 0 0  -p 0.8 0 0  `;
	$c=`circle -c  0.9 0 0 -nr 0 1 0 -sw 360 -r 0.1 -d 3 -ut 0 -tol 1e-06 -s 8 -ch 1`;
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
	$shapes=`listRelatives -shapes  $c`;
	parent -add  -s  $shapes $crv;
	delete $c;
	select $crv;
	scale  $radius $radius $radius $crv;
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
	catchQuiet(`setAttr -lock true ($crv + ".rcurve")`);
	catchQuiet(`setAttr -lock true ($crv + ".cwdth")`);
	catchQuiet(`setAttr -lock true ($crv + ".srate")`);
	catchQuiet(`setAttr -lock true ($crv + ".ai_curve_shaderr")`);
	catchQuiet(`setAttr -lock true ($crv + ".ai_curve_shaderg")`);
	catchQuiet(`setAttr -lock true ($crv + ".ai_curve_shaderb")`);
	return $crv;
}
global proc string[] BOVER_10_2_46e3c16f7c510db12bc5343ac1a842b6(int $color, int $template, int $show_outliner)
{
	$selection=`ls-sl`;
	$curv=BOVER_10_2_a8d1933a966541e62d79a2fcbf6e4ea4(1);
	if($color)
		BOVER_10_2_cc20e95399a3b6da44eb78e45451d764($color);
	if( $template)
		BOVER_10_2_8071326ac26a590fcb224ddba406d389();
	string $tmpp[];
	string $curves[] = `listRelatives -f -shapes -type "nurbsCurve" $curv`;
	int $numCVs = `getAttr -size ($curves[0] + ".controlPoints")`;
	string $cluster_names[];
	clear $cluster_names;
	for($i=0;$i<$numCVs;$i++)
	{
		$tmpp=`cluster -envelope 1 ($curv + ".cv[" + $i + "]")` ;
		$cluster_names[$i]=$tmpp[1];
	}
	BOVER_10_2_32a3829df17c3736d9757e423eeaf0e3($selection,$cluster_names);
	select  $cluster_names;
	BOVER_10_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
	select $curv;
	select -add  $cluster_names;
	BOVER_10_2_1b3bfd1d62d966ea966f5caca72bac5d(`ls-sl`, $show_outliner);
	BOVER_10_2_aa074854107180f09880ea0e8edd43f8;
	BOVER_10_2_b6a5017ee305f5ba0bbf3116243cc3af;
	BOVER_10_2_1f3f21e017b74355329202016bf1b177;
	BOVER_10_2_ade4e354383a28fcefcaf5ce40e6639d;
	string $ret[]=`ls-sl`;
	select $selection;
	return $ret;
}
global proc BOVER_10_2_1b3bfd1d62d966ea966f5caca72bac5d(string $objects[], int $hidden)
{
    string $shapes[];
    for ($obj in $objects)
    {
        setAttr ($obj  +  ".hiddenInOutliner") $hidden;
        $shapes=BOVER_10_2_5e702211108f11813c411c94f8b1b380($obj);
        for($shape in $shapes)
        {
             setAttr ($shape  +  ".hiddenInOutliner") $hidden;
        }
    }
}
global proc BOVER_10_2_c6ebe74a412a2810e00a55e90c1354fb(string $name_of_plugin)
{
    $maya_path=`getenv MAYA_LOCATION`;
    $path_to_plugin=$maya_path + "/bin/plug-ins/" + $name_of_plugin;
    catch(`loadPlugin -qt $path_to_plugin`);
    $plug_loaded=`pluginInfo -q -autoload $path_to_plugin`;
    if ($plug_loaded==0)
    {
       pluginInfo -edit -autoload true $path_to_plugin;
    }
}
global proc BOVER_10_2_2cab73e1b025877d71a8a8ee5666a2c8(string $sel_sets[])
{
    string $selected[], $obj;
    $selected=`ls -sl`;
    for($obj in $sel_sets)
        sets -rm $obj $selected;
    for($obj in $sel_sets)
        if(`sets -q -s $obj`==0)
            delete $obj;
    catchQuiet (`select -d  -ne $sel_sets`);
}
global proc string BOVER_10_2_4b209c5c00abddc3e3509a14326e2488(string $objects[], string $name_set)
{
    string $selected[]=`ls-sl`;
	string $createSetResult;
	select $objects;
    if( (`objExists($name_set)`) && (`objectType($name_set)` == "objectSet"))
        sets -edit -forceElement $name_set;
    else
        $createSetResult = `sets -name $name_set`;
	select $selected;
    return $createSetResult;
}
global proc BOVER_10_2_76e4594d663c1d36640d38425e50d327(string $objects[], string $name_set)
{
    if( (`objExists($name_set)`) && (`objectType($name_set)` == "objectSet"))
        {
          sets -rm $name_set;
         if(`sets -q -s $name_set`==0)
             delete $name_set;
        }
}
global proc BOVER_10_2_d04a25c84de52f4787d68215d32315e0(int $type, string $objcts[])
{
    for($obj in $objcts)
        catchQuiet(`setAttr ($obj + ".rotateOrder") $type`);
}
global proc BOVER_10_2_7f958423a7cfe1774157efdcb79ac0be(string $target_position[], string $object_to_move[])
{
	if(size($target_position)!=size($object_to_move))
		warning "size objects to rotate is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target_position)> size($object_to_move))
		$target_position=`ls -head (size($object_to_move)) $target_position`;
	float $Rot[];
	for($i=0;$i<size($target_position);$i++)
	{
		$Rot = `xform -q -ro -ws $target_position[$i]`;
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
	}
}
global proc BOVER_10_2_62ecfb8911e86b3a1289218b8327f62c()
{
    $currentPanel = `getPanel -withFocus`;
    string $panelType = `getPanel -to $currentPanel`;
    if ($panelType == "modelPanel")
    {
        enableIsolateSelect $currentPanel (!`isolateSelect -q -state  $currentPanel`);
        updateModelPanelBar $currentPanel;
        setIsolateSelectAutoAdd $currentPanel 1;
    }
}
global proc BOVER_10_2_05078bc34186b384ae74c2884ef2e734()
{
    $currentPanel = `getPanel -withFocus`;
    string $panelType = `getPanel -to $currentPanel`;
    if ($panelType == "modelPanel")
    {
        $currentPanel = `getPanel -withFocus`;
        enableIsolateSelect $currentPanel (!`isolateSelect -q -state  $currentPanel`);
        updateModelPanelBar $currentPanel;
        setIsolateSelectAutoAdd $currentPanel 1;
        string $meshes[]=`ls -type mesh -type nurbsSurface`;
        if(size($meshes)>0)
			for($obj in $meshes)
				catchQuiet(`isolateSelect -addDagObject $obj $currentPanel`);
    }
}
global proc BOVER_10_2_6437273b4eec79072ec7dfffd38f0708()
{
    string $selected[]=`ls-sl`;
    string $shapes[];
    for($obj in $selected)
    {
        $shppp_tmp=BOVER_10_2_5e702211108f11813c411c94f8b1b380($obj);
        appendStringArray($shapes, $shppp_tmp,size($shppp_tmp));
    }
    select $shapes;
    $currentPanel = `getPanel -withFocus`;
    string $panelType = `getPanel -to $currentPanel`;
    if ($panelType == "modelPanel")
    {
        $currentPanel = `getPanel -withFocus`;
        enableIsolateSelect $currentPanel (!`isolateSelect -q -state  $currentPanel`);
        updateModelPanelBar $currentPanel;
        setIsolateSelectAutoAdd $currentPanel 1;
        string $meshes[]=`ls -type mesh -type nurbsSurface`;
        if(size($meshes)>0)
			for($obj in $meshes)
				catchQuiet(`isolateSelect -addDagObject $obj $currentPanel`);
    }
   select  $selected;
}
global proc string BOVER_10_2_c884f4200431a153fb44b960cecbef34(string $object)
{
    string $shapes_object[];
    string $object_type;
    $shapes_object=BOVER_10_2_5e702211108f11813c411c94f8b1b380($object);
    if($shapes_object[0]!=$object)
        $object_type=`objectType $shapes_object[0]`;
    else
        $object_type=`objectType $object`;
    return $object_type;
}
global proc BOVER_10_2_a204d82b0cc11ef9adf835ab99270c74(string $objects[])
{
    string $shapes[];
    for($o in $objects)
    {
        $shpss=BOVER_10_2_5e702211108f11813c411c94f8b1b380($o);
        for($obj in $shpss)
            setAttr  ($obj + ".isHistoricallyInteresting")  0;
    }
}
global proc string[] BOVER_10_2_4444d6118d676b89ef3372a0f3254e9f(string $objects[])
{
	string $top_sel[],$fin_tops[]={};
	string $tmp_objects[];
	string $All_objects[]={};
	for($obj in $objects)
	{
		select $obj;
		$object_type=BOVER_10_2_c884f4200431a153fb44b960cecbef34($obj);
		select -hi;
		$clth_j=BOVER_10_2_1ed150b12535ee196bee8b74a6bf5f5c(`ls -fl -sl`, $object_type);
		$hcl=`ls -tl (size($clth_j) -1) $clth_j `;
		appendStringArray($All_objects,$hcl,size($hcl));
	}
	$fin_tops= stringArrayRemove ($All_objects, $objects);
	return $fin_tops;
}
global proc string[] BOVER_10_2_23852b7a7db0eb3a10eb7d71badc9851()
{
	string $selected[]=`ls-sl`;
	string $cluster_name[];
	string $grpps[]=`BOVER_10_2_e6d1cc62e700198ddfd8906d663761ba`;
	string $locks[]=BOVER_10_2_e706e982298fe9e8f94ae04b06b5d6b2("len_l");
    BOVER_10_2_90a059e9200ad500213586e0ecabdd0d($locks, 0,1, 1, 1);
	BOVER_10_2_17431451b1be026fdeee93b86579c6b6($selected, $grpps);
	select -cl;
	select $locks;
	string $curve_name=BOVER_10_2_a8d1933a966541e62d79a2fcbf6e4ea4(1);
    BOVER_10_2_90a059e9200ad500213586e0ecabdd0d({$curve_name}, 1,1, 1, 1);
	string $curve_shape_name[]=`pickWalk -d down`;
	for($i=0;$i<size($locks);$i++)
	{
		$cluster_name=`cluster ($curve_name + ".cv[" + $i + "]")`;
		parent   $cluster_name[1] $locks[$i];
		BOVER_10_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
	}
	rebuildCurve -ch 1 -rpo 1 -rt 0 -end 1 -kr 0 -kcp 0 -kep 0 -kt 0 -s (size($locks)) -d 3 -tol 0.01 $curve_name;
	string $nodename_curve=`createNode "curveInfo"`;
	connectAttr -f ($curve_shape_name[0] + ".worldSpace[0]") ($nodename_curve + ".inputCurve");
	addAttr -ln ("distance")  -at double  $curve_name;
	setAttr -keyable true -channelBox true ($curve_name + ".distance");
	setAttr -keyable true ($curve_name + ".distance");
	connectAttr -f ($nodename_curve + ".arcLength") ($curve_name + ".distance");
	addAttr -ln ("max_distance")  -at double  -dv 1 $curve_name;
	setAttr -keyable true -channelBox true ($curve_name + ".max_distance");
	setAttr -keyable true ($curve_name + ".max_distance");
	addAttr -ln ("min_distance")  -at double  $curve_name;
	setAttr -keyable true -channelBox true ($curve_name + ".min_distance");
	setAttr -keyable true ($curve_name + ".min_distance");
	addAttr -ln ("normalise_distance")  -at double  $curve_name;
	setAttr -keyable true -channelBox true ($curve_name + ".normalise_distance");
	setAttr -keyable true ($curve_name + ".normalise_distance");
	string $nodename=`createNode "setRange"`;
	setAttr ($nodename + ".maxX") 1;
	setAttr ($nodename + ".minX") 0;
	connectAttr -f ($nodename_curve + ".arcLength") ($nodename + ".valueX");
	connectAttr -f ($curve_name + ".max_distance") ($nodename + ".oldMaxX");
	connectAttr -f ($curve_name + ".min_distance") ($nodename + ".oldMinX");
	connectAttr -f ($nodename + ".outValueX") ($curve_name + ".normalise_distance") ;
	select $curve_name;
	$curve_name_fin=BOVER_10_2_e706e982298fe9e8f94ae04b06b5d6b2("lenght_crv");
	select $grpps;
	$grpps=BOVER_10_2_e706e982298fe9e8f94ae04b06b5d6b2("lenght_crv_grpp");
	select -add $curve_name_fin;
	string $tot_gr=`group  -n "multi_dist" $grpps`;
    xform -piv 0 0 0 $tot_gr;
    BOVER_10_2_90a059e9200ad500213586e0ecabdd0d($grpps, 1,1, 1, 1);
	appendStringArray ($curve_name_fin,$grpps,size($grpps));
	select $locks;
	$curve_name_fin[size($curve_name_fin)]=$tot_gr;
	return $curve_name_fin;
}
global proc BOVER_10_2_74b3586ec5f33152020ca1d5764043c3()
{
    $selected_loc=`ls-sl`;
	float $rx=1;
	float $ry=1;
	float $local_pos[];
	float $local_rot[];
	float $local_rotTmp[];
	float $joint_radius=0.5;
	string $shapes[];
	float $curr_unit=BOVER_10_2_f71c299bf7b53f7243b078a9990e581c(1);
	for($loc in $selected_loc)
	{
	   	$shapes1=`listRelatives  -type "shape"  -f  $loc`;
		$color=`getAttr  ($loc + ".overrideColor") `;
		catchQuiet($joint_radius = (`getAttr  ($loc + ".radius")`));
        catchQuiet($local_pos = (`getAttr  ($loc + ".localPosition")`));
		catchQuiet($local_rot = (`getAttr ($shapes1[0] + ".localScale")`)  );
		$cirle=`circle  -c 0 0 0  -nr 0 0 1 -sw 360 -r ($joint_radius*2*$curr_unit) -d 3 -ut 0 -tol 1e-06 -s 8 -ch 1  `;
		move -a $local_pos[0]  $local_pos[1] $local_pos[2] $cirle;
		$local_rotTmp=`sort $local_rot`;
		delete -ch;
	    if($local_rotTmp[2]!=0)
		    scale -r -p  ($local_pos[0] + "cm") ($local_pos[1] + "cm") ($local_pos[2] + "cm") ($local_rotTmp[2]/$curr_unit/$curr_unit) ($local_rotTmp[2]/$curr_unit/$curr_unit) ($local_rotTmp[2]/$curr_unit/$curr_unit) ($cirle[0] + ".cv[0:7]");
		if(($local_rot[0]+$local_rot[1]+$local_rot[0])/3!=$local_rot[0])
		{
		if ($local_rotTmp[0]==$local_rot[0])
		    rotate -r -p  ($local_pos[0] + "cm") ($local_pos[1] + "cm") ($local_pos[2] + "cm") -ws -fo 0 90 0 ($cirle[0] + ".cv[0:7]");
		else if ($local_rotTmp[0]==$local_rot[1])
		    rotate -r -p  ($local_pos[0] + "cm") ($local_pos[1] + "cm") ($local_pos[2] + "cm") -ws -fo 90 0 0 ($cirle[0] + ".cv[0:7]");
		}
		select $loc $cirle[0];
		$objects=`ls-sl`;
		$shapes=`listRelatives  -type "shape"  -f  $objects[0]`;
		catchQuiet(`setAttr ($shapes[0] + ".visibility") 1`);
		for($i=1;$i<size($objects);$i++)
		{
			$shapes=`listRelatives -shapes  $objects[$i]`;
			delete (`parentConstraint $objects[0] $objects[$i] `);
			parent $objects[$i] $objects[0];
			makeIdentity -apply 1 $objects[$i];
			$j=0;
			for($sh in $shapes)
			{
			    $ren=`rename $sh  ($loc+ "Shape" + $j)`;
			    parent -add  -s $ren $objects[0];
			}
		}
		catchQuiet(`delete $shapes1`);
		delete $objects[1];
		select $objects[0];
		$shapes=`listRelatives  -type "shape"  -f  $objects[0]`;
		catchQuiet(`setAttr -keyable false -channelBox true ($shapes[1] + ".rcurve")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".cwdth")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".srate")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderr")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderg")`);
		catchQuiet(`setAttr -keyable false -channelBox true  ($shapes[1] + ".ai_curve_shaderb")`);
        catchQuiet(`setAttr ($shapes[1] + ".overrideEnabled")  1`);
		catchQuiet(`setAttr -lock false ($shapes[1] + ".overrideColor") $color`);
		select $shapes[0];
		catchQuiet(`select $shapes[1]`);
	}
	select $selected_loc;
}
