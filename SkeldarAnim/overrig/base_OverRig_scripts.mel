global proc string[] BOVER_10_2_30985afbf7e25026e0b41b344e39aa72(string $objects[])
{
	string $positioning = "default";
	string $exclusiveName = "";
	int $ii;
	int $numObjects = size($objects);
	if ($numObjects == 0)
	{
		error( (uiRes("m_doJiggle.kNoDeformableSel")));
		return{};
	}
	string $jiggle;
	string $res[];
	string $obj;
	select -clear;
	for($ii = 0; $ii < $numObjects; $ii++)
	{
		$obj = $objects[$ii];
		$cmd = "deformer -type jiggle ";
		if ($exclusiveName != "")
			$cmd += (" -exclusive \""+$exclusiveName+"\"");
		if ($positioning != "default")
			$cmd += (" -"+$positioning);
		$cmd += " " + $obj;
		$res = `eval $cmd`;
		string $jiggle = $res[0];
		connectAttr time1.outTime ($jiggle + ".currentTime");
		setAttr ($jiggle+".ignoreTransform") 0;
		setAttr ($jiggle+".enable") 0;
		setAttr ($jiggle+".stiffness") 0.5;
		setAttr ($jiggle+".damping") 0.5;
		setAttr ($jiggle+".jiggleWeight") 1;
	}
	return $res;
}
global proc string BOVER_10_2_a0b1ccb530c89eb90e4a1b647be4ed19(float $hardness, float $sdvig_lenght, float $sdvig_side, float $smooth_end, int $cycled, int $abs_mode )
{
	undoInfo -ock -cn "BOVER_10_2_a0b1ccb530c89eb90e4a1b647be4ed19";
    $curren_time=`currentTime -q`;
	BOVER_10_2_90caf8375dffdf325df3be666537a016;
	$selection=`ls-sl`;
	BOVER_10_2_9bad7ec683c4a9fc4b3098a039f34d33(8,1);
	$joints=`ls-sl`;
    string 	$top_locks[];
    string $side_locks[];
    float $lenght_aim_move;
    if($abs_mode==1)
    {
        $sdvig_lenght=$sdvig_lenght/size($selection);
        $sdvig_side=0;
        $smooth_end=0;
    }
    $size=size($joints);
    for ($i=0; $i<size($joints);$i++)
	{
    	select $joints[$i];
    	BOVER_10_2_c642429ed9a3aabf65a66eefcd97bfbb;
        if ($i!=`size($joints)`-1)
        {
            $lenght_aim_move=BOVER_10_2_c7822f1f10b007a6803735c105e40799($joints[$i], $joints[$i+1]);
        }
        else
    	{
    	    $lenght_aim_move=BOVER_10_2_c7822f1f10b007a6803735c105e40799($joints[$i], $joints[$i-1]);
    	}
    	move -r -os -wd ($lenght_aim_move*$hardness) 0 0 ;
    	pickWalk -d right;
    	move -r -os -wd 0 (-1*$lenght_aim_move*$hardness) 0 ;
    	BOVER_10_2_10df34add5a583f84d24608e860c1b4b;
    	$tops=`ls-sl`;
    	$top_locks[$i]=$tops[0];
    	keyframe -e -iub true -r -o over -tc ($sdvig_lenght + $i*$smooth_end);
    	pickWalk -d right;
    	$sides=`ls-sl`;
    	$side_locks[$i]=$sides[0];
    	keyframe -e -iub true -r -o over -tc ($sdvig_side +$i*$smooth_end);
    	if ($cycled)
    	{
    		select $tops $sides;
    		animCurveEditor -edit -displayInfinities 1 graphEditor1GraphEd;
    		setInfinity -pri cycle -poi cycle;
    	}
	}
	select $top_locks $side_locks $joints[0];
	string $gr_name=`group -n "hvost"`;  xform -os -piv 0 0 0;
	select $top_locks $side_locks;
	select $selection;
	select $top_locks;
	currentTime  $curren_time;
	undoInfo -cck;
	return $gr_name;
}
global proc string BOVER_10_2_8358654186ce68fce780ef66a4260a01(string $object)
{
    string $selection[]=`ls-sl`;
    global string $global_mt_name;
    $global_mt_name=$object + "_motionTrailHandleShape";
    $global_mt_name_bsw=$object + "_motionTrailHandle";
	$c_time=`currentTime-q`;
	int $startFrame;
	int $endFrame;
	int $fr_before=getAttr ($global_mt_name_bsw + ".start");
	int $fr_after=getAttr ($global_mt_name_bsw + ".end");
	if($fr_before!=0)
        $startFrame = $c_time-$fr_before;
    else
        $startFrame=`playbackOptions -q -min`;
    if($fr_after!=0)
        $endFrame = $c_time+$fr_after;
    else
        $endFrame=`playbackOptions -q -max`;
    float $pos[];
    float $wpos[];
    string $m_trail[];
    string $positio="";
    for ($frame = $startFrame; $frame <=$endFrame; $frame++)
    {
       $pos = `getAttr -time $frame ( $object + ".translate")`;
        $wpos[0] = BOVER_10_2_f71c299bf7b53f7243b078a9990e581c($pos[0]);
        $wpos[1] = BOVER_10_2_f71c299bf7b53f7243b078a9990e581c($pos[1]);
        $wpos[2] = BOVER_10_2_f71c299bf7b53f7243b078a9990e581c($pos[2]);
        $positio=$positio + floatArrayToString( $wpos, " " ) + " 1 ";
    }
    $cmd="setAttr " + $global_mt_name + ".points -type pointArray " + ($endFrame-$startFrame+1) + " " + $positio + ";";
    $cmd=$cmd + "\nsetAttr " + $object + "_motionTrail.startTime " + $startFrame + ";";
    $cmd=$cmd + "\nsetAttr " + $object + "_motionTrail.endTime " + $endFrame+ ";";
    eval ($cmd);
    return $global_mt_name;
}
global proc int BOVER_10_2_37aa5a96585e35a67af0d77c7cbea21c()
{
    $selection=`ls -sl`;
    string $obj_in_layers[];
    string  $aff[];
    $i=0;
    string $obj;
    for ($obj in $selection)
    {
        select $obj;
        $aff=getAffectedLayers({$obj});
        if(size($aff)>=1)
        {
            $obj_in_layers[$i]=$obj;
            $i++;
        }
    }
    select $obj_in_layers;
    string  $affected_layers[], $lay, $locked_a_layers[], $unlocked_a_layers[], $locked_muted_a_layers[],$locked_un_muted_a_layers[];
    $size=size($obj_in_layers);
    if ($size>=1)
    {
        $affected_layers=getAffectedLayers($obj_in_layers);
        for($lay in $affected_layers)
            {
                if(`animLayer -q -lock  $lay`==1)
                    appendStringArray($locked_a_layers, {$lay},1);
                else
                    appendStringArray($unlocked_a_layers, {$lay},1);
            }
        for($lay in $locked_a_layers)
            {
                if(`animLayer -q -mute  $lay`==1)
                    appendStringArray($locked_muted_a_layers, {$lay},1);
                else
                    appendStringArray($locked_un_muted_a_layers, {$lay},1);
            }
        for($lay in $locked_a_layers)
            animLayer -edit -mute 1 $lay;
        BOVER_10_2_de88efca2929f0080ae1d45ff5db42d4;
        BOVER_10_2_e503fab70a8f9fdcc7cdd1520fc26701($selection,  $unlocked_a_layers);
        deleteEmptyAnimLayers();
        for($lay in $locked_un_muted_a_layers)
            animLayer -edit -mute 0 $lay;
    }
    select -cl;
    int $have_locked=0;
    select  $selection;
	if ($size>=1)
		euler_filter_on_selected;
	if (size($locked_a_layers)>0)
	    $have_locked=1;
	return $have_locked;
}
global proc BOVER_10_2_e503fab70a8f9fdcc7cdd1520fc26701(string $objects[], string $layers[])
{
	for($layer in $layers)
		if (`objectType $layer` == "animLayer")
		{
			string $attributes[] = `animLayer -query -attribute $layer`;
			for($attribute in $attributes)
			{
				$attribute_full_name = `ls -l $attribute`;
				$node_full_name = `plugNode $attribute_full_name[0]`;
				for($object in $objects)
				{
					$object_full_name = `ls -l $object`;
					if( $node_full_name == $object_full_name[0] )
						eval( "animLayer -edit -removeAttribute " + $attribute +" "+ $layer );
				}
			}
		}
}
global proc BOVER_10_2_c53bf77b0f2a5276b2dd47d6531b8351(float $scale_size)
{
	float $value[];
	float $fr[];
	float $fr_end,$fr_start;
	float $v_range,$r;
	float $straight_value_pos;
	string $curve[] = `keyframe -q -n -sl`;
	for($i=0;$i<size($curve);$i++)
	{
		$fr  = `keyframe -q -tc -sl $curve[$i]`;
		if(size($fr)>2)
		{
			$value  = `keyframe -q -vc -sl $curve[$i]`;
			$v_start = $value[0];
			$v_end = $value[size($value)-1];
			$fr_start=$fr [0];
			$fr_end=$fr [(size($fr))-1];
			$r =$fr_end - $fr_start;
			$v_range=$v_end - $v_start;
			for($k=1;$k<size($fr)-1;$k++)
			{
				$frame_proportion_pose=($fr [$k]-$fr_start)/$r;
				$straight_value_pos = $v_range*$frame_proportion_pose + $v_start;
				scaleKey  -iub false -ts 1  -fs 1 -fp 0  -valueScale $scale_size -valuePivot $straight_value_pos -tp ($fr [$k]) -t ($fr [$k])  $curve[$i];
			}
		}
	}
	currentTime -e `currentTime -q`;
}
global proc string BOVER_10_2_0de82cdf33b304b70eeb09e2364b6639(int $interpolation)
{
    $selection_true = `ls -fl -sl `;
	string $selection[]=`ls -fl -os`;
	vector $coords[];
	string $pnt = "";
	float $getPvPos[];
	if (size ($selection)<=1)
	{
		warning "select 2 object or points";
		return "";
	}
    $coords=BOVER_10_2_72356eaf232b169651a82383ba9e7e57($selection);
    $curve_name=BOVER_10_2_b2c2f82fa827619e8c93045ffb3b18c5($coords,$interpolation);
    return $curve_name;
}
global proc string BOVER_10_2_b2c2f82fa827619e8c93045ffb3b18c5(vector $coords[],int $interp)
{
	string $pnt = "";
	if (size ($coords)<=1)
	{
		warning "need 2 object or points";
		return "";
	}
	for ($i=0;$i<size($coords);$i++)
	{
		$pnt= $pnt + " -ep " + $coords[$i];
	}
	$curve_name=`eval("curve" + $pnt + "-d " + $interp)`;
	return $curve_name;
}
global proc string[] BOVER_10_2_9e011938cc58f7485f1dc49c9ffda589()
{
    string $selection[]=`ls-fl-os`;
    string $lock[]=BOVER_10_2_0a10c57fddb9b8e3dc07486c3a9a5eed();
    for($i=0;$i<size($selection);$i++)
        if(!((`objectType -isType "mesh" $selection[$i]`)+(`objectType -isType "nurbsSurface" $selection[$i]`)+(`objectType -isType "nurbsCurve" $selection[$i]`)+(`objectType -isType "lattice" $selection[$i]`)))
            delete `orientConstraint $selection[$i] $lock[$i]`;
    return $lock;
}
global proc string[] BOVER_10_2_5b85a4b79f18d1c94d20e84bce8d3507(string $objects[])
{
    string $lock[]=BOVER_10_2_526c020cd7c9a859fd08d49719a4fddf($objects);
    for($i=0;$i<size($objects);$i++)
        if(!((`objectType -isType "mesh" $objects[$i]`)+(`objectType -isType "nurbsSurface" $objects[$i]`)+(`objectType -isType "nurbsCurve" $objects[$i]`)+(`objectType -isType "lattice" $objects[$i]`)))
            delete `orientConstraint $objects[$i] $lock[$i]`;
    return $lock;
}
global proc BOVER_10_2_362097ccb67f022586b0446097316e3e(string $target_position[], string $object_to_move[])
{
	float $Trans[];
	float $Rot[];
	string $ro;
	string $loc[]=`spaceLocator`;
	for($i=0;$i<size($target_position);$i++)
	{
        $ro=`xform -q -roo $object_to_move[$i]`;
        delete `orientConstraint $target_position[$i] $loc[0]`;
        xform -p 1 -roo $ro $loc;
        $Trans=`xform -q -ws -piv $target_position[$i]`;
		$Rot= `xform -q -ro -ws $loc[0]`;
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
	}
	delete 	$loc;
}
global proc BOVER_10_2_113374ba19bc1f4dc9b1cc9706816f86(string $objects[])
{
	if(!size($objects))
		return;
	string $obj;
	for($obj in $objects)
	{
		setAttr -lock true ($obj + ".translateX");
		setAttr -lock true ($obj + ".translateY");
		setAttr -lock true ($obj + ".translateZ");
	}
}
global proc float[] BOVER_10_2_d47b8e8b02e1593b7af35176139fac48(string $array[])
{
	float $output[];
	int $count = size($array);
	if (!$count)
        return $output={};
	for ($i = 0; $i < $count; $i++)
		$output[$i]= $array[$i];
	return $output;
}
global proc int[] BOVER_10_2_6683697d5c6a9d073c8ba6066a2c3d5e(string $long_list[], string $short_list[])
{
    int $indexes[];
    for($j=0;$j<size($long_list);$j++)
        $indexes[$j]=-1;
    for($i=0;$i<size($short_list);$i++)
        for($j=0;$j<size($long_list);$j++)
           if($long_list[$j]==$short_list[$i])
              $indexes[$j]=$i;
    return $indexes;
}
global proc BOVER_10_2_0f1ac522d0b034408fd36bd87fb46cb3()
{
    string $selected[]=`ls-sl`;
    string $selected_joints[]=`ls-sl-type "joint"`;
    select  $selected_joints;
    string $lock_name[]=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
    string $constrain_name[]=BOVER_10_2_17431451b1be026fdeee93b86579c6b6($lock_name, $selected_joints);
    select $selected_joints;
    BOVER_10_2_3a25eaad774c71ebdcb06ee4d2b25ce3;
    delete $constrain_name;
    delete $lock_name;
    BOVER_10_2_95d47209f5832c068ce7614b82201089;
    select  $selected;
}
global proc string[] BOVER_10_2_4874f5c758343518c484dc3cb8ee48b0(int $dergee, int $num_CV_on_drawn_curve, int $proportional, int $connect)
{
	$selected_base=`ls-sl`;
	$selected=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
	BOVER_10_2_5cb0441daec59a79a525bdb749d48438("x");
	if ($connect)
	    BOVER_10_2_4a0278149f801323f33f7bb9e4ee597d($selected,$selected_base);
	$num=size($selected);
	$curve_name=BOVER_10_2_a8d1933a966541e62d79a2fcbf6e4ea4($dergee);
	if($num_CV_on_drawn_curve!=0)
		rebuildCurve -ch 0 -rpo 1 -rt 0 -end 1 -kr 0 -kcp 0 -kep 0 -kt 0 -s $num_CV_on_drawn_curve -d $dergee -tol 0.01  $curve_name;
	if($proportional)
		$curves_base=`rebuildCurve -ch 1 -rpo 0 -rt 0 -end 1 -kr 0 -kcp 0 -kep 0 -kt 0 -s ($num) -d  3 -tol 0.01 $curve_name`;
	else
		$curves_base[0]=$curve_name;
	$point_on_curve_node=`createNode nearestPointOnCurve`;
	$rebild_curve_shape_base=BOVER_10_2_5e702211108f11813c411c94f8b1b380($curves_base[0]);
	connectAttr -f ($rebild_curve_shape_base[0] + ".worldSpace[0]") ($point_on_curve_node + ".inputCurve");
	$i=0;
	for($obj in $selected)
	{
		$pos=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($obj);
		setAttr ($point_on_curve_node + ".inPositionX") $pos[0];
		setAttr ($point_on_curve_node + ".inPositionY") $pos[1];
		setAttr ($point_on_curve_node + ".inPositionZ") $pos[2];
		$start_pos=`getAttr  ($point_on_curve_node + ".parameter ")`;
		$point_on_curve_info_node=`createNode pointOnCurveInfo`;
		connectAttr -f ($rebild_curve_shape_base[0] + ".worldSpace[0]") ($point_on_curve_info_node + ".inputCurve");
		connectAttr -f ($point_on_curve_info_node + ".position") ($obj + ".translate");
		setAttr ($point_on_curve_info_node + ".parameter") $start_pos;
	}
	delete $point_on_curve_node;
	select $selected $curve_name $curves_base[0];
	return` ls-sl` ;
}
global proc string BOVER_10_2_1325d6f8979e36be5cd12865010fabb9(float $radius)
{
	string $curves[];
	clear $curves;
	$crv=`circle -c 0 0 0 -nr 0 0 1 -sw 360 -r  $radius -d 3 -ut 0 -tol 0.01 -s 8 -ch 0`;
	catchQuiet (`setAttr -lock true ($crv[0] + ".rcurve")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".cwdth")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".srate")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".ai_curve_shaderr")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".ai_curve_shaderg")`);
	catchQuiet (`setAttr -lock true ($crv[0] + ".ai_curve_shaderb")`);
	appendStringArray( $curves, $crv, 1);
	$crv=`duplicate -rr -rc`;
	rotate -a -ws -fo 0 90 0 ;
	appendStringArray( $curves, $crv, 1);
	$crv=`duplicate -rr -rc`;
	rotate -r -ws -fo 0 0 90 ;
	appendStringArray( $curves, $crv, 1);
	select $curves;
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
	for($i=1;$i<size($curves);$i++)
	{
		$shapes=`listRelatives -shapes  $curves[$i]`;
		parent -add  -s  $shapes $curves[0];
	}
	select $curves;
	select -d $curves[0];
	delete;
	select $curves[0];
	BOVER_10_2_a204d82b0cc11ef9adf835ab99270c74({$curves[0]});
	makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
	return $curves[0];
}
global proc int BOVER_10_2_c3face5af2eaef8e548ce10d50587275(string $curve)
{
    int $numCVs = `getAttr -size ($curve + ".controlPoints")`;
    select -replace ($curve + ".cv[0:" + ($numCVs -1) + "]") ;
    return $numCVs;
}
global proc string BOVER_10_2_d6ba61d8fe378e9808f1f492e2edde00()
{
	$select=`ls-sl`;
	string $channel_name;
	string $nodename=`createNode "distanceBetween"`;
	BOVER_10_2_a204d82b0cc11ef9adf835ab99270c74({$nodename});
	connectAttr -f ($select[0] + ".worldMatrix[0]") ($nodename + ".inMatrix1");
	connectAttr -f ($select[1] + ".worldMatrix[0]") ($nodename + ".inMatrix2");
	addAttr -ln ("distance_to_" + $select[1])  -at double  $select[0];
	$channel_name = ("distance_to_" + $select[1]);
	setAttr -keyable true -channelBox true ($select[0] + "." + $channel_name);
	setAttr -keyable true ($select[0] + "." + $channel_name);
	connectAttr -f ($nodename + ".distance") ($select[0] + "." + $channel_name);
	select $select[0];
	return $channel_name;
}
global proc float BOVER_10_2_9cf10c253bb06da91bcfe3836a7e5f36(float $pos1[], float $pos2[])
{
    vector $p1_p2=<<$pos1[0],$pos1[1],$pos1[2]>> -<<$pos2[0],$pos2[1],$pos2[2]>>;
    $lenght=(`mag $p1_p2`);
    return $lenght;
}
global proc float[] BOVER_10_2_6f6ae5b84133776f167ce9bbf3409540(float $point1[],float $point2[],float $point3[])
{
	float $vector1[]={$point2[0]-$point1[0],$point2[1]-$point1[1],$point2[2]-$point1[2]};
	float $vector2[]={$point3[0]-$point1[0],$point3[1]-$point1[1],$point3[2]-$point1[2]};
	float $orto[]=crossProduct($vector2, $vector1, 1, 1);
	float $result[]=crossProduct($vector1, $orto, 1, 1);
	return $result;
}
global proc string[] BOVER_10_2_a6419ea23ba72391ef5d39ad4748adbc(string $objectA, string $objectB, float $kratDistances)
{
    float $point1[]=BOVER_10_2_174b5e03acbe9a8ba7bf83b031094a2e($objectA);
    float $point2[]=BOVER_10_2_174b5e03acbe9a8ba7bf83b031094a2e($objectB);
    float $point3[]=BOVER_10_2_d43bd93439ed3879a3deac8b4d5b5d0d($point1,$point2,$kratDistances);
    string $finLock[]=`spaceLocator`;
    move -a -ws $point3[0] $point3[1] $point3[2] $finLock;
    return  $finLock;
}
global proc string BOVER_10_2_f9ccf45626df05475e8ab66b6f511dd6(string $objects[])
{
    $num=size($objects);
    $posA=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($objects[0]);
    $posB=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($objects[$num-1]);
    float $dists[];
    $dists[0]=0;
    $dists[$num-1]=0;
    for($i=1;$i<$num-1;$i++)
    {
        $pos3=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($objects[$i]);
        $dists[$i]=BOVER_10_2_476390711655739e4d4919b7f7336b00($posA,$posB,$pos3);
    }
    int $index=BOVER_10_2_d0a0b515ba819d3c77adb0bbe48cfd1d( $dists,1);
    return  $objects[$index];
}
global proc string[] BOVER_10_2_d860af6b95aef5a0cb10ce55130860ef(int $lock)
{
	string $object[]=`ls-sl`;
	select -cl;
	select $object;
	string $parents[]=BOVER_10_2_e34225338b41391d68d09634ca599397(0);
	string $groups[]=BOVER_10_2_9e011938cc58f7485f1dc49c9ffda589();
	$groups=BOVER_10_2_10b1c67feba7e9570357d44ba9306692 ("", $object,"_group");
	BOVER_10_2_32a3829df17c3736d9757e423eeaf0e3($parents,$groups);
	BOVER_10_2_32a3829df17c3736d9757e423eeaf0e3($groups,$object);
	BOVER_10_2_90a059e9200ad500213586e0ecabdd0d($groups, $lock, $lock,$lock, $lock);
	return $groups;
}
global proc float[] BOVER_10_2_d43bd93439ed3879a3deac8b4d5b5d0d(float $point1[],float $point2[],float $kratDistances)
{
	float $res[];
	vector $a=<<$point1[0],$point1[1],$point1[2]>>;
	vector $b=<<$point2[0],$point2[1],$point2[2]>>;
	$k=$a + ($b-$a)*$kratDistances;
	$res=$k;
	return $res;
}
global proc  BOVER_10_2_e517b6b2462b78688e6c156f585668b5()
{
	string $neighbors[]=BOVER_10_2_6c03bcf1c4cd077aea727f60dfb001f6(3,"*barn_bend_IK_tool*");
	string $buffer[];
	string $lock[];
	float $end_position[];
	string $end_lock[];
	string $zaglavie="\n\n\n\n\n\n\n\n\n\n\n\n\n\n\/\/----------------------------------------\n\/\/script for assign IK_Twist_Nodes\n\/\/----------------------------------------\n\n\n";
	string $cmd;
	string $cmd_value;
	if(size($neighbors)!=0)
	{
    	$cmd="\n\tstring $end_lock[]={};\n\tstring $all_n_lock[]={};\n";
    	$j=0;
    	$cmd_value="\/\/collect bend IK node items\n";
    	for($item in $neighbors)
    	{
    		tokenize $item ";" $buffer;
    		$lock=BOVER_10_2_fc2f0db118cb44a00adf5c2fa86f649a($buffer);
    		$cmd_value=$cmd_value + "string $node_bend_IK_items_" + $j + "[]={";
    		for($i=0;$i<size($buffer)-2;$i++)
    			$cmd_value=$cmd_value + "\"" + $buffer[$i] + "\",";
    		$cmd_value=$cmd_value + "\"" + $buffer[$i]+ "\"";
    		if($lock[0]!="")
    			$cmd_value=$cmd_value +  "};\n";
    		else
    			$cmd_value=$cmd_value + ",\"" + $buffer[$i+1]+ "\"};\n";
    		$j++;
    	}
    }
	string $twi_neighbors[]=BOVER_10_2_6c03bcf1c4cd077aea727f60dfb001f6(3,"*barn_twist_IK_tool*");
	string $cmd_twist_value;
	string $twi_cmd;
	if(size($twi_neighbors)!=0)
	{
    	$cmd_twist_value="\/\/collect twist node items\n";
    	$j=0;
    	for($item in $twi_neighbors)
    	{
    		tokenize $item ";" $buffer;
    		$lock=BOVER_10_2_fc2f0db118cb44a00adf5c2fa86f649a($buffer);
    		$cmd_twist_value=$cmd_twist_value + "string $node_twist_items_" + $j + "[]={";
    		for($i=0;$i<size($buffer)-1;$i++)
    			$cmd_twist_value=$cmd_twist_value + "\"" + $buffer[$i] + "\",";
    		$cmd_twist_value=$cmd_twist_value + "\"" + $buffer[$i]+ "\"};\n";
    		$j++;
    	}
    	$cmd_twist_value =  $cmd_twist_value + "\n";
    	string $n_twi_val_name;
    	for($j=0;$j<size($twi_neighbors);$j++)
    		$twi_cmd= $twi_cmd +  "\tcreate_toggler_node_connections($node_twist_items_" + $j + ",\"barn_twist_IK_tool\");\n\n";
	}
	$cmd= $zaglavie + $cmd_value + $cmd_twist_value + $cmd + $twi_cmd  ;
	string $n_val_name;
	int $lock_size=0;
	if(size($neighbors)!=0)
	{
    	for($j=0;$j<size($neighbors);$j++)
    	{
    		tokenize $neighbors[$j] ";" $buffer;
    		$lock=BOVER_10_2_fc2f0db118cb44a00adf5c2fa86f649a($buffer);
    		$n_val_name=" $node_bend_IK_items_" + $j;
    		if($lock[0]!="")
    		{
    			$lock_size++;
    			$end_position=`getAttr ( $lock[0] + ".translate")`;
    			$cmd= $cmd + "\t$end_lock=`spaceLocator`;\n\tappendStringArray($all_n_lock,$end_lock,1);\n\tparent $end_lock[0] " +  $n_val_name + "[" + (size($buffer) - 2) + "];\n";
    			$cmd= $cmd + "\tmove -ls " + $end_position[0] + " " + $end_position[1] + " " + $end_position[2] + " $end_lock;\n";
    		}
    		$cmd= $cmd + "\tselect " + $n_val_name;
    		if($lock[0]!="")
    			$cmd= $cmd + " $end_lock";
    		$cmd= $cmd + ";\n";
    		$cmd= $cmd +  "\tcreate_toggler_node_connections(`ls-sl`,\"barn_bend_IK_tool\");\n\n";
    	}
    	if($lock[0]!="")
    	{
    	   $cmd= $cmd + "\tselect $all_n_lock;\n";
    	   $cmd= $cmd + "\trotate 0 0 0;\n";
    	   for($i=0;$i<$lock_size;$i++)
    		   $cmd= $cmd + "\tsetAttr ( $all_n_lock[" +$i + "] + \".v\") 0;\n";
    	   $cmd= $cmd + "\tsetAttr -lock true .tx;\n\tsetAttr -lock true .ty;\n\tsetAttr -lock true .tz;\n\tsetAttr -lock true .rx;\n\tsetAttr -lock true .ry;\n\tsetAttr -lock true .rz;\n\tsetAttr -lock true .sx;\n\tsetAttr -lock true .sy;\n\tsetAttr -lock true .sz;\n";
    	}
    }
    $cmd=$cmd + "\n\/\/end of collect bend IK node items script";
	print $cmd;
}