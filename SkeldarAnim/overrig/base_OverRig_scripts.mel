		catch(BOVER_10_2_f0549514de82c9ee2236723b537462e7($correct_lock, $name_constr, "attach", $frame_range,1));
	select $joints;
	BOVER_10_2_70e1c4b7692160ed48aa4962be320af3 ($joints, 1);
	currentTime $c_time;
	catchQuiet(BOVER_10_2_15760bd5ac6225f582185bab24346a67($size));
    select 	$correct_lock;
    catchQuiet(BOVER_10_2_6de8028af587b467034457b4d6349f89($size*1.5));
    return $joints;
}
global proc  BOVER_10_2_5af02f105b3c73a5596102329399dcb1(int $static)
