/*Set of basic scripts for the OverRig animation method
Author: Pavel Barnev pavel_barnev2000@mail.ru
Installation:
Quick Installation:
    unzip the file into a directory of choice
    Start Maya.
    Drag file:
	Drag_and_Drop_to_install.mel
	into a MAYA window. The script icon will appear on current tab on the Shelf Editor
What is OverRig animation method??
	- convert the animation of objects into a convenient structure for animating this episode
it is a powerful animation technique
	-  will speed up the animation creation process by simplifying your animation rig
	- fixes bugs in animation
	- an easy way to do what the rig doesn't allow
	- if the Rig is missing something,  add it without losing the animation
	- animate secondary motion,  physical detail and overlapping action.
	- Animate tails, wings, or any chain of bones
	- improve finished animations
	- change the Rig hierarchy as you want
	- polish hand-made animations and MoCap
	- interaction with objects and environment
	- interaction with another character
	- and many many others
Best way to use tool:
	1.	sketch out the animation.
	2.	the main thing is to get an overall good sketch of the movement.
	3.	Ignore the inaccuracies of animations
	4.	after that - use these tools to bring the animation to perfection
	
	
Full English guide (version 5.1)
	https://youtu.be/YlxmJX4KJm8
Addition to the guide (version 6.0)
	https://youtu.be/PgtqwtHpjiQ
Addition to the guide (version 7.0)
	https://youtu.be/ROzKEJINVo8
Addition to the guide (version 8.0)
	https://youtu.be/G0wAa64bqzs
Addition to the guide (version 8.5)
	https://youtu.be/KNKfm69PD_Y
Addition to the guide (version 9.0)
	https://youtu.be/maC_AewHlkY
Addition to the guide (version 9.3)
	https://youtu.be/Cs-f3oHejIM
Addition to the guide (version 10.2)
	https://youtu.be/UypsPk2xWU8
	
Полный гайд на русском языке (до версии 5.1)
	https://youtu.be/JMGCgaj5XPk
Дополнение к гайду (до версии 6.0) 
	https://youtu.be/uEfkFMgYoCg
Дополнение к гайду (до версии 7.0) 
	https://youtu.be/KxF1eVqD4u0
Дополнение к гайду (до версии 8.0) 
	https://youtu.be/Q9Ckzmzx2K0
Дополнение к гайду (до версии 8.5)
	https://youtu.be/KNKfm69PD_Y
Дополнение к гайду (до версии 9.0)
	https://youtu.be/POIm-dIL-YE
Дополнение к гайду (до версии 9.3)
	https://youtu.be/5UVy2UG74E0 
Дополнение к гайду (version 10.2)
	https://youtu.be/qvyjR_CsYy0
command list for hotkeys
	-----------------------------------------------------------------------------------------------------------------------
	overrig menue
		base_OverRig_scripts(1) - script menue (1,0 - color scheme)
	-----------------------------------------------------------------------------------------------------------------------
	change rotation order
		barn_execute_convert_rotation_order("xyz") - convert rotation order
	-----------------------------------------------------------------------------------------------------------------------
	smart object
		apply_smart_parentConstrAnim(1) - the animation will be baked on smart locator
		apply_smart_PivotParentAnimation(1.5) - the animation will be baked on smart Offset locator
		apply_smart_Knot_Orient_Point(1.5) - the animation will be baked on smart Orient locator
		apply_Smart_Bake(0) - the animation will be baked with this object keyframes
		apply_Smart_Bake(1) - the animation will be baked with this SMART KNOT keyframes
	-----------------------------------------------------------------------------------------------------------------------
	knot
		apply_Knot_Orient_Point(1) - create knot orient
		apply_PivotParentAnimation(1) - create pivot knot
		apply_parentConstrAnim(1) - create knot
	-----------------------------------------------------------------------------------------------------------------------
	parent
		apply_Parent_out() - parent to world
		apply_Parent_in() - parent inside	
		apply_Swap_parent()- swap parent
		apply_parent_anim_across(1) - create parent across KNOT

	-----------------------------------------------------------------------------------------------------------------------
	aim	
		make_aim_from_selected(1) - create aim
		bar_tail_overlap_window - overlapper window
		setKey_on_attach_attr(value) - set key on attach attr
		execute_overlap_command(int $chain, string $objects[], float $softness, float $lag,  0 , float $easing, int $cycle, int $abs_mode, int $save_pose) - execute overlap command
	-----------------------------------------------------------------------------------------------------------------------
	key tools
		Lag_Key(1.2) - lag key (frames)
		set_infinity_graphEditor("cycle") - set pre/post infinity ("cycle","oscillate", "linear", "constant")
		double_oscillate_keys(2) - oscillate period from timeslider
		copy_start_frame_to_end() - copy FIRST frame to LAST frame (need for cycling animations)
		set_start_end_key() - Set keys on FIRST and LAST frame
		set_key_time_range("all") - set the same keyframe on the allocated time range ("all", "translate", "rotate", "channelbox")
		selKeys_by_timerange() - select current keyframe or selected framerange
		delete_keys_from_selected_or_timeslider()  - delete selected frames on all channel all selected objects
		time_slider_range(24) - toggle timeslider range
		set_currenttime_to_mid_selection() - move time slider to mid selection position
		barn_copy_keys() - copy selected single animCurve frames
		barn_past_scaled_keys() - paste scaled to selected frames
		offset_keys_by_period(2) - shift keys by half period
		double_inv_oscillate_or_mirror(2, "x", "x") - if keys selected - set inverse mirror keys by X axis for translate and X axis for rotate. Or set 1/2 inverse oscillate by (x,x) form
		overRig_noise_window - open noise window
		tween 
			overRig_tween_window() - tween, overshoot or curve push menue
			bar_tween_machine(float $percent,`ls-sl`) - tween function. Examples:  bar_tween_machine(1,`ls-sl`) - 100% right side key bar_tween_machine(0,`ls-sl`) - 100% left side key 
	-----------------------------------------------------------------------------------------------------------------------
	selector
		return_constrained_object(1) - select an object that is constrained selected one
		barn_sel_set_member("OverRig_rig_objects") - select all rig source objects
		barn_sel_set_member("OverRig_knots") - select all Knots and setera
		barn_fast_bake_source_obj_and_delete_knots() - select all rig source objects, bake, and delete knot objects
	-----------------------------------------------------------------------------------------------------------------------
	double knots
		apply_DoubleUzelGlobal(1) - create double global knot
		apply_DoubleUzelLocal(1) - create double local knot
	-----------------------------------------------------------------------------------------------------------------------
	snapshot
		apply_LOH_Fast(1) - create object snapshot
		apply_LOH_Component(1) - create component snapshot
	-----------------------------------------------------------------------------------------------------------------------
	hyerarchy
		apply_ForwHierarhy(1) - create forward hyerarchy
		apply_ReverseHierarhy(1) - create reverse hyerarchy
		create_recalc_spine_rig_menue() - bake to easy vertebra system menue

	-----------------------------------------------------------------------------------------------------------------------
	IK,IK spline
		apply_rebike_3_or_more_object_to_IK - bake  3 or more FK to IK
		apply_objects_spline_IK(0) - bake 2 or more FK to spline IK
		apply_objects_spline_IK(1) - bake 2 or more FK to depend spline IK
		apply_bake_to_ribbon_system(int $num_ctrl, 0.3) - bake selected to ribbon system
	-----------------------------------------------------------------------------------------------------------------------
	bake	
		apply_Fast_Bake() - bake
		apply_range_Fast_Bake() - bake on min-max or selected framerange(save outside keys)
		apply_Bake_to_layer() - bake to layer
		apply_range_Bake_to_Over_layer()  bake on min-max or selected framerange to Override layer
		delete_constraint_attributes_on_objects(`ls-sl`) - delete Constraint channels from objects
		barn_fast_bake_min_max_or_range_source_obj_and_delete_knots() - select all rig source objects, bake min-max or selected framerange (save outside keys) , and delete knot objects
		euler_filter_on_selected()- fast euler filter from zero
		OVR_en_viewport() - enable viewport
	-----------------------------------------------------------------------------------------------------------------------
	sword tool
		BP_arc_tool_menue() - Open menue Arc Polish tool
		assign_Sword_pivot_System(1) -  assign Sword revers System
		assign_Sw_System -  assign Sword  System
	-----------------------------------------------------------------------------------------------------------------------
	simple physics
		assign_jiggle_bone_soft(1) - assign physical point on selected objects
		dyn_tail_tool_window() - physic chain menue
	-----------------------------------------------------------------------------------------------------------------------
	miscellaneus
		create_normalised_locators_on_selected() - create locators on selected
		mocup_parent_locators_inside()- create locator inside on selected
		small_DisplayColorOverrideUI() - color menue
		small_Shape_OverrideUI() - shape menue
		scale_selected_lock_or_joint(1.5) - local scale selected locator or joints
		move_and_rotate_total_pivot(0) - anim pivot (0 - last selected position , 1  - average,2 - first selected position, 3 - average, zero vertical position)
		bar_create_multiply_fast_motion_trail(int $start, int $end, int $static) - create fast Motion Trail
		apply_bar_isolate_selection_toggler(0) - current viewport isolate selected toggler 0 - toggler 1 - isolate hierarchy with geometry 2 - isolate selected with geometry
		bar_translate_toggler() - change translate tool Axis
		bar_rotate_toggler() - change rotate tool Axis
		bar_x_ray_toggler() - current viewport x-ray toggler 	
		finger tool
			brn_apply_finger_pivot_window()
			brn_apply_finger_bend_tool("bend") - finger tools - arguments "3IK" "4IK_var" "rot_piv" "twist"
	-----------------------------------------------------------------------------------------------------------------------
*/
global proc move_and_rotate_total_pivot(int $avg_point)
{
	undoInfo -ock -cn "move_and_rotate_total_pivot";
	global float $m_AIM_selectedTime[];
	global string $m_Piv_selection[];
	global string $m_Piv_locks[];
	global string $m_Piv_name_constraints[];
	global string $m_Piv_temp_gr_name;
	global string $m_Piv_groups[];
	global int $m_Piv_mode;
	string $axis;
	$m_Piv_mode=0;
	$m_AIM_selectedTime=BOVER_10_2_dfc2513778a513e560ec81c8f3df6563();
	if(($m_AIM_selectedTime[0]!=$m_AIM_selectedTime[1]-1)||(size($m_Piv_selection)>1))
		$m_Piv_mode=1;
	$m_Piv_selection=`ls-sl`;
	vector $average_point=BOVER_10_2_e3bea614176fbceebe7c7aae67e953b0(BOVER_10_2_72356eaf232b169651a82383ba9e7e57($m_Piv_selection));
	if ($avg_point==0)
		select $m_Piv_selection[size($m_Piv_selection)-1];
	if ($avg_point!=0)
		select $m_Piv_selection[0];
	$m_Piv_locks = BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
	if ($avg_point==1)
	{
		move -a -ws ($average_point.x) ($average_point.y) ($average_point.z) $m_Piv_locks[0];
		rotate -ws 0 0 0 $m_Piv_locks[0];
	}
	if ($avg_point==3)
	{
		$axis=`upAxis -q -ax`;
		if ($axis=="z")
			move -a -ws ($average_point.x) ($average_point.y) 0 $m_Piv_locks[0];
		else
			move -a -ws ($average_point.x) 0 ($average_point.z) $m_Piv_locks[0];
		rotate -ws 0 0 0 $m_Piv_locks[0];
	}
	if ($avg_point==4)
	{
		move -a -ws 0 0 0 $m_Piv_locks[0];
		rotate -ws 0 0 0 $m_Piv_locks[0];
	}
	scriptJob -ro 1 -cf "SomethingSelected" "BOVER_10_2_2082990dda026469945596942b8ed225";
	inViewMessage -smg "move pivot in place and deselect" -pos topRight -bkc 0x00000000 -fade  -dk  ;
	manipMoveContext -edit -mode 0 Move;
	setToolTo moveSuperContext;
}
