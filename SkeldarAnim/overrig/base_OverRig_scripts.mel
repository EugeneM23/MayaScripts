	select -r ($crve_name + ".cv[1:2]") ;
	string $cluster_name[]=`newCluster " -envelope 1"`;
	BOVER_10_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
	string  $group_lock_name[]=BOVER_10_2_910f54508e7e0e76ffe92926566add2d();
