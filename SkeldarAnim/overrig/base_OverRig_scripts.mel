global proc string[] BOVER_10_2_32a3829df17c3736d9757e423eeaf0e3 (string $target[], string $object[])
{
    if(size($target)!=size($object))
		warning "size parent massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target)> size($object))
		$target=`ls -head (size($object)) $target`;
    string $curr_objs[];
    string $fin_objs[];
	string $uid_objs[]=`ls -uuid $object`;
	string $uid_targts[]=`ls -uuid $target`;
    for($i=0;$i<size($target);$i++)
    {
        $curr_objs=`ls -uuid {$uid_objs[$i],$uid_targts[$i]}`;
        catchQuiet (`parent $curr_objs[0] $curr_objs[1]`);
    }
    $fin_objs=`ls -uuid $uid_objs`;
	select -cl;
	select $fin_objs;
	return $fin_objs;
}
global proc string[] create_normalised_locators_on_selected()
{
    string $selection[]=`ls-fl-os`;
    string $lock[]=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
    for($i=0;$i<size($selection);$i++)
        if(!((`objectType -isType "mesh" $selection[$i]`)+(`objectType -isType "nurbsSurface" $selection[$i]`)+(`objectType -isType "nurbsCurve" $selection[$i]`)+(`objectType -isType "lattice" $selection[$i]`)))
            delete `orientConstraint $selection[$i] $lock[$i]`;
    return $lock;
}
global proc scale_selected_lock_or_joint( float $scale_on)
{
    string $shape_name[];
    float $num;
    for($obj in `ls-sl`)
    {
        $shape_name=BOVER_10_2_5e702211108f11813c411c94f8b1b380($obj);
        if(`attributeQuery -node $shape_name[0] -ex localScaleX`)
        {
            $num=`getAttr ($shape_name[0] + ".localScaleX")`;
            catchQuiet( `setAttr ($shape_name[0] + ".localScaleX") ($num*$scale_on)` );
            $num=`getAttr ($shape_name[0] + ".localScaleY")`;
            catchQuiet( `setAttr ($shape_name[0] + ".localScaleY") ($num*$scale_on)` );
            $num=`getAttr ($shape_name[0] + ".localScaleZ")`;
            catchQuiet( `setAttr ($shape_name[0] + ".localScaleZ") ($num*$scale_on)` );
        }
        if(`attributeQuery -node $shape_name[0] -ex radius`)
        {
            $num=`getAttr ($shape_name[0] + ".radius")`;
            catchQuiet( `setAttr ($shape_name[0] + ".radius") ($num*$scale_on)` );
        }
    }
}
global proc BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(int $color)
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	for($i=0;$i<size($objs);$i++)
	{
		catchQuiet(`setAttr ($objs[$i] + ".overrideEnabled") 1`);
		catchQuiet(`setAttr -lock false ($objs[$i] + ".overrideColor") $color`);
	}
}
global proc BOVER_10_2_4c2952dd9f486573856c8eb6a0dc46ac(int $vis)
{
	string $objs[] = `ls-sl`;
	if(!size($objs))
		return;
	string $obj;
	for($obj in $objs)
	{
		if (!`getAttr -lock ($obj + ".v")`)
			setAttr ($obj + ".v") $vis;
	}
}
global proc string [] BOVER_10_2_ac2021d0d7ff3ecfad4dbca9f9f88248(string $target_massiv[], string $object_massiv[])
{
	string $name_of_constrain[];
	string $tmp[];
	for($i=0;$i<size($target_massiv);$i++)
		{
			$rx_lock=`getAttr -lock ($object_massiv[$i] + ".rx")`;
			$ry_lock=`getAttr -lock ($object_massiv[$i] + ".ry")`;
			$rz_lock=`getAttr -lock ($object_massiv[$i] + ".rz")`;
			$h=$rx_lock+$ry_lock+$rz_lock;
			if ($h<3)
			{
				$skipX= "";
				$skipY= "";
				$skipZ= "";
				if($rx_lock)
					$skipX= " -skip x";
				if($ry_lock)
					$skipY= " -skip y";
				if($rz_lock)
					$skipZ= " -skip z";
				$skipped = $skipX + $skipY + $skipZ;
				$tmp=`eval ("orientConstraint  " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
				$name_of_constrain[$i]=$tmp[0];
			}
	}
	return $name_of_constrain;
}
global proc float[] BOVER_10_2_8598296823aa3af15686cb0d78f1615d(string $selection)
{
    float $objPosition[];
    float $getPvPos[];
    float $Rot[];
    string $buffer[];
    string $e_f_result[];
    vector $coords[];
    vector $coo;
    int $num;
    string $points[]=`filterExpand -sm 28  -sm 30 -sm 31 -sm 35  -sm 36-sm 39-sm 40-sm 41-sm 42 -sm 46-sm 47-sm 70 -sm 73 $selection`;
	string $edges[]=`filterExpand -sm 32 -sm 37 $selection`;
	string $poly[]=`filterExpand -sm 34 -sm 38 -sm 72 $selection`;
	string $objname=`match "^[^\.]*" $selection`;
	if(size ($points)>0)
	{
		$getPvPos=`pointPosition -world $selection`;
		$objPosition={$getPvPos[0],$getPvPos[1],$getPvPos[2],0,0,0};
	}
	else if(size ($edges)>0)
	{
		$e_f_result=`polyInfo -ev $selection`;
		$num=`tokenize  $e_f_result[0] " " $buffer`;
		$j=0;
		for($i=2;$i<$num-1;$i++)
		{
			$getPvPos=`pointPosition -world ($objname + ".vtx[" + $buffer[$i] + "]")`;
			$coords[$j]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
			$j++;
		}
		$coo=BOVER_10_2_e3bea614176fbceebe7c7aae67e953b0($coords);
		$objPosition={$coo.x,$coo.y,$coo.z,0,0,0};
	}
	else if(size ($poly)>0)
    {
        $e_f_result=`polyInfo -fv $selection`;
        tokenize  $e_f_result[0] " " $buffer;
        $j=0;
        for($i=2;$i<size($buffer)-1;$i++)
        {
            $getPvPos=`pointPosition -world ($objname + ".vtx[" + $buffer[$i] + "]")`;
            $coords[$j]=<<$getPvPos[0],$getPvPos[1],$getPvPos[2]>>;
            $j++;
        }
        $coo=BOVER_10_2_e3bea614176fbceebe7c7aae67e953b0($coords);
        $objPosition={$coo.x,$coo.y,$coo.z,0,0,0};
    }
	else
	{
		$getPvPos = `xform -q -ws -piv $selection `;
		$Rot= `xform -q -ro -ws $selection`;
		$objPosition={$getPvPos[0],$getPvPos[1],$getPvPos[2],$Rot[0],$Rot[1],$Rot[2]};
	}
	return $objPosition;
}
global proc string[] BOVER_10_2_17431451b1be026fdeee93b86579c6b6(string $target_massiv[], string $object_massiv[])
{
	string $name_constrain[],$tmp_constrain[];
	string $skipTX,$skipTY,$skipTZ,$skipRX,$skipRY,$skipRZ;
	string $delChannelTX,$delChannelTY,$delChannelTZ,$delChannelRX,$delChannelRY,$delChannelRZ;
	int $rx_lock,$ry_lock,$rz_lock,$tx_lock,$ty_lock,$tz_lock;
	if(size($target_massiv)!=size($object_massiv))
		warning "size smart_parent constraints massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target_massiv)> size($object_massiv))
		$target_massiv=`ls -head (size($object_massiv)) $target_massiv`;
	for($i=0;$i<size($target_massiv);$i++)
	{
		$rx_lock=`getAttr -lock ($object_massiv[$i] + ".rx")`;
		$ry_lock=`getAttr -lock ($object_massiv[$i] + ".ry")`;
		$rz_lock=`getAttr -lock ($object_massiv[$i] + ".rz")`;
		$tx_lock=`getAttr -lock ($object_massiv[$i] + ".tx")`;
		$ty_lock=`getAttr -lock ($object_massiv[$i] + ".ty")`;
		$tz_lock=`getAttr -lock ($object_massiv[$i] + ".tz")`;
		$h=$rx_lock+$ry_lock+$rz_lock+$tx_lock+$ty_lock+$tz_lock;
		if ($h<6)
		{
			$skipTX= "";
			$skipTY= "";
			$skipTZ= "";
			$skipRX= "";
			$skipRY= "";
			$skipRZ= "";
			$delChannelTX = "";
			$delChannelTY = "";
			$delChannelTZ = "";
			$delChannelRX = "";
			$delChannelRY = "";
			$delChannelRZ = "";
			if($tx_lock)
				$skipTX= " -st x";
			else
				$delChannelTX =" -at \"tx\"";
			if($ty_lock)
				$skipTY= " -st y";
			else
				$delChannelTY =" -at \"ty\"";
			if($tz_lock)
				$skipTZ= " -st z";
			else
				$delChannelTZ =" -at \"tz\"";
			if($rx_lock)
				$skipRX= " -sr x";
			else
				$delChannelRX =" -at \"rx\"";
			if($ry_lock)
				$skipRY= " -sr y";
			else
				$delChannelRY =" -at \"ry\"";
			if($rz_lock)
				$skipRZ= " -sr z";
			else
				$delChannelRZ =" -at \"rz\"";
			$skipped = $skipTX + $skipTY + $skipTZ + $skipRX + $skipRY + $skipRZ;
			if($target_massiv[$i]!="")
				$tmp_constrain=`eval ("parentConstraint -mo " + $skipped + " " + $target_massiv[$i] + " " + $object_massiv[$i])`;
			$name_constrain[$i]=$tmp_constrain[0];
		}
	}
	return $name_constrain;
}
global proc string BOVER_10_2_3ed0416e2547f09f133c132ecd5ccd97()
{
	string $obj[]=`ls-sl`;
	int $num_obj=size($obj);
	string $ret_name;
	string $name_of_constrain[];
	$weight_all=BOVER_10_2_9de233870ac6b9c5087a491c3b4ca38a($obj);
	$rx_lock=`getAttr -lock ($obj[$num_obj-1] + ".rx")`;
	$ry_lock=`getAttr -lock ($obj[$num_obj-1] + ".ry")`;
	$rz_lock=`getAttr -lock ($obj[$num_obj-1] + ".rz")`;
	$tx_lock=`getAttr -lock ($obj[$num_obj-1] + ".tx")`;
	$ty_lock=`getAttr -lock ($obj[$num_obj-1] + ".ty")`;
	$tz_lock=`getAttr -lock ($obj[$num_obj-1] + ".tz")`;
	$h=$rx_lock+$ry_lock+$rz_lock+$tx_lock+$ty_lock+$tz_lock;
	if ($h<6)
	{
		$skipTX= "";
		$skipTY= "";
		$skipTZ= "";
		$skipRX= "";
		$skipRY= "";
		$skipRZ= "";
		if($tx_lock)
			$skipTX= " -st x";
		if($ty_lock)
			$skipTY= " -st y";
		if($tz_lock)
			$skipTZ= " -st z";
		if($rx_lock)
			$skipRX= " -sr x";
		if($ry_lock)
			$skipRY= " -sr y";
		if($rz_lock)
			$skipRZ= " -sr z";
		$skipped = $skipTX + $skipTY + $skipTZ + $skipRX + $skipRY + $skipRZ;
		string $objects = "";
		for($i=0;$i<$num_obj;$i++)
		{
			$objects = $objects + $obj[$i] + " ";
		}
		$name_of_constrain=`eval ("parentConstraint -mo " + $skipped + " " + $objects)`;
		for($i=0;$i<($num_obj-1);$i++)
		{
			$attr_name=`listAttr -string ("*W" + $i) $name_of_constrain[0]`;
			catch (`setAttr ($name_of_constrain[0] + "." +  $attr_name[0]) $weight_all[$i]`);
		}
	}
		$ret_name=$name_of_constrain[0];
		return $ret_name;
}
global proc BOVER_10_2_e02b9af8de573969d2834f5d4e4228fd(float $min, float $max, string $objects[])
{
	$mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2016)
    {
        $eval_mode=`evaluationManager -q -mode`;
		if($eval_mode[0]!="off")
			evaluationManager -mode "off";
    }
    catchQuiet(`selectKey -clear`);
	$its_baked=catchQuiet (`bakeResults -sm 1 -s false -t  ($min + ":" + $max) $objects`);
    if ($mayaVersion>=2016)
    {
		if($eval_mode[0]!="off")
			evaluationManager -mode $eval_mode[0];
    }
    if($its_baked)
    {
        warning "select something!";
    }
}
global proc BOVER_10_2_d1b73d0512bac8d20998bdbab9b3aed7(string $target[], string $object[])
{
	int $ro;
	for($i=0;$i<size($target);$i++)
	{
		$ro=`getAttr($target[$i] + ".rotateOrder")`;
		setAttr ($object[$i] + ".rotateOrder")$ro;
	}
}
global proc BOVER_10_2_5e8af8371c687e5c50d7ded5040ffe13(string $target_position[], string $object_to_move[])
{
	float $Trans[];
	float $Rot[];
	for($i=0;$i<size($target_position);$i++)
	{
        $Trans=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($target_position[$i]);
        $Rot={$Trans[3],$Trans[4],$Trans[5]};
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		rotate -ws $Rot[0] $Rot[1] $Rot[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
	}
}
global proc BOVER_10_2_9a3ce25cfdbc96f0053e2e03715d7f2b()
{
	string $objs[] = `ls-sl`;
	for($obj in $objs)
	{
		if(!`getAttr -lock ($obj + ".rx") `)
			setAttr ($obj + ".rx") 0;
		if(!`getAttr  -lock ($obj + ".ry") `)
			setAttr ($obj + ".ry") 0;
		if(!`getAttr  -lock ($obj + ".rz")`)
			setAttr ($obj + ".rz") 0;
	}
}
global proc euler_filter_on_selected()
{
	string $selected[]= `ls -sl`;
	if(size($selected)==0)
	{
		warning "select something!!!!";
		return;
	}
    string $bad_objects[]=BOVER_10_2_ca2b71d55555ad7b622720fafe195d7c($selected);
	float $statTime[] = `keyframe -index 0 -q -tc $bad_objects`;
	float $null_frame = $statTime[0] - 10;
	catchQuiet(`setKeyframe -v 0 -t $null_frame $bad_objects`) ;
	filterCurve $bad_objects;
	selectKey -clear;
	catchQuiet(`cutKey -t $null_frame  $bad_objects`);
	selectKey -clear;
}
global proc string[] BOVER_10_2_ca2b71d55555ad7b622720fafe195d7c(string $objects[])
{
    float $porog=89;
    string $problemObject[];
    string $axes[] = {"X", "Y", "Z"};
    float $diff;
    float $values[];
    float $sorted[];
    int $num;
    string $attr;
    float $keys[];
    int $need_euler=0;
    for($object in $objects)
    {
       $need_euler=0;
        for ($axis in $axes)
            if ($need_euler==0)
            {
                $attr = $object + ".rotate" + $axis;
				if( objExists($attr) )
				{
        			$values = `keyframe -query -valueChange $attr`;
                    if(size($values)>0&& $need_euler==0)
                    {
                          for ($i = 1; $i < size($values); $i++)
                                if (abs($values[$i] - $values[$i-1]) > $porog  )
                                {
                                    $problemObject[`size($problemObject)`] = $object;
                                    $need_euler=1;
                                    break;
                                }
                    }
				}
			}
    }
        print ("eulered  " + (size($problemObject)) + "  from  " + (size($objects)) + " object;\n");
        return $problemObject;
}
global proc string[] BOVER_10_2_5e702211108f11813c411c94f8b1b380( string $transfrm )
{
   string $shapes[];
   $shapes[0] = $transfrm;
   if ( "transform" == `nodeType $transfrm` )
		$shapes = `listRelatives -f -shapes $transfrm`;
   return $shapes;
}
global proc string[] return_constrained_object(int $select)
{
    string $p_nodes[], $connection[], $tmpeps[], $obj,$const,$connect;
    string $constraints[]={"parentConstraint","orientConstraint","pointConstraint","aimConstraint"};
    string $selected[]=`ls-l-sl`;
	if(size($selected)==0)
	{
		warning "select KNOT or AIM locator";
		return {};
	}
	for($obj in  $selected)
        for($const in $constraints)
            appendStringArray($connection, ($tmpeps=`listConnections  -type $const $obj`),size( $tmpeps));
    $connection= stringArrayRemoveDuplicates($connection);
    for ($connect in $connection)
        appendStringArray($p_nodes,`listRelatives -f -p $connect `,1);
    $p_nodes= stringArrayRemoveDuplicates($p_nodes);
    if($select)
        select $p_nodes;
    return $p_nodes;
}
global proc string find(string $procedure)
{
	string $path= `whatIs($procedure)`;
	string $fullPath=`substring $path 25 999`;
	system("load " + $fullPath);
	return $fullPath;
}
global proc delete_constraint_attributes_on_objects(string $objects[])
{
    string $attr[],$obj,$att;
    for($obj in $objects)
    {
        $attr=`listAttr -r -st "blendParent*" -st "blendOrient*" -st "blendPoint*" -st "blendAim*" -st "MaxHandle*" $obj `;
        for($att in $attr)
        {
            cutKey -cl -t ":" -f ":" -at $att $obj;
            catch (`deleteAttr -attribute $att $obj`);
        }
    }
}
global proc bar_x_ray_toggler()
{
    $currentPanel = `getPanel -withFocus`;
    string $panelType = `getPanel -to $currentPanel`;
    if ($panelType == "modelPanel")
        modelEditor -e -xray ( !`modelEditor -q -xray $currentPanel` ) $currentPanel;
}
global proc bar_rotate_toggler()
{
     if (`currentCtx` == "RotateSuperContext")
     {
		global int $rotate_order;
		$rotate_order++;
		if($rotate_order==1)
			inViewMessage -smg "global rotate" -pos topRight -bkc 0x00000000 -fade -fst 10 ;
		if($rotate_order==2)
			inViewMessage -smg "gimbal rotate" -pos topRight -bkc 0x00000000 -fade -fst 10;
		if($rotate_order==3)
		{
			inViewMessage -smg "local rotate" -pos topRight -bkc 0x00000000 -fade -fst 10 ;
			$rotate_order=0;
		}
		manipRotateContext -e -ah 3 -mode $rotate_order Rotate;
    }
    else
        setToolTo RotateSuperContext;
}
global proc bar_translate_toggler()
{
     if (`currentCtx` == "moveSuperContext")
     {
        global int  $translate_order;
        $translate_order++;
        if($translate_order==1)
            inViewMessage -smg "local translate" -pos topRight -bkc 0x00000000 -fade -fst 10;
        if($translate_order==2)
            inViewMessage -smg "global translate" -pos topRight -bkc 0x00000000 -fade -fst 10;
        if($translate_order==3)
        {
            inViewMessage -smg "object translate" -pos topRight -bkc 0x00000000 -fade -fst 10;
            $translate_order=0;
        }
        manipMoveContext -edit -mode $translate_order Move;
    }
    else
        setToolTo moveSuperContext;
}
global proc small_Shape_OverrideUI()
{
	global string $g_bar_shape_window_name;
	$g_bar_shape_window_name = "shape_OverrideUI";
	if (`window -exists $g_bar_shape_window_name`)
		deleteUI  $g_bar_shape_window_name;
	$mainWindoww = `window -title "overrig shape Override"
						  -rtf 1
						  -tb 0
						  -sizeable 0
						  -w 200
						  -h 50
						  $g_bar_shape_window_name`;
	columnLayout -p $mainWindoww  -adj 1  "shape";
		button -ann "change to circle selected (if locator - depend local scale)" -l "circle"  -c "BOVER_10_2_74b3586ec5f33152020ca1d5764043c3(); deleteUI  $g_bar_shape_window_name";
		button -ann "change to square selected (if locator - depend local scale)" -l "square"  -c "BOVER_10_2_2973884331c16c616ab40f590c680aa4(); deleteUI  $g_bar_shape_window_name";
		button -ann "change to sphere selected " -l "sphere"  -c "BOVER_10_2_7b3fcad445e0b73cf535b7be3635a572(); deleteUI  $g_bar_shape_window_name";
		button -ann "change to cross selected (if locator - depend local scale)" -l "cross"  -c "BOVER_10_2_e654812187805dfb8c3722d661c85115(); deleteUI  $g_bar_shape_window_name";
		button -ann "change to cube selected (if locator - depend local scale)" -l "cube"  -c "BOVER_10_2_5376d05a6d1db3d89784283c8192d70e(); deleteUI  $g_bar_shape_window_name";
	rowLayout -p $mainWindoww -numberOfColumns 4 ;
		button -w 50 -ann "reset display size (nurbs curve only)" -l "X"  -c "BOVER_10_2_19c8ef40419bea353742fe791e238558(`ls-sl`,0); deleteUI  $g_bar_shape_window_name";
		button -w 50 -ann "change display size to 2 (nurbs curve only)" -l "2"  -c "BOVER_10_2_19c8ef40419bea353742fe791e238558(`ls-sl`,2); deleteUI  $g_bar_shape_window_name";
		button -w 50 -ann "change display size to 3 (nurbs curve only)" -l "3"  -c "BOVER_10_2_19c8ef40419bea353742fe791e238558(`ls-sl`,3); deleteUI  $g_bar_shape_window_name";
        button -w 50 -ann "change display size to 4 (nurbs curve only)" -l "4"  -c "BOVER_10_2_19c8ef40419bea353742fe791e238558(`ls-sl`,4); deleteUI  $g_bar_shape_window_name";
	showWindow $mainWindoww;
}
global proc vector[] BOVER_10_2_72356eaf232b169651a82383ba9e7e57(string $objects[])
{
    vector $vec_pos[];
    $i=0;
	float $pos[];
   for($obj in $objects)
   {
       $pos=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($obj);
       $vec_pos[$i]=<<$pos[0],$pos[1],$pos[2]>>;
       $i++;
   }
   return $vec_pos;
}
global proc vector BOVER_10_2_e3bea614176fbceebe7c7aae67e953b0(vector $coords[])
{
	int $num = `size $coords`;
	vector $ff;
	for ($each in $coords)
	    $ff+=$each;
	$ff=($ff/$num);
	return $ff;
}
global proc make_aim_from_selected(float $size_lock)
{
	if(size(`ls-sl`)==0)
	{
		print "\n select something!!!!\n";
		return;
	}
	global string $BARN_curve_sword_remember_SOURCE[];
	clear $BARN_curve_sword_remember_SOURCE;
	global string $BARN_curve_sword_remember_AIM_TOP[];
	clear	$BARN_curve_sword_remember_AIM_TOP;
	global string $BARN_curve_sword_remember_AIM_SIDE[];
	clear $BARN_curve_sword_remember_AIM_SIDE;
	global string $BARN_curve_sword_remember_BASE_SYSTEM[];
	clear	$BARN_curve_sword_remember_BASE_SYSTEM;
	global string $BARN_curve_sword_remember_DELETE_AFTER_BAKE[];
	clear	$BARN_curve_sword_remember_DELETE_AFTER_BAKE;
	$BARN_curve_sword_remember_SOURCE=`ls-sl`;
	BOVER_10_2_4b209c5c00abddc3e3509a14326e2488($BARN_curve_sword_remember_SOURCE,"OverRig_rig_objects");
    manipMoveContext -edit -mode 0 Move;
    setToolTo moveSuperContext;
    string $aims[]=BOVER_10_2_c642429ed9a3aabf65a66eefcd97bfbb();
	BOVER_10_2_2e50fb684e35f7dc58ab390d98530944({0.45, 0.7, 0.45});
    $selected=`ls-sl`;
    select $aims;
    BOVER_10_2_6de8028af587b467034457b4d6349f89($size_lock);
    select -cl;
    select $selected;
    $BARN_curve_sword_remember_AIM_TOP=`ls -head(size($aims)/2) $aims`;
    $BARN_curve_sword_remember_AIM_SIDE=`ls -tail(size($aims)/2) $aims`;
	BOVER_10_2_4b209c5c00abddc3e3509a14326e2488($BARN_curve_sword_remember_AIM_TOP,"OverRig_knots");
	BOVER_10_2_4b209c5c00abddc3e3509a14326e2488($BARN_curve_sword_remember_AIM_SIDE,"OverRig_knots");
    $BARN_curve_sword_remember_DELETE_AFTER_BAKE=$aims;
    scriptJob -ro 1 -cf "SomethingSelected" " BOVER_10_2_692e2fda85cadfdf0f28e93323f58c08; BOVER_10_2_10df34add5a583f84d24608e860c1b4b() ; BOVER_10_2_f4b1a2b52ab1771321003f86cde63160;";
}
global proc  assign_Sw_System()
{
    manipMoveContext -edit -mode 0 Move;
    setToolTo moveSuperContext;
	global string $BARN_curve_sword_remember_SOURCE[];
	clear $BARN_curve_sword_remember_SOURCE;
	global string $BARN_curve_sword_remember_AIM_TOP[];
	clear	$BARN_curve_sword_remember_AIM_TOP;
	global string $BARN_curve_sword_remember_AIM_SIDE[];
	clear $BARN_curve_sword_remember_AIM_SIDE;
