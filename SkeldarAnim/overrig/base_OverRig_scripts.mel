    int $cant_getTransform;
    for($obj in $selected)
    {
        $cant_getTransform=catchQuiet(`xform -q -ws -piv $obj`);
        if(!$cant_getTransform)
            appendStringArray($fin_transform_obj,{$obj},1);
    }
    return $fin_transform_obj;
}
