global proc BOVER_10_2_490477b48ee9660621e3a742802144b2(int $hierarchy, int $preBake, int $include_last, int $new_nucleus)
{
	string $selection[]=`ls-fl-sl`;
	string $object_type,$clth_j[];
	if($hierarchy)
	{
		$selection=BOVER_10_2_4444d6118d676b89ef3372a0f3254e9f($selection);
		for($obj in $selection)
    	{
    		select -cl;
    		select $obj;
    		$object_type = BOVER_10_2_c884f4200431a153fb44b960cecbef34($obj);
    		select -hi;
    		$clth_j=BOVER_10_2_1ed150b12535ee196bee8b74a6bf5f5c(`ls-sl`, $object_type);
			select -cl;
			select $clth_j;
			if(size($clth_j)>=2)
				catch(BOVER_10_2_b1a6041ba2fdb9cd94c7315ed4ffdd35( $preBake,  $include_last, $new_nucleus));
			else
			{
				warning "chain size <2";
				return;
			}
			if($new_nucleus==1)
				$new_nucleus=0;
    	}
	}
    else
		if(size($selection)>=2)
				catch(BOVER_10_2_b1a6041ba2fdb9cd94c7315ed4ffdd35( $preBake,  $include_last, $new_nucleus));
		else
		{
			warning "chain size <2";
			return;
		}
}
global proc string BOVER_10_2_1047fab2337f966993f8490eba14a3e9()
{
    global string $gActiveNucleusNode;
    string $selected[]=`ls-sl`;
    string $nucleus[];
    for($obj in $selected)
        if(`objectType $obj`== "nucleus")
            $nucleus[size($nucleus)]=$obj;
    if(size($nucleus)>0)
        $gActiveNucleusNode=$selected[0];
    print ("\n current Nucleus node = " + $gActiveNucleusNode );
    return  $gActiveNucleusNode;
}
global proc BOVER_10_2_b58335033e0b7c5ed2c070e8f7d06eb8()
{
    string $selected[]=`ls-type nucleus-sl`;
    string $axis=`upAxis -q -axis`;
    string $start_expr;
    global string $gActiveNucleusNode;
    if (size($selected)==0)
        $selected[0]=$gActiveNucleusNode;
    string $gravity_ctrl[];
    float $scale;
	float $min_frame;
	float $time_scale_curr;
    for($s in $selected)
    {
        $scale = BOVER_10_2_92215d442ec8600b7dd12365e6b3d7f0({$s},1);
        $gravity_ctrl[1]= BOVER_10_2_902ba8d3934f616530e335e4c6433f01("time", "Arial", $scale, "center");
		$gravity_ctrl[1]=`rename $gravity_ctrl[1] ("timeCtrl_" + $s)`;
        BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(10);
		addAttr -ln "start_time"  -at long  -dv 0  $gravity_ctrl[1];
		$min_frame=getAttr ($s + ".startFrame");
		$time_scale_curr=getAttr ($s + ".timeScale");
	    setAttr -e -keyable 0 -channelBox true ($gravity_ctrl[1] + ".start_time") $min_frame;
		addAttr -ln "time_scale"  -at double  -min 0 -max 10 $gravity_ctrl[1];
	    setAttr -e -keyable 0 -channelBox true ($gravity_ctrl[1] + ".time_scale") 1;
		$start_expr=`expression `;
		expression -e -s "$currTime=.I[0];\n$startTime=.I[1];\n$curr_startTime=$startTime;\nif($currTime<$startTime)\n\t$curr_startTime=$currTime;\nelse\n\t$curr_startTime=$startTime;\n.O[0]=$curr_startTime;"  -o "" -ae 1 -uc all $start_expr;
		connectAttr -f time1.outTime ($start_expr + ".input[0]");
		connectAttr -f ($gravity_ctrl[1] + ".start_time") ($start_expr + ".input[1]");
		connectAttr -f ($start_expr + ".output[0]") ($s +  ".startFrame");
        connectAttr -f ($gravity_ctrl[1] + ".time_scale") ($s +  ".timeScale");
    }
	BOVER_10_2_4b209c5c00abddc3e3509a14326e2488({$gravity_ctrl[1]},"OverRig_dynamic_system");
}
