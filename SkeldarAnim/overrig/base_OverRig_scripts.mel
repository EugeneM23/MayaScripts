	BOVER_10_2_15760bd5ac6225f582185bab24346a67(1);
	string $top_tmp_aim=BOVER_10_2_f9ccf45626df05475e8ab66b6f511dd6($objects);
	string $lock_tmp_aim[]=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
	delete (`pointConstraint  $objects[0]  $objects[size( $objects)-1] $lock_tmp_aim[0]`);
	delete(`aimConstraint -offset 0 0 0 -weight 1 -aimVector 0 1 0 -upVector 1 0 0 -worldUpType "object" -worldUpObject   $top_tmp_aim  $objects[0]  $lock_tmp_aim[0]`);
	delete(`orientConstraint  $lock_tmp_aim[0] $group_lock_name[0]`);
	delete $lock_tmp_aim;
	parentConstraint -mo  $drow_joint[0] $cluster_name[1];
	select -r ($crve_name + ".cv[0]") ;
	select -add ($crve_name + ".cv[3]") ;
	string $scaling_cluster_name[]=`newCluster " -envelope 1"`;
	float $Trans[] = `xform -q -ws -piv $objects[0]`;
