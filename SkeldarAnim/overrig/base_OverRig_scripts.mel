					-ebg true
					-l "1/8"
					b1_8;
			button -ann "1/4 oscillate period from timeslider"
					-c "double_oscillate_keys(4)"
					-w ($wt_small+3) -h $height_small
					-ebg true
					-l "1/4"
					b1_4;
			button -ann "1/2 oscillate period from timeslider (most useful)"
					-c "double_oscillate_keys(2)"
					-w ($wt_small+3) -h $height_small
					-ebg true
					-l "1/2"
					b1_2;
		 $height_small=15;
		rowLayout -p "keytool_BOR_clmn_lay_ui" -ebg true -nc 7 -adj 5;
			button -ann " shifts the keys of selected objects 1 frame to the LEFT (can work with selected keys as well)"
					-c "keyframe -e -iub true -r -o over -tc -1;"
					-w 20 -h $height_small
					-l "<1"
					b_mm1;
			button -ann " shifts the keys of selected objects 0.1 frame to the LEFT (can work with selected keys as well)"
					-c "keyframe -e -iub true -r -o over -tc -0.1;"
					-w 28 -h $height_small
					-l "<0.1"
					b_m0_1;
			button -ann " shifts the keys of selected objects 0.1 frame to the RIGHT (can work with selected keys as well)"
					-c "keyframe -e -iub true -r -o over -tc 0.1;"
					-w 28 -h $height_small
					-l "0.1>" -rs true
					bb0_1;
			button -ann " shifts the keys of selected objects 1 frame to the RIGHT (can work with selected keys as well)"
				-c "keyframe -e -iub true -r -o over -tc 1;"
				-w 20 -h $height_small
				-l "1>" bb1;
		text "";
			button -ann " copy FIRST frame to LAST frame (need for cycling animations)"
					-c "copy_start_frame_to_end"
					-w 50 -h $height_small
					-l "F>E cpy"
					bF_E_cpy;
			button -ann " copy selected frames from single animCurve"
 				-c "barn_copy_keys"
					-w 22 -h $height_small
					-l "C"
					bC;
		rowLayout -p "keytool_BOR_clmn_lay_ui" -ebg true -nc 7 -adj 5;
			button -ann "SEQUENTALLY shifts the keys of selected objects 1 frame to the LEFT (can work with selected keys as well)"
 				-c "Lag_Key(-1)"
					-w 20 -h $height_small
-bgc 0.7 0.755 0.780
					-l "<1"
					bm_1;
			button -ann "SEQUENTALLY shifts the keys of selected objects 0.1 frame to the LEFT (can work with selected keys as well)"
 				-c "Lag_Key(-0.1)"
					-w 28 -h $height_small
-bgc 0.7 0.755 0.780
					-l "<0.1"
					bm0_1;
			button -ann "SEQUENTALLY shifts the keys of selected objects 0.1 frame to the RIGHT (can work with selected keys as well)"
 				-c "Lag_Key(0.1)"
					-w 28 -h $height_small
-bgc 0.7 0.755 0.780
					-l "0.1>" -rs true
					bbb0_1;
			button -ann "SEQUENTALLY shifts the keys of selected objects 1 frame to the RIGHT (can work with selected keys as well)"
					-c "Lag_Key(1)"
					-w 20 -h $height_small
	-bgc 0.7 0.755 0.780
					-l "1>"
					bbb_1;
			text "";
			button -ann " Set keys on FIRST and LAST frame "
					-c "set_start_end_key"
					-w 50 -h $height_small
					-l "F E set"
					bF_E_set;
			button -ann " past frame in selected range "
					-c "barn_past_scaled_keys"
					-w 22 -h $height_small
					-l "P"
					bP;
rowLayout  -p "keytool_BOR_clmn_lay_ui"   -nc 7 -adj 4     keytool_BOR_ax_inv_row2_lay_ui;
			button -ann "shift keys by half period"
					-c "offset_keys_by_period(2)"
