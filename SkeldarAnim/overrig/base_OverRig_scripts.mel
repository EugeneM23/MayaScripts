global proc string[] BOVER_10_2_bff1d3bd6ddd4f77c5d79c1d7ef0c8b1(float $radius)
{
	$selection = `ls -fl -sl `;
	string $curve_sphere[];
	if(size($selection)>0)
	{
		for($i=0;$i<size($selection);$i++)
		{
			$curve_sphere[$i]=BOVER_10_2_c31045748f3c557589184e51283ed2cd($radius);
		}
		BOVER_10_2_847308ac6f1debf8edcc8d63e128d64c( $selection, $curve_sphere);
		BOVER_10_2_7f958423a7cfe1774157efdcb79ac0be( $selection,$curve_sphere);
	}
	else
	{
		$curve_sphere[0]=BOVER_10_2_c31045748f3c557589184e51283ed2cd($radius);
	}
   select $curve_sphere ;
   return $curve_sphere;
}
