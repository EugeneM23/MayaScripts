	columnLayout  -adjustableColumn true  -ann "use for aniomation objects" base_column;
			rowLayout -p "base_column" -cw 1 190  -cw 2 204  -adj 2 -nc 4 arrange_item;
			    text -en 0 -w 90
					-ann "owershoot to left frame"
					-p "arrange_item" -l "overshoot<<<";
			    rowLayout -p "arrange_item"
					-ann "tween range"
					-cw 1 98  -cw 2 70  -cw 3 90 -w 200   -nc 3 ;
    			    button -w 20
    			        -bgc 0.8 1 0.8
						-ann "tween to left frame, or hard push curve"
    			        -l "<"
    			        -c "intSlider -e -v 0 slidder_tween_my; floatField -e -v 0  tween_slider_field; BOVER_10_2_d18150d077ed5b67c6812087cb8711c2((`intSlider -q -v slidder_tween_my`)/100.0, 0.2);";
                    floatField    -nbg 1 -ed 0 -ebg 0  -v 50 -w 46  -precision 0
    				    -cc "intSlider -e  -v (`floatField -q -v tween_slider_field`) slidder_tween_my"
    				    tween_slider_field;
    				button -w 20
						-ann "tween to right frame, or hard push curve"
    			        -bgc 0.8 1 0.8
    			        -l ">"
				        -c "intSlider -e -v 100 slidder_tween_my; floatField -e -v 100  tween_slider_field; BOVER_10_2_d18150d077ed5b67c6812087cb8711c2((`intSlider -q -v slidder_tween_my`)/100.0, -0.4);";
            text -en 0
				-ann "owershoot to right frame"
				-w 90 -p "arrange_item" -l ">>>overshoot";
            rowLayout -p "base_column" -cw 1 65 -nc 2 -adj 1;
				intSlider
					-ann "drag to tween, overshoot (for frame) or push (for selected curves)"
					-p "base_column"
					-h 16 -min -100 -max 200 -value 50
				    -dc "$bar_tween_val_UI_posiiton=`intSlider -q -v slidder_tween_my`; BOVER_10_2_d18150d077ed5b67c6812087cb8711c2((`intSlider -q -v slidder_tween_my`)/100.0, 0.01);  floatField -e -v (`intSlider -q -v slidder_tween_my`)  tween_slider_field; "
					-step 1
					slidder_tween_my;
	showWindow "tween_window";
}
