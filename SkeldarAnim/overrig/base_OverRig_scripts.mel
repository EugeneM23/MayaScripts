global proc vector BOVER_10_2_b2bb441f7665fb6e6f9e58a22cb5e462(string $curve)
{
    BOVER_10_2_c3face5af2eaef8e548ce10d50587275($curve);
    string $J[]=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
    BOVER_10_2_a9acebc46d5277d92e6d954501ac53c7( "x","up", "");
    vector $j_pos[]=BOVER_10_2_72356eaf232b169651a82383ba9e7e57($J);
    string $L[]=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
    move -r -os -wd 0 20 0 $L;
    vector $l_pos[]=BOVER_10_2_72356eaf232b169651a82383ba9e7e57($L);
    float $vec_summ[]={0,0,0};
    vector $vect_summ=<<0,0,0>>;
    float $fl_j_pos[],$fl_l_pos[],$vec[];
    vector $all_y_vectors[];
    for($i=0;$i<size($J);$i++)
    {
        $fl_j_pos=$j_pos[$i];
        $fl_l_pos=$l_pos[$i];
        $vec=BOVER_10_2_b785f6145105d03029da5b3e19367cbd($fl_j_pos, $fl_l_pos, 1);
        $all_y_vectors[$i]=<<$vec[0],$vec[1],$vec[2]>>;
        $vect_summ= $vect_summ+$all_y_vectors[$i];
    }
    delete $J $L;
    return $vect_summ;
}
global proc float[] BOVER_10_2_b785f6145105d03029da5b3e19367cbd(float $p1[], float $p2[], int $normalize)
{
  float $v2_1[]={$p2[0]-$p1[0],$p2[1]-$p1[1],$p2[2]-$p1[2]};
  if($normalize)
      normalize ($v2_1);
  return $v2_1;
}
global proc float[] BOVER_10_2_8aba008b6f6ae60b66a902e6ab3eed1c(string $objects[], float $lenght_coeff, float $distribution_coeff)
{
	if(size($objects)!=3)
    {
        warning "need 3 objects!";
        return {};
    }
	float $fin_coords[];
	float $p1[];
	float $p2[];
	float $p3[];
	$p1 =BOVER_10_2_8598296823aa3af15686cb0d78f1615d($objects[0]);
	$p2 =BOVER_10_2_8598296823aa3af15686cb0d78f1615d($objects[1]);
	$p3 =BOVER_10_2_8598296823aa3af15686cb0d78f1615d($objects[2]);
	$vector=BOVER_10_2_6f6ae5b84133776f167ce9bbf3409540($p1,$p2,$p3);
	vector $p1_p2=<<$p1[0],$p1[1],$p1[2]>> -<<$p2[0],$p2[1],$p2[2]>>;
	$lenght=(`mag $p1_p2`)*$lenght_coeff;
	float $x=$vector[0]*$lenght + $p2[0]*$distribution_coeff + $p1[0]*(1-$distribution_coeff);
	float $y=$vector[1]*$lenght + $p2[1]*$distribution_coeff + $p1[1]*(1-$distribution_coeff);
	float $z=$vector[2]*$lenght + $p2[2]*$distribution_coeff + $p1[2]*(1-$distribution_coeff);
	$fin_coords={$x,$y,$z};
	return $fin_coords;
}
global proc float BOVER_10_2_476390711655739e4d4919b7f7336b00(float $pos_A[], float $pos_B[], float $pos_C[])
{
	float $c=BOVER_10_2_9cf10c253bb06da91bcfe3836a7e5f36($pos_A, $pos_B);
    float $b=BOVER_10_2_9cf10c253bb06da91bcfe3836a7e5f36($pos_A, $pos_C);
    float $a=BOVER_10_2_9cf10c253bb06da91bcfe3836a7e5f36($pos_C, $pos_B);
    float $p=($a+$b+$c)/2;
    float  $arg=($p*($p-$a)*($p-$b)*($p-$c));
    if($arg<=0)
        $arg=0;
	float $sqr=sqrt($arg);
    float $H_c=(2*$sqr)/$c;
    return $H_c;
}
global proc float[] BOVER_10_2_7145e62c24cf62d609b928973d8456c7(float $points[], int $need_sort, int $longest)
{
    float $curr_interval;
    float $found_interval=0;
    float $curr_ind;
    if($need_sort)
        $points=sort($points);
    if(!$longest)
       $found_interval=`maxfloat`;
    for($i=0;$i<(size($points)-1);$i++)
    {
        $curr_interval=abs($points[$i+1] - $points[$i]);
        if($longest)
        {
            if($curr_interval>$found_interval)
            {
                $found_interval= $curr_interval;
                $curr_ind=$i;
            }
        }
        else
        {
            if($curr_interval<$found_interval)
            {
                $found_interval= $curr_interval;
                $curr_ind=$i;
            }
        }
    }
	return  {$curr_ind,$found_interval};
}
global proc string BOVER_10_2_65107bc37ea4a0d842be293fd78287a9(string $attribname, string $object)
{
    addAttr -ln $attribname -nn $attribname -at long  -dv 0 $object;
    setAttr -e-channelBox true ($object + "." + $attribname);
    return   ($object + "." + $attribname);
}
global proc string BOVER_10_2_7b95c992be7b036735f7298f89ab9556(string $object,string $curve_name, float $framerange[], string $curve_movement_loc, int $bake_anim)
{
    undoInfo  -ock -cn "curve_motion_path";
	if( ($framerange[1]- $framerange[0])==1)
	{
		$framerange[0]=`playbackOptions -q -ast`;
		$framerange[1]=(`playbackOptions -q -aet`) + 1;
	}
	string $m_path=`pathAnimation -fractionMode 0 -follow true -followAxis x -upAxis z -worldUpType "scene" -inverseUp false -inverseFront false -bank false -startTimeU $framerange[0] -endTimeU ($framerange[1]-1) $curve_name $curve_movement_loc`;
	if($bake_anim)
	{
		string $near_point_on_crve_node=`createNode nearestPointOnCurve`;
		string $decompose_matrix_node=`createNode decomposeMatrix`;
		connectAttr -f ($object + ".worldMatrix[0]") ($decompose_matrix_node + ".inputMatrix");
		connectAttr -f ($decompose_matrix_node + ".outputTranslate") ($near_point_on_crve_node + ".inPosition");
		string $crve_shape[]=BOVER_10_2_5e702211108f11813c411c94f8b1b380($curve_name);
		connectAttr -f ($crve_shape[0] + ".worldSpace[0]")  ($near_point_on_crve_node + ".inputCurve");
		select $m_path;
		int $j=0;
		float $U_V_param[];
		for($i=$framerange[0]; $i<$framerange[1];$i++)
		{
			currentTime $i;
			$U_V_param[$j]=getAttr ($near_point_on_crve_node + ".parameter");
			setKeyframe  -v $U_V_param[$j] -t $i ($m_path + ".uValue");
			keyframe -e -vc $U_V_param[$j]  -t $i ($m_path + "_uValue");
			$j++;
		}
		keyTangent -itt spline -ott spline $m_path;
		delete $near_point_on_crve_node $decompose_matrix_node;
	}
    string $find_double_linear[]=`listConnections  -d 1 -s 0 -scn 1 -type "addDoubleLinear"  $curve_movement_loc `;
    connectAttr -f ($m_path + ".allCoordinates") ($curve_movement_loc + ".translate");
    delete $find_double_linear;
	return $m_path;
}
global proc string BOVER_10_2_ddf3e35ed988fd159dd82159edfce03a(string $selection[], float $hardness, float $sdvig_lenght, float $sdvig_side, float $smooth_end, int $cycled, int $abs_mode )
{
    float $curren_time =`currentTime -q`;
    string $gr_name;
	if(size($selection)<=1)
	{
	    warning "one chain member, skipped";
	    select -cl;
	    $gr_name="break";
	    return $gr_name;
	}
	select $selection;
	BOVER_10_2_9bad7ec683c4a9fc4b3098a039f34d33(8, 1);
	string $joints[]=`ls-sl`;
	select $joints;
	euler_filter_on_selected;
    string 	$top_locks[], $cycle_layer_name;
    string $side_locks[];
    float $lenght_aim_move;
    string $top_locks_fin[];
    if($abs_mode==1)
    {
        $sdvig_lenght=$sdvig_lenght/size($selection);
        $sdvig_side=0;
    }
    $size=size($joints);
    for ($i=0; $i<size($joints);$i++)
	{
    	select $joints[$i];
    	$top_locks=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
        if ($i!=`size($joints)`-1)
            $lenght_aim_move=BOVER_10_2_c7822f1f10b007a6803735c105e40799($joints[$i], $joints[$i+1]);
        else
    	    $lenght_aim_move=BOVER_10_2_c7822f1f10b007a6803735c105e40799($joints[$i], $joints[$i-1]);
    	move -r -os -wd ($lenght_aim_move*$hardness) 0 0 ;
    	BOVER_10_2_17431451b1be026fdeee93b86579c6b6({$joints[$i]}, $top_locks);
        BOVER_10_2_c89bf830cdb2b9cc874e6c8604e8b257;
        BOVER_10_2_de88efca2929f0080ae1d45ff5db42d4;
        euler_filter_on_selected;
    	$top_locks_fin[$i]=$top_locks[0];
        aimConstraint -mo -weight 1 -aimVector 1 0 0 -upVector 0 0 1 -worldUpType "objectrotation" -worldUpVector 0 0 1 -worldUpObject $top_locks_fin[$i]  $top_locks_fin[$i] $joints[$i];
    	if($i==0&&$smooth_end!=0)
    	{
    	    select $top_locks  ;
    	    BOVER_10_2_01964c63a0f5c1bf0eb159d94bb787cc(($hardness*$smooth_end*2),0);
			keyTangent -itt spline -ott spline;
    	}
    	if ($cycled)
    	{
    		select $top_locks;
		    $cycle_layer_name=BOVER_10_2_bdd2d2262c150fe16a261bb2e2e76046(1);
	        copy_start_frame_to_end();
	        BOVER_10_2_37aa5a96585e35a67af0d77c7cbea21c();
	        animCurveEditor -edit -displayInfinities 1 graphEditor1GraphEd;
    		setInfinity -pri cycle -poi cycle;
    	}
    	keyframe -e -iub true -r -o over -tc ($sdvig_lenght  ) $top_locks[0];
    	keyframe -e -at rx  -at ry  -at rz  -iub true -r -o over -tc ( $sdvig_side) $top_locks[0];
		rotationInterpolation -convert quaternionSlerp $top_locks.rotateX;
	}
	select $top_locks_fin  $joints[0];
	$gr_name=`group -n "hvost_over"`;  xform -os -piv 0 0 0;
	currentTime  $curren_time;
	return $gr_name;
}
global proc BOVER_10_2_01964c63a0f5c1bf0eb159d94bb787cc(float $period, int $pre_bake)
{
 float $min,$max;
    float $range[]= BOVER_10_2_dfc2513778a513e560ec81c8f3df6563();
    if($range[1]-$range[0]==1)
    {
        $min=`playbackOptions -q -min`;
        $max=`playbackOptions -q -max`;
        $range={$min,$max};
    }
	float $rng=$range[1]-$range[0];
	if($period>$rng)
		$period=$rng;
    if($pre_bake)
        bakeResults -sampleBy 1 -oversamplingRate 1 -preserveOutsideKeys 1 -sparseAnimCurveBake 0;
	float $frame=floor($rng/$period);
	$frame=$rng/$frame;
    filterCurve -f resample  -kernel gaussian2 -period $frame -s $range[0] -e $range[1];
}
global proc string BOVER_10_2_14afa0678ff0c658f1f377ff020d13d2(string $objects[])
