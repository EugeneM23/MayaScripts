global proc BOVER_10_2_15a4ea50cf1974ac5aa20a845bd17e2c(float $value, int $frame, int $uniform)
{
    global int $bar_noise_UI_posiiton;
    global int $bar_noise_UI_posiiton_prev;
    if($bar_noise_UI_posiiton>$bar_noise_UI_posiiton_prev)
    {
        if( $frame!=0)
            BOVER_10_2_7bd26c8b37f4670d39bdb4c4c27816c3($value, $frame, $uniform);
    }
    else
    {
        if( $frame!=0)
            BOVER_10_2_3676fd34198e455bb82f6106192bc927($frame+1,$uniform);
    }
    $bar_noise_UI_posiiton_prev=$bar_noise_UI_posiiton;
}
