global proc float[] barn_copy_keys()
{
    string $crvs[] = `keyframe -q -n`;
    global float $barn_copied_curve_range[];
    $barn_copied_curve_range = `keyframe -q  -sl $crvs`;
    if (size($crvs)!=1)
    {
        warning "select keyframes on single animCurve!";
        return {};
    }
    copyKey -option curve;
    return  $barn_copied_curve_range;
}
global proc barn_past_scaled_keys()
{
    global float $barn_copied_curve_range[];
    string $crvs[] = `keyframe -q -n`;
    float $num_frame[];
    int $num;
    for($crv in $crvs)
    {
        $num_frame = `keyframe -q -sl $crv`;
        $num=size($num_frame)-1;
        if($num!=0)
            pasteKey -time ($num_frame[0] + ":" + $num_frame[$num]) -option scaleReplace -copies 1 -connect 1 -timeOffset 0 -floatOffset 0  $crv;
        else
            pasteKey -time ($num_frame[0] + ":" + ($num_frame[0]- $barn_copied_curve_range[0] + $barn_copied_curve_range[size($barn_copied_curve_range)-1] )) -option scaleReplace -connect 1 -copies 1 -timeOffset 0  -floatOffset 0 $crv;
    }
}
global proc bar_tween_machine(float $poseBias, string $objects[])
{
	string $curves[], $attribs[], $tmp[], $crv, $full;
	float $cur_time;
	float $timeL,$timeR;
	string $tanL[],$tanR[],$tanFin[];
	float $x;
	float $pk=3;
	if($poseBias>1.5)
	{
		$x=$poseBias;
		$x=pow (2,$pk*$x -$pk);
		$poseBias=$x- 1.37;
	}
	if($poseBias<-0.5)
	{
		$x=1-$poseBias;
		$x=pow (2,$pk*$x -$pk);
		$poseBias= 1-$x + 1.37;
	}
	float $val_curr[],$diffToUse,$v_new;
	$cur_time = `currentTime -q`;
	$attribs = `channelBox -q -selectedMainAttributes mainChannelBox`;
	$curves = `keyframe -q -n -sl`;
	if (size($attribs)>=1&& size($curves)==0)
	{
		for ($obj in $objects)
		{
			for ($attrib in $attribs)
			{
				$full = $obj + "." + $attrib;
				if (!objExists($full))
					continue;
				$tmp = `keyframe -q -name $full`;
				if (!size($tmp))
					continue;
				$curves[size($curves)] = $tmp[0];
			}
		}
	}
	else
	if(size($curves)==0)
		$curves = `keyframe -q -name $objects` ;
	for ($crv in $curves)
	{
		$timeL = `findKeyframe -which previous $crv`;
		$timeR = `findKeyframe -which next $crv`;
		$tanL = `keyTangent -time $timeL -q -itt -ott $crv`;
		$tanR = `keyTangent -time $timeR -q -itt -ott $crv`;
		$tanFin={$tanL[0],$tanR[0]};
		if (($tanL[0] == "fixed")||($tanL[1] == "fixed") ||($tanR[0] == "fixed")||($tanR[1] == "fixed"))
			  $tanFin = `keyTangent -q -g -itt -ott`;
		else
			if ($tanR[1] == "step")
				$tanFin[1] = $tanR[1];
		$val_curr  = `keyframe -time $timeL -time $timeR -q -valueChange $crv` ;
		$diffToUse = ($val_curr[1] - $val_curr[0]) * $poseBias;
		$v_new = $val_curr[0] + $diffToUse;
		setKeyframe -t $cur_time -v $v_new -ott $tanFin[1] $crv;
		if ($tanFin[0] != "step")
			keyTangent -t $cur_time -itt $tanFin[0] $crv;
	}
	currentTime -e $cur_time;
}
global proc overRig_tween_window()
{
    if(`window -q -ex "tween_window"`)deleteUI("tween_window");
    window
		-title " key tween, key overshoot or curve push"
