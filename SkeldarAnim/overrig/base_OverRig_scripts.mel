global proc BOVER_10_2_45974e786e3602ef878571e324a928e9(float $loc_size, string $Piv_Top_Side[], string $source_obj[])
{
    string $constr[]=BOVER_10_2_17431451b1be026fdeee93b86579c6b6({$source_obj[0],$source_obj[0],$source_obj[0]},$Piv_Top_Side);
    select $source_obj;
    BOVER_10_2_ac692345fba3e827ad5d6e26de39ba07;
    string $source_locks[]=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
