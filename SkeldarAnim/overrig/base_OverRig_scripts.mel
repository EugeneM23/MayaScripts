						menuItem -label "8" -ann "range 8" -command "bar_create_multiply_fast_motion_trail(8, 8, 0)";
						menuItem -label "16" -ann "range 16" -command "bar_create_multiply_fast_motion_trail(16, 16, 0)";
						menuItem -label "24" -ann "range 24" -command "bar_create_multiply_fast_motion_trail(24, 24, 0)";
				menuItem -divider true -dividerLabel "";
						menuItem -label "ALL" -ann "range min-max" -command "bar_create_multiply_fast_motion_trail(0, 0, 1)";
				menuItem -divider true -dividerLabel "dots density";
					menuItem -label "like source" -ann "dots like source" -command " BOVER_10_2_699d19a6ef292a5a2793307d8cc5bdc9(1)";
					menuItem -label "every frame" -ann "dots every frame" -command " BOVER_10_2_699d19a6ef292a5a2793307d8cc5bdc9(0)";
				menuItem -divider true -dividerLabel "";
				menuItem -subMenu true  -to 1 "trail space";
						menuItem -label "world" -ann "world space (defoult)" -command "BOVER_10_2_eb692253eb06a5db6cab6866921fb41e()";
						menuItem -label "current camera" -ann "current camera space" -command "BOVER_10_2_d22e9b806664d2f74ecb0dfb47ef797d({`BOVER_10_2_20a28b95c1b8b4dd29397ab332dbc667`})";
						menuItem -label "selected object" -ann "object space " -command "BOVER_10_2_d22e9b806664d2f74ecb0dfb47ef797d(`ls-sl`)";
		button -l "S"
			-w 20
			-ann "RMB for set trail permanent settings"
			-c "bar_create_multiply_fast_motion_trail(0, 0, 0)"
			mt_settings;
			popupMenu -button 1 -parent mt_settings;
				menuItem -divider true -dividerLabel "trail thikness";
					menuItem -label "trail 1" -ann "trail thikness 1" -command "BOVER_10_2_8acbdd90e1a397ed24eb3b1674ab9209(1, -1, {-1,0,0})";
					menuItem -label "trail 2" -ann "trail thikness 2" -command "BOVER_10_2_8acbdd90e1a397ed24eb3b1674ab9209(2, -1, {-1,0,0})";
				menuItem -divider true -dividerLabel "dot size";
					menuItem -label "dot 0" -ann "dot size 0" -command "BOVER_10_2_8acbdd90e1a397ed24eb3b1674ab9209(-1, 0, {-1,0,0})";
					menuItem -label "dot 1" -ann "dot size 1" -command "BOVER_10_2_8acbdd90e1a397ed24eb3b1674ab9209(-1, 1, {-1,0,0})";
					menuItem -label "dot 2" -ann "dot size 2" -command "BOVER_10_2_8acbdd90e1a397ed24eb3b1674ab9209(-1, 2, {-1,0,0})";
				menuItem -divider true -dividerLabel "dot color";
					menuItem -label "dot WHITE" -ann "dot white color" -command "BOVER_10_2_8acbdd90e1a397ed24eb3b1674ab9209(-1, -1, {1,1,1})";
					menuItem -label "dot BLACK" -ann "dot black color" -command "BOVER_10_2_8acbdd90e1a397ed24eb3b1674ab9209(-1, -1, {0,0,0})";
					menuItem -label "dot YELLOW" -ann "dot yellow color" -command "BOVER_10_2_8acbdd90e1a397ed24eb3b1674ab9209(-1, -1, {1,1,0})";
	rowLayout  -p "misc_BOR_fr_lay_ui_colmn"  -nc 3     -cal 1 left -cal 2 right "misc_ui";
		button -ann "display line size menue"
						-w 20
						-h $l_p_h
						 -l "*"
						 size_line_two;
				popupMenu -button 1 -parent "size_line_two" "nastroyki_menu";
					menuItem -divider true -dividerLabel "display line width" ;
					menuItem -label "line wight 1" -ann "display line wight 1" -command "displayPref -lineWidth 1";
					menuItem -label "line wight 2" -ann "display line wight 2" -command "displayPref -lineWidth 2";
					menuItem -divider true -dividerLabel "camera";
					menuItem -label "camera near clip 1" -ann "display camera near clip plane 1" -command " setAttr (`BOVER_10_2_20a28b95c1b8b4dd29397ab332dbc667` + \".nearClipPlane\") 1;";
					menuItem -label "Z up axis" -ann "turn world coordinate to Z up" -command " upAxis -ax z -rv; viewLookAt(`BOVER_10_2_20a28b95c1b8b4dd29397ab332dbc667`)";
					menuItem -label "Y up axis" -ann "turn world coordinate to Y up" -command " upAxis -ax y -rv; viewLookAt(`BOVER_10_2_20a28b95c1b8b4dd29397ab332dbc667`)";
					menuItem -divider true -dividerLabel "pivot";
					menuItem -label "hide active pivot" -ann "hide pivots for active objects" -command "displayPref  -activeObjectPivots 0";
					menuItem -label "show active pivot" -ann "drawing pivots for active objects" -command "displayPref  -activeObjectPivots 1";
					menuItem -divider true -dividerLabel "togglers" ;
					menuItem -subMenu true  -to 1 "isolate selection togglers" ;
						menuItem -label  "isolate selection" -ann "isolate selected with childs" -c "apply_bar_isolate_selection_toggler(0)";
						menuItem -label  "isolate hierarchy with geometry" -ann "isolate selected with childs" -c "apply_bar_isolate_selection_toggler(1)";
						menuItem -label  "isolate selected with geometry" -ann "isolate selected without childs. Work only conrtols and locators" -c "apply_bar_isolate_selection_toggler(2)";
						setParent -m "nastroyki_menu";
					menuItem -subMenu true  -to 1 "usefull togglers";
						menuItem -label  "X-Ray toggle" -ann "X-Ray mode toggle on selected viewport" -c "bar_x_ray_toggler()";
						menuItem -label  "Translate axis toggle"  -ann "world/local/object cycle toggle" -c "bar_translate_toggler()";
						menuItem -label  "Translate option" -ob 1 -ann "translate option box" -c " setToolTo moveSuperContext; toolPropertyWindow -restore -inMainWindow false";
						menuItem -label  "Rotate axis toggle" -ann "world/local/gimbal cycle toggle" -c "bar_rotate_toggler()";
						menuItem -label  "Rotate option" -ob 1 -ann "rotate option box" -c " setToolTo RotateSuperContext; toolPropertyWindow -restore -inMainWindow false";
		button -ann "create locators on selected"
				 -p "misc_ui"
				-w 80
				-h $l_p_h
 				-c "create_normalised_locators_on_selected(); BOVER_10_2_6de8028af587b467034457b4d6349f89(1.5)"
				 -l "locator"
				 blocator;
		button -ann "create locators inside selected"
				 -p "misc_ui"
				-w 80
				-h $l_p_h
 				-c "mocup_parent_locators_inside(); BOVER_10_2_6de8028af587b467034457b4d6349f89(1.5)"
				 -l "locator inside"
				 blocator_inside;
	rowLayout -p "misc_BOR_fr_lay_ui_colmn"   -adj 2 -ebg true -nc 5;
		button -ann "finger toolset"
 				-c "brn_apply_finger_pivot_window()"
					-h $l_p_h
					 -bgc 0.8 1.0 0.84
					 -l "fingers tool"
					 bPPP_fast_3_IK_tool;
		text "";
		button -ann "pivot. After press button, move object in right place and click empty space. Rotate and click again"
					-w 56
					-h $l_p_h
					 -l "pivot"
					 bPPP_piv;
		popupMenu -button 1 -parent bPPP_piv; 
			menuItem -label "average" -ann "average start position" -command "move_and_rotate_total_pivot(1)";
			menuItem -label "average, zero vertical" -ann "average start position" -command "move_and_rotate_total_pivot(3)";
			menuItem -label "zero" -ann "zero start position" -command "move_and_rotate_total_pivot(4)";
			menuItem -label "first" -ann "first selected start position" -command "move_and_rotate_total_pivot(2)";
			menuItem -label "last" -ann "last selected start position" -command "move_and_rotate_total_pivot(0)";
		rowLayout -p "misc_BOR_fr_lay_ui_colmn"   -ebg true -nc 5;
			button -ann "size 50%"
 				-c "scale_selected_lock_or_joint(0.5)"
					-w 30
					-h ($l_p_h -2)
					 -l "--"
					 bF__H;
			button -ann "size 90%"
 				-c "scale_selected_lock_or_joint(0.8)"
					-w 30
					-h ($l_p_h -2)
					 -l "-"
					 bMM__H;
			button -ann "size 110%"
					-c "scale_selected_lock_or_joint(1.2)"
					-w 30
					-h ($l_p_h -2)
					 -l "+"
					 bPP;
			button -ann "size 150%"
 				-c "scale_selected_lock_or_joint(1.5)"
					-w 30
					-h ($l_p_h -2)
					 -l "++"
					 bPPP;
	rowLayout -p "misc_BOR_fr_lay_ui_colmn"   -adj 3 -ebg true -nc 5;
		button -ann "color menue"
					-c "small_DisplayColorOverrideUI()  "
						-w 56
						-h ($l_p_h )
						 -l "color"
						 color_menue;
		button -ann "change shape menue"
					-c "small_Shape_OverrideUI()  "
						-w 56
						-h ($l_p_h )
						 -l "shape"
						 shape_menue;
 		text -l " " ;
	  button
			-ann "print selected names (RMB - submenue)"
			-c " print(\"\\n\\n\\n\"); print(`ls-fl-sl`); print(\"\\n\"); print( stringArrayToString (`ls-fl-sl`, \"  \")) "
			-h ($l_p_h )
			-l  (size (`ls-fl-sl`))
			overrrig_num_selected_txt_field;
			popupMenu -button 3 -parent overrrig_num_selected_txt_field; 
				menuItem -label "like string array" -ann "print selected like string array value" -command "BOVER_10_2_d6b5218ae91bc4cc926fa52eef82b67d()";
		scriptJob -parent overrrig_num_selected_txt_field
				-event "SelectionChanged"
				"button -e  -l (size (`ls-fl-sl`)) overrrig_num_selected_txt_field";
}
