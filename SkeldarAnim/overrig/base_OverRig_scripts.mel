global proc BOVER_10_2_3c9b0fe2da1d41ec5f226b7208637f6a()
{
	global float $m_AIM_selectedTime[];
	global string $m_Piv_selection[];
	global string $m_Piv_locks[];
	global string $m_Piv_name_constraints[];
	global string $m_Piv_temp_gr_name;
	global string $m_Piv_groups[];
	global string $m_Piv_inside_bake_locks[];
	global int $m_Piv_mode;
	int $frame=`currentTime -q`;
	string $curve[] = `keyframe -q -n $m_Piv_locks`;
	float $crve_range[];
	if(size($curve))
	{
		selectKey  $curve;
		$m_AIM_selectedTime=BOVER_10_2_cba6da1b519f7600c71b7de0d52d2c3e();
	}
	else
	{
		$m_AIM_selectedTime[0]=`currentTime -q`;
		$m_AIM_selectedTime[1]=`currentTime -q`;
	}
	if(($m_AIM_selectedTime[1]-$m_AIM_selectedTime[0])==-1)
		catchQuiet(`setKeyframe -breakdown 0   -hierarchy none -controlPoints 0 -shape 1 $m_Piv_selection`);
	else
	{
		BOVER_10_2_692e2fda85cadfdf0f28e93323f58c08;
		autoKeyframe -state off;
		for ($i=$m_AIM_selectedTime[0];$i<=$m_AIM_selectedTime[1];$i++)
		{
			currentTime $i;
			catchQuiet(`setKeyframe -breakdown 0   -hierarchy none -controlPoints 0 -shape 1 $m_Piv_selection`);
		}
		autoKeyframe -state on;
		BOVER_10_2_f4b1a2b52ab1771321003f86cde63160;
	}
	catchQuiet(`delete $m_Piv_name_constraints`);
	catchQuiet(`delete $m_Piv_groups $m_Piv_locks`);
	select $m_Piv_selection;
	currentTime	$frame;
	undoInfo -cck;
}
global proc bar_create_multiply_fast_motion_trail(int $start, int $end, int $static)
{
  undoInfo -stateWithoutFlush 0;
	string $selected[]=`ls-sl`;
	if($start + $end !=0)
		if (!$static)
		{
			optionVar -intValue "bar_mt_START_val" $start;
			optionVar -intValue "bar_mt_END_val" $end;
		}
	global string $global_mt_name_last_created[];
	$global_mt_name_last_created={};
    global string $global_mt_name;
    global string $global_mtr_EGR_name;
    for($obj in $selected)
    {
        select $obj;
        if( objExists($obj + "*_motionTrailHandle")==0)
			BOVER_10_2_5af02f105b3c73a5596102329399dcb1($static);
		else
		{
			setAttr ( $obj + "*_motionTrailHandle.end") $end;
			setAttr ( $obj + "*_motionTrailHandle.start") $start;
			move -r 0 0.1 0 $global_mtr_EGR_name;
		}
		appendStringArray($global_mt_name_last_created, {$global_mt_name},1);
    }
    select $selected;
	undoInfo -stateWithoutFlush 1;
}
global proc double_inv_oscillate_or_mirror(float $period, string $t_axis, string $r_axis)
{
	float $t=`currentTime -q`;
	if(size(`ls-sl`)==0)
	{
	    print "nothing selected!";
	    return;
	}
	float $keysel[] = `keyframe -q -sl`;
    if(size($keysel)>0)
        BOVER_10_2_09bdb78af23637cc0a3c8a88a1e6ab24($t_axis,  $r_axis);
    else
        BOVER_10_2_a37a85a658eebae4bd5ae354ec083baa($period,  $t_axis,  $r_axis);
}
global proc Lag_Key(float $sdvig)
{
	$selection=`ls-sl`;
	string $crvs[];
	$crvs = `keyframe -q -n -sl`;
	$select_keys_or_now=!($crvs[0]=="");
	if ($select_keys_or_now)
	{
		$all_curves_and_frames = BOVER_10_2_a01af7626635f090f4162490a6d9507d($crvs);
		int $curr_obj_number;
		string $all_curves_and_frames_new[];
		clear $all_curves_and_frames_new;
		float $tmp[];
		string $tmp_string [];
		float $temp_name_fr[];
		for($i=0; $i<size($crvs); $i++)
		{
			int $number = BOVER_10_2_2d92805242e50041994bf7f653f4e114($selection,$crvs[$i]);
			eval("selectKey -k " + $all_curves_and_frames[$i] + " " + $crvs[$i]);
			keyframe -e -iub true -r -o over -tc (($sdvig*$number));
			clear $temp_name_fr;
			$temp_name_fr = `keyframe -q`;
			$temp_param = "";
			for($j=0; $j<size($temp_name_fr); $j++)
			{
				$temp_param = $temp_param + "-t " + $temp_name_fr[$j] + " ";
			}
			$all_curves_and_frames_new[$i] = $temp_param;
		}
		for($i=0; $i<size($crvs); $i++)
		{
			eval ("selectKey -add -k" + $all_curves_and_frames_new[$i] + " " + $crvs[$i]);
		}
		clear $all_curves_and_frames;
		clear $all_curves_and_frames_new;
	}
	else
	{
		for($i=0;$i<size($selection);$i++)
		{
			keyframe -e -iub true -r -o over -tc (($sdvig*$i)) $selection[$i];
		}
	}
}
global proc float[] BOVER_10_2_cba6da1b519f7600c71b7de0d52d2c3e()
{
	float $num_frame[] = `keyframe -q  -sl`;
	$num_frame=`sort  $num_frame`;
	if(size($num_frame)==0)
	{
		warning "no interval selected" ;
		return {0,-1};
	}
	return {$num_frame[0], $num_frame[size($num_frame)-1]};
}
global proc set_key_time_range(string $mode)
{
	if((size(`ls-sl`))==0)
	{
		warning "nothing selected";
		return;
	}
	int $mayaver24=0;
    float $mayaVersion = `getApplicationVersionAsFloat` ;
	string $patch_ver;
	float $patch_ver_fl;
    if ($mayaVersion==2024)
	{
		$patch_ver=`about  -minorVersion`;
		$patch_ver_fl=$patch_ver;
		if($patch_ver_fl<2)
			$mayaver24=1;
	}
	$cur_time = `currentTime -q`;
	global string $gPlayBackSlider;
	float $selectedTime[]=`timeControl -q -ra $gPlayBackSlider`;
	float $end_of_range=$selectedTime[1]-1;
	float $start_of_range=$selectedTime[0];
	float $range=$end_of_range - $start_of_range;
	if($range==0)
		{
		currentTime -update false (`currentTime -q`);
	    if($mode=="all")
            setKeyframe -breakdown 0 -hierarchy none -controlPoints 0 -shape 0;
        if($mode=="translate")
            setKeyframe -at translate;
        if($mode=="rotate")
            setKeyframe -at rotate;
        if($mode=="scale")
            setKeyframe -at scale;
        if($mode=="channelbox")
            channelBoxCommand -key;
        }
        else
        {
        	if($mayaver24==0)
        		if($cur_time>=$end_of_range)
        			currentTime  $start_of_range;
        		else
        			currentTime $end_of_range;
        	refresh -su 1;
            for($i=0; $i<=$range; $i++)
            {
                currentTime -update false ($start_of_range + $i);
                if($mode=="all")
                    setKeyframe -breakdown 0 -hierarchy none -controlPoints 0 -shape 0;
                if($mode=="translate")
                    setKeyframe -at translate;
                if($mode=="rotate")
                    setKeyframe -at rotate;
                if($mode=="scale")
                    setKeyframe -at scale;
                if($mode=="channelbox")
                    channelBoxCommand -key;
            }
        	currentTime $cur_time;
        	refresh -su 0;
	}
}
