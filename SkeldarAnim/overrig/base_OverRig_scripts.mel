global proc BOVER_10_2_012d9443d9a5fb6cc34e63f93910d7d2(string $source_objs[],string $target_objs[])
{  
	if(size($source_objs)!=size($target_objs))
	{
	    warning "objets size mismatch";
	    return;
	}
	$min_range=`playbackOptions -q -ast`;
    $max_range=`playbackOptions -q -aet`;
    $timedd=`currentTime -q`;
    float $keys_times[];
    int $keys_int_times[];
    string $cmd_t;
    for($i=0;$i<size($source_objs);$i++)
    {
        $keys_times= BOVER_10_2_78b3badf5e21d9d0f6a0516171924096 ({$source_objs[$i]}, "all");
        $keys_int_times= BOVER_10_2_8dcf27adae2f0cd4520378fd7044ea43($keys_times, 0 ,0);
        if(size( $keys_times)>1)
        {
            $cmd_t="";
            for($k in $keys_int_times)
                $cmd_t=$cmd_t + " -t " + $k;
            $cmd_t = "selectKey -tgl -k  " + $cmd_t + " " + $target_objs[$i] + ";";
            selectKey -add -time ($min_range + ":" + $max_range) $target_objs[$i];
            eval ($cmd_t );
        }
    }
    cutKey -animation keys -clear;
}
global proc BOVER_10_2_7d8d1e6007388fcf544fa573f4e74bdd(string $source_objs[],string $target_obj)
{
	$min_range=`playbackOptions -q -ast`;
	$max_range=`playbackOptions -q -aet`;
	$timedd=`currentTime -q`;
	float $keys_times[];
	string $cmd_t;
	selectKey -add -time ($min_range + ":" + $max_range) $target_obj;
    for($i=0;$i<size($source_objs);$i++)
    {
        $keys_times=BOVER_10_2_78b3badf5e21d9d0f6a0516171924096 ({$source_objs[$i]}, "all");
        if(size( $keys_times)>1)
        {
            $cmd_t="";
            for($k in $keys_times)
                $cmd_t=$cmd_t + " -t " + $k;
            $cmd_t = "selectKey -rm -k  " + $cmd_t + " " + $target_obj + ";";
            eval ($cmd_t );
        }
    }
    cutKey -animation keys -clear;
}
global proc string BOVER_10_2_a54e109972caf8ac808da7205e765e57(string $name_expression, int $size_inputs)
{
    $expression_name=`expression  -ae 0 -s "" -n  $name_expression `;
    string $cmd="string $p[];\n";
    for($i=0;$i<$size_inputs;$i++)
    {
        $cmd= $cmd + "  \n $p[" + $i + "]=.I[" + $i + "];";
    }
     $cmd= $cmd + " \n $h=`sort $p`; \n .O[0]=$h[size($p)-1];";
    expression  -e  -s $cmd $expression_name ;
    for($i=0; $i<$size_inputs;$i++)
    {
        addAttr -ln ("null" + $i) -nn ("null" + $i)  -dv 0   -dcb 1 $expression_name;
        connectAttr -f ( $expression_name + ".null" + $i) ( $expression_name + ".input[" + $i + "]");
    }
    return $expression_name;
}
global proc string[] BOVER_10_2_1162cc0d0275955a6cf83aa8d5c88aa0()
{
	string $selected[] = `ls -fl -sl`;
	if(!size($selected))
	{
		warning "select something!!!";
		return {};
	}
	$min=`playbackOptions -q -ast`;
    $max=`playbackOptions -q -aet`;
	global string $gPlayBackSlider;
	float $frame_range[]=`timeControl -q -ra $gPlayBackSlider`;
	BOVER_10_2_bb5805895dc14a829576cd013ec234e4($selected);
	string $locators[]=`BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0`;
	$locators=BOVER_10_2_c9088e941b7677113499bb19ad80f9bf ("Parent_", $selected);
	BOVER_10_2_c89bf830cdb2b9cc874e6c8604e8b257;
	BOVER_10_2_29941243f77aa0343e79460d48136072 (8);
	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(18);
	global int $barnev_OverRig_RotateOrder;
			if($barnev_OverRig_RotateOrder==6)
				BOVER_10_2_d1b73d0512bac8d20998bdbab9b3aed7($selected, $locators);
			else
				BOVER_10_2_d04a25c84de52f4787d68215d32315e0($barnev_OverRig_RotateOrder,$locators);
	delete (BOVER_10_2_ac2021d0d7ff3ecfad4dbca9f9f88248 ($selected,$locators));
	string $constr[];
	catch ($constr=BOVER_10_2_17431451b1be026fdeee93b86579c6b6($selected, $locators));
	if($frame_range[1]-$frame_range[0]>1)
	    $its_baked=catchQuiet (`bakeResults -sm 1 -minimizeRotation 1 -sparseAnimCurveBake 1 -smart  1 -sampleBy 1 -t (($frame_range[0]-1)+":"+$frame_range[1]) $locators`);
	else
	    $its_baked=catchQuiet (`bakeResults -sm 1 -minimizeRotation 1 -sparseAnimCurveBake 1 -smart  1 -sampleBy 1 -t ($min+":"+$max) $locators`);
	delete $constr;
	string $constr_names[];
if($its_baked)
        warning "select something!";
	catch ($constr_names=BOVER_10_2_17431451b1be026fdeee93b86579c6b6($locators, $selected));
	catch(BOVER_10_2_f0549514de82c9ee2236723b537462e7($locators, $constr_names,"attach", $frame_range, 1));
	select $locators;
	BOVER_10_2_3323b46f97bc12510f86536ae21ff525;
	return $locators;
}
