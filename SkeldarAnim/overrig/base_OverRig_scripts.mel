global proc string[] BOVER_10_2_f2d5a2798ed7cfee36eb77ee8a281ed8()
{
	string $selection[];
	$selection = `ls -fl -os`;
	$selection=BOVER_10_2_6b3d22f4c951fb49c197d50c1803f0cb($selection);
	string $locators[];
	string $b[];
	select -cl;
	float $getPvPos[];
	if (size ($selection)>0)
	{
	    $j=0;
	    for($obj in $selection)
	    {
            $getPvPos=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($obj);
            $b[0]=`joint`;
            $locators[$j]=$b[0];
            xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
            rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
            $j++;
		}
		for($obj in $locators)
		    select -add $obj;
	}
	else
		$locators[0] =`joint -p 0 0 0`;
	select -cl;
	select $locators;
	return $locators;
}
global proc string[] BOVER_10_2_92f8bb791ca3a38da50df3bfa5733ff5()
{
	$selected=`ls-fl-sl`;
	if(size($selected)<=0)
	{
		warning "Nothing selected!";
		return {""};
	}
	$locators=`BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0`;
	setKeyframe  $locators;
	$locators=BOVER_10_2_e706e982298fe9e8f94ae04b06b5d6b2("LOH");
    $minTR=`playbackOptions -q -ast`;
    $maxTR=`playbackOptions -q -aet`;
    $time=`currentTime -q`;
    autoKeyframe -st 0;
    for($i=$minTR;$i<=$maxTR;$i++)
    {
        currentTime $i;
        BOVER_10_2_5e8af8371c687e5c50d7ded5040ffe13($selected, $locators);
        setKeyframe  $locators;
    }
    autoKeyframe -st 1;
	currentTime $time;
	return $locators;
}
