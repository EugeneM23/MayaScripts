	{
	    for($i=0;$i<size($poly_names);$i++)
	        $rivet_lohs[$i]=BOVER_10_2_886bd92917571731156a7a071d0dbe98(BOVER_10_2_b25c8b5dbe1b800e5676f04de22544c6($poly_names[$i]));
	    select  $rivet_lohs;
        BOVER_10_2_ac692345fba3e827ad5d6e26de39ba07;
        $range=BOVER_10_2_8658db3767d3086054bf3959e3ff6b41();
        $loh_lock_from_rivet=BOVER_10_2_7f0d6f1fb40a6b860ce559f2fa5a56e5($range);
        BOVER_10_2_3323b46f97bc12510f86536ae21ff525;
        DeleteConstraints;
        delete $rivet_lohs;
	}
	select $loh_lock $loh_lock_from_rivet;
	return `ls-sl`;
}
