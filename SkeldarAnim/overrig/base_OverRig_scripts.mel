global proc string[] BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0()
{
	string $selection[];
	$selection = `ls -fl -os`;
	$selection=BOVER_10_2_6b3d22f4c951fb49c197d50c1803f0cb($selection);
	string $locators[];
	float $getPvPos[];
	string $b[];
	if (size ($selection)>0)
	{
		$j=0;
		for($obj in $selection)
		{
			$getPvPos=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($obj);
			$b=`spaceLocator -p 0 0 0`;
			$locators[$j]=$b[0];
			xform -ws -t $getPvPos[0] $getPvPos[1] $getPvPos[2] $b[0];
			rotate -ws $getPvPos[3] $getPvPos[4] $getPvPos[5]  $b[0];
			$j++;
		}
		select -cl;
		for($obj in $locators)
		{
			select -add $obj;
		}
	}
	else
	{
		$locators = `spaceLocator -p 0 0 0`;
	}
	return $locators;
}
global proc string[] BOVER_10_2_6b3d22f4c951fb49c197d50c1803f0cb(string $objects[])
{
