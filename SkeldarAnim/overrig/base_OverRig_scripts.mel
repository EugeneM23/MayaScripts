		button -ann "set the same keyframe on the allocated time range on selected channels"
					-c "set_key_time_range(\"channelbox\")"
					-w (45)
					-h ($height_small + 2)
					-l "cH"
					bcH;
rowLayout -p "keytool_BOR_clmn_lay_ui" -ebg true -nc 9 ;
	button -ann "select current keyframe or selected framerange"
				-c "selKeys_by_timerange()"
				-w (45)
				-h $height_small
				-l "|<>|"
				bM__M;
	button -ann "delete selected frames on all channel all selected objects"
				-c "delete_keys_from_selected_or_timeslider"
				-w (45)
				-h $height_small
				-l "del"
