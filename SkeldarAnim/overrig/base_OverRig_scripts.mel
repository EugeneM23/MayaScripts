global proc string[] BOVER_10_2_d9af2e6919b9d27514f3d6668ca41211(string $objects[])
{
    string $list_non_locked_and_vis_channels[]={};
    string $curr_attr[];
    for($obj in $objects)
    {
        $curr_attr = `listAttr  $obj`;
        $curr_attr=stringArrayAddPrefix($curr_attr, ($obj + ".") );
        appendStringArray($list_non_locked_and_vis_channels, $curr_attr, size($curr_attr));
    }
    string $list_pair_blend_obj[]={};
    for($ch in $list_non_locked_and_vis_channels)
    {
        catchQuiet($curr_attr =`listConnections -d on -s on -type "pairBlend" $ch`);
        appendStringArray($list_pair_blend_obj, $curr_attr, size($curr_attr));
    }
    $list_pair_blend_obj=stringArrayRemoveDuplicates($list_pair_blend_obj);
    return $list_pair_blend_obj;
}
global proc BOVER_10_2_847308ac6f1debf8edcc8d63e128d64c(string $target_position[], string $object_to_move[])
{
    if(size($target_position)!=size($object_to_move))
		warning "size objects to move is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target_position)> size($object_to_move))
		$target_position=`ls -head (size($object_to_move)) $target_position`;
	float $Trans[];
	for($i=0;$i<size($target_position);$i++)
	{
        $Trans=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($target_position[$i]);
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
		move -rpr $Trans[0] $Trans[1] $Trans[2] $object_to_move[$i];
	}
}
global proc BOVER_10_2_3a25eaad774c71ebdcb06ee4d2b25ce3()
{
	string $objs[] = `ls-sl`;
	for($obj in $objs)
	{
	    if(`objectType -i "joint" $obj`)
	    {
    		if(!`getAttr -lock ($obj + ".jointOrientX")`)
    			setAttr ($obj + ".jointOrientX") 0;
    		if(!`getAttr  -lock ($obj + ".jointOrientY") `)
    			setAttr ($obj + ".jointOrientY") 0;
    		if(!`getAttr  -lock ($obj + ".jointOrientZ")`)
    			setAttr ($obj + ".jointOrientZ") 0;
    	}
	}
}
global proc string[] BOVER_10_2_194c7b09c27128a45486ac17560c7a25(string $objs[])
{
	string $new_selected[];
	$j=0;
	for($i=0;$i<size($objs);$i++)
	{
		if( `objExists $objs[$i]` )
		{
			$new_selected[$j] = $objs[$i];
			$j++;
		}
	}
	select -r $new_selected;
	return $new_selected;
}
global proc float BOVER_10_2_c7822f1f10b007a6803735c105e40799(string $obj1, string $obj2)
{
	float $temp[]=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($obj1);
	vector $point1 = <<$temp[0], $temp[1], $temp[2]>>;
	$temp=BOVER_10_2_8598296823aa3af15686cb0d78f1615d($obj2);
	vector $point2 = <<$temp[0], $temp[1], $temp[2]>>;
	float $lenght=`mag($point1-$point2)`;
	return  $lenght;
}
global proc float[] BOVER_10_2_9bcfe87821f81f923d9a4d502efb9945()
{
    float $time_pref[],$ast,$min,$max,$aet;
    $ast=`playbackOptions -q -ast`;
    $min=`playbackOptions -q -min`;
    $max=`playbackOptions -q -max`;
    $aet=`playbackOptions -q -aet`;
    $time_pref={$ast,$min,$max,$aet};
    return $time_pref;
}
global proc BOVER_10_2_d9f7ba947826f7f00ce2215bc1417109(float $time_pref[])
{
    playbackOptions  -ast $time_pref[0] -min $time_pref[1] -max $time_pref[2] -aet $time_pref[3];
}
global proc string[] BOVER_10_2_fc2f0db118cb44a00adf5c2fa86f649a(string $objects[])
{
    string $shapes[],$shpe[];
    for($obj in  $objects)
    {
        $shpe=BOVER_10_2_5e702211108f11813c411c94f8b1b380($obj);
        appendStringArray( $shapes,$shpe,size($shpe));
    }
    string $locatorShapes[] = `ls -type locator  $shapes`;
    string $locatorTransforms[] = `listRelatives -f -p $locatorShapes`;
    $locatorTransforms=stringArrayRemoveDuplicates($locatorTransforms);
    $locatorTransforms=`ls -fl $locatorTransforms`;
    return  $locatorTransforms;
}
global proc string[] BOVER_10_2_1ed150b12535ee196bee8b74a6bf5f5c(string $objects[], string $obj_type)
{
    string $fin_listing[];
    string $fin_listing_prev[];
    string $shape_type_listing[];
    string $tmp_shapes[];
    string $shapes[];
    for($obj in $objects)
    {
       $tmp_shapes=BOVER_10_2_5e702211108f11813c411c94f8b1b380($obj);
       appendStringArray($shapes,  $tmp_shapes, `size($tmp_shapes)`);
    }
    $j=0;
    for($obj in $shapes)
    {
        if(`objectType $obj`==$obj_type)
        {
          $shape_type_listing[$j] = $obj;
          $j++;
        }
    }
    $j=0;
    if($obj_type!="joint")
    {
        for($obj in $shape_type_listing)
        {
             $fin_listing_prev[$j]=BOVER_10_2_399e6ca23a24d0e48ed5cb872f4729dd($obj);
             $j++;
             $fin_listing=stringArrayRemoveDuplicates ($fin_listing_prev);
        }
    }
	else
       $fin_listing=$shape_type_listing;
    return $fin_listing;
}
global proc string BOVER_10_2_c954f3ebe8232ef721ae19221935b64e(string $take_name)
{
    $i=0;
    while (`objExists $take_name`)
        $take_name=( $take_name + $i);
   return $take_name;
}
global proc BOVER_10_2_95d47209f5832c068ce7614b82201089()
{
	$selection=`ls-sl`;
	$lock_name =` spaceLocator `;
	setKeyframe -at rx -at ry -at rz $lock_name[0];
	$currTime=(`currentTime -q`) -1;
    setKeyframe  -at rx -at ry -at rz -t $currTime;
	string $obj;
	int $rotOrder;
	float $rx,$ry,$rz;
	for($obj in $selection)
	{ 
	    $rotOrder=getAttr($obj + ".rotateOrder");
		$rx=getAttr($obj + ".rx");
		$ry=getAttr($obj + ".ry");
		$rz=getAttr($obj + ".rz");
		setAttr ($lock_name[0] + ".rotateOrder") $rotOrder;
		rotate -a $rx $ry $rz $lock_name[0];
		setKeyframe -at rx -at ry -at rz $lock_name[0];
		filterCurve $lock_name.rotateX $lock_name.rotateY $lock_name.rotateZ;
	    $rx=getAttr($lock_name[0] + ".rx");
		$ry=getAttr($lock_name[0] + ".ry");
		$rz=getAttr($lock_name[0] + ".rz");
		rotate -a $rx $ry $rz $obj;
	}
	delete $lock_name;
	select $selection;
}
global proc BOVER_10_2_5cb0441daec59a79a525bdb749d48438(string $axis)
{
    $axis=`tolower $axis`;
    string $aim_name[];
	string  $jnt[];
	$selection=`ls -l -sl`;
	if(size($selection)<2)
	{
	    warning "select 2 or more joits";
	    return;
	}
	BOVER_10_2_8c16c9163e07a819fc2186f2d338a280(1);
	$childrens=BOVER_10_2_2edf2909df70a7e657b4b646868a0b9c();
	$childrens=`ls -l $childrens`;
	int $have_childrens=0;
	string $ch_locks[];
	string  $par_ch_constrain[];
	if(size($childrens)>0&&($childrens[0]!=$selection[size($selection)-1]))
	{
	    select $childrens;
	    BOVER_10_2_8c16c9163e07a819fc2186f2d338a280(1);
	    $ch_locks=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
	    $par_ch_constrain=BOVER_10_2_17431451b1be026fdeee93b86579c6b6($ch_locks, $childrens);
	    $have_childrens=1;
	}
	select $selection;
	$full_dist=0.0;
	$disst=0.0;
	select -cl;
	$jnt[0]=`joint -p 0 0 0`;
	select -cl;
	for($i=1;$i<size($selection);$i++)
	{
		select -cl;
		$disst = BOVER_10_2_c7822f1f10b007a6803735c105e40799($selection[$i-1],$selection[$i]);
		$full_dist = $full_dist + $disst;
        if($axis=="x")
            $jnt[$i]=`joint -p $full_dist 0 0`;
        if($axis=="y")
            $jnt[$i]=`joint -p 0 $full_dist 0`;
        if($axis=="z")
            $jnt[$i]=`joint -p 0 0 $full_dist`;
        if($axis=="-x")
            $jnt[$i]=`joint -p (-1*$full_dist) 0 0`;
        if($axis=="-y")
            $jnt[$i]=`joint -p 0 (-1*$full_dist) 0`;
        if($axis=="-z")
            $jnt[$i]=`joint -p 0 0 (-1*$full_dist)`;
	}
	select $jnt;
	BOVER_10_2_f0209cb5b5931bdfa7ae6801db19a0f8;
	 select $jnt;
	BOVER_10_2_8c16c9163e07a819fc2186f2d338a280(1);
	select  $selection[0] $jnt[0];
	BOVER_10_2_9713c7abe7f317a1eaefb22b30d9ce1c;
	int $axis_aim[];
	int $axis_up_vector[];
	int $axis_w_up_vector[];
	if($axis=="x")
	{
	   $axis_aim={1,0,0} ;
	   $axis_up_vector={0,0,-1};
	   $axis_w_up_vector={0,1,0};
	}
	if($axis=="y")
    {
	   $axis_aim={0,1,0} ;
	   $axis_up_vector={-1,0,0};
	   $axis_w_up_vector={0,0,1};
	}
	if($axis=="z")
	{
	   $axis_aim={0,0,1} ;
	   $axis_up_vector={0,-1,0};
	   $axis_w_up_vector={1,0,0};
	}
	if($axis=="-x")
	{
	   $axis_aim={-1,0,0} ;
	   $axis_up_vector={0,0,1};
	   $axis_w_up_vector={0,-1,0};
	}
	if($axis=="-y")
	{
	   $axis_aim={0,-1,0} ;
	   $axis_up_vector={1,0,0};
	   $axis_w_up_vector={0,0,-1};
	}
	if($axis=="-z")
	{
	   $axis_aim={0,0,-1} ;
	   $axis_up_vector={0,1,0};
	   $axis_w_up_vector={-1,0,0};
	}
	$cmd="aimConstraint -offset 0 0 0 -weight 1 -aimVector " + $axis_aim[0] + " " + $axis_aim[1] + " " + $axis_aim[2] + " -upVector " + " " + $axis_up_vector[0] + " " + $axis_up_vector[1] + " " + $axis_up_vector[2] + " -worldUpType \"object\" -worldUpVector  " + " " + $axis_w_up_vector[0] + " " + $axis_w_up_vector[1] + " " + $axis_w_up_vector[2] + " -worldUpObject ";
    if(size($selection)>2)
	{
    	for($i=0;$i<size($jnt)-2;$i++)
    	{
            $aim_name=eval ($cmd + $selection[$i+2] + " " +  $selection[$i+1] + " " + $jnt[$i]);
            delete $aim_name;
    	}
        $aim_name=eval ($cmd +  $selection[$i+1]  + " " +   $selection[$i+1] + " " +   $jnt[$i]);
        delete $aim_name;
    }
    if(size($selection)==2)
	{
         $aim_name=eval ($cmd +  $selection[1]   + " " +   $selection[1]  + " " +   $jnt[0]);
    	delete $aim_name;
	}
	select $selection;
	BOVER_10_2_3a25eaad774c71ebdcb06ee4d2b25ce3;
	BOVER_10_2_9a3ce25cfdbc96f0053e2e03715d7f2b;
	catch(`BOVER_10_2_41b4e3b470ec48427b6ebd4f09a607e7`);
	BOVER_10_2_5e8af8371c687e5c50d7ded5040ffe13($jnt, $selection);
	BOVER_10_2_95d47209f5832c068ce7614b82201089();
	delete $jnt;
	if($have_childrens)
	{
	    delete  $par_ch_constrain;
	    delete $ch_locks;
	}
}
global proc BOVER_10_2_5cca387e40527d14dd0862d275b6a5fc(string $j_chain[], string $axis, string $sao_napr, string $ch_up)
{
    float $sao_napr_angle=0;
    if($sao_napr=="down")
    {
         $sao_napr_angle=180;
    }
    float $ch_angle=0;
    if($ch_up=="change")
    {
         $ch_angle=180;
    }
    $selected=$j_chain;
    select $selected[0];
	    string $or;
        string $up;
        string $aim_V;
        string $up_v;
    if($axis=="x"||$axis=="-x")
    {
	    $or="xyz";
        $up="x" +  $sao_napr;
        $aim_V=" 0 -1 0 ";
        $up_v=" 0 0 1 ";
    }
    if($axis=="y"||$axis=="-y")
    {
        $or="yzx";
        $up="y" +  $sao_napr;
        $aim_V=" 0 0 -1 ";
        $up_v=" 1 0 0 ";
    }
    if($axis=="z"||$axis=="-z")
    {
        $or="zxy";
        $up="z" +  $sao_napr;
        $aim_V=" -1 0 0 ";
        $up_v=" 0 1 0 ";
    }
	$locks_for_aim=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
	select $selected;
	$max_dist=BOVER_10_2_18a895830f3c7ec611ca2fbd58e5730f(1);
	float $diist=$max_dist[2];
	vector $coords[]=BOVER_10_2_72356eaf232b169651a82383ba9e7e57($selected);
	int $ind=BOVER_10_2_b370e1f695c58fe83552587a1fd52907($coords);
    string $aim_name[];
    string $cmd;
    if ($sao_napr=="up")
        $cmd="aimConstraint -offset 0 0 0 -weight 1 -aimVector " + $aim_V + " -upVector " + $up_v + "-worldUpType \"object\" -worldUpObject " +  $selected[$ind] + " "  + $selected[size($selected)-1] + " "  + $locks_for_aim[0];
    else
        $cmd="aimConstraint -offset 0 0 0 -weight 1 -aimVector " + $up_v  + " -upVector " + $aim_V + "-worldUpType \"object\" -worldUpObject " +  $selected[$ind] + " "  + $selected[size($selected)-1] + " "  + $locks_for_aim[0];
	$aim_name =eval($cmd);
	delete $aim_name;
    $locks_true_position=`duplicate $locks_for_aim`;
	$ori_cstr=`orientConstraint -mo -weight 1 $locks_for_aim $selected[0]`;
	if($sao_napr=="up")
	    rotate -a 0 0 0  $locks_for_aim;
	    else
	    rotate -a 90 90 0  $locks_for_aim;
	delete 	$ori_cstr;
	select $selected;
	makeIdentity -apply true -t 0 -r 1 -s 0 -n 0 -pn 1;
    joint -e  -oj $or -secondaryAxisOrient $up;
    $childrens=`listRelatives -f -c -typ "joint" $selected[size($selected)-1]`;
    if (size($childrens)==0)
    {
    	setAttr ($selected[size($selected)-1] + ".jointOrientX") 0;
        setAttr ($selected[size($selected)-1] + ".jointOrientY") 0;
        setAttr ($selected[size($selected)-1] + ".jointOrientZ") 0;
    }
    $ori_cstr=`orientConstraint -mo -weight 1   $locks_for_aim $selected[0]`;
    select $locks_true_position $locks_for_aim;
    BOVER_10_2_9a8d2e62249cad27916aacc736478655();
    delete 	$ori_cstr;
    delete $locks_for_aim  $locks_true_position;
    select $selected;
    BOVER_10_2_a2b81a3977941c0eac1cda769570172c();
    if($axis=="x")
    {
        rotate -r -os -fo ($ch_angle) 0 0 ;
    }
    if($axis=="y")
    {
        rotate -r -os -fo 0 ($ch_angle) 0 ;
    }
    if($axis=="z")
    {
        rotate -r -os -fo 0 0 ($ch_angle) ;
    }
    if($axis=="-x")
    {
        rotate -r -os -fo ($ch_angle-$sao_napr_angle) 0 180 ;
    }
    if($axis=="-y")
    {
        rotate -r -os -fo 180 ($ch_angle-$sao_napr_angle) 0 ;
    }
    if($axis=="-z")
    {
        rotate -r -os -fo 0 180 ($ch_angle-$sao_napr_angle) ;
    }
    BOVER_10_2_f0209cb5b5931bdfa7ae6801db19a0f8();
    select -cl;
    select $selected;
}
global proc BOVER_10_2_a9acebc46d5277d92e6d954501ac53c7(string $axis,  string $sao_napr, string $ch_up)
{
    $axis=`tolower $axis`;
    $selection=`ls-sl`;
    BOVER_10_2_8c16c9163e07a819fc2186f2d338a280(1);
    $kk=size($selection);
    if($kk<2)
    {
        warning "select 2 or more joint";
        return;
    }
    $childrens=BOVER_10_2_2edf2909df70a7e657b4b646868a0b9c();
    int $have_childrens=0;
	string $ch_locks[];
	string  $par_ch_constrain[];
    if(size($childrens)>0)
    {
        select $childrens;
	    BOVER_10_2_8c16c9163e07a819fc2186f2d338a280(1);
	    $ch_locks=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
	    $par_ch_constrain=BOVER_10_2_17431451b1be026fdeee93b86579c6b6($ch_locks, $childrens);
	    $have_childrens=1;
	    select $selection;
    }
    if(size($childrens)==1)
    {
	    select $selection $childrens;
    }
    $sec_joints=BOVER_10_2_f2d5a2798ed7cfee36eb77ee8a281ed8();
    $sec_joints2=`ls-head (size($sec_joints)-1) $sec_joints`;
    if(size($childrens)==1)
    {
	    select   $sec_joints2;
    }
	BOVER_10_2_5cca387e40527d14dd0862d275b6a5fc(`ls-sl`, $axis, $sao_napr, $ch_up);
    select  $sec_joints;
    $lock=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
    $constr=BOVER_10_2_c99bdb5a898efbfb1d4fa2221eba881b($lock,$sec_joints);
    select -cl;
    select $sec_joints;
    BOVER_10_2_3a25eaad774c71ebdcb06ee4d2b25ce3;
    delete $constr;
    delete $lock;
    BOVER_10_2_95d47209f5832c068ce7614b82201089();
    if(size($childrens)==1)
    {
	    $sec_joints=`ls -head ($kk)  $sec_joints`;
    }
    BOVER_10_2_5e8af8371c687e5c50d7ded5040ffe13($sec_joints, $selection);
    delete $sec_joints;
    select $selection;
    if($have_childrens)
	{
	    delete  $par_ch_constrain;
	    delete $ch_locks;
	}
}
global proc string[] BOVER_10_2_18a895830f3c7ec611ca2fbd58e5730f(int $min_max)
{
	$selection=`ls-fl-sl`;
	$TotSize = `size $selection`;
	string $return_pair[];
	float $pi[] = `xform -ws -q -t $selection[0]`;
	float $pj[] = `xform -ws -q -t $selection[1]`;
	float $maxdist = `mag(<<$pi[0],$pi[1],$pi[2]>> - <<$pj[0],$pj[1],$pj[2]>>)`;
	float $distance=$maxdist;
	int $found=0;
	for ($i=0;$i<$TotSize-1;$i++)
	{
		for ($j=$i+1; $j<$TotSize; $j++)
		{
			$pi = `xform -ws -q -t $selection[$i]`;
			$pj = `xform -ws -q -t $selection[$j]`;
			$distance = `mag(<<$pi[0],$pi[1],$pi[2]>>-<<$pj[0],$pj[1],$pj[2]>>)`;
			if($min_max==1)
			{
				if ($distance > $maxdist || $found==0)
				{
				    $found=1;
					$maxdist = $distance;
					$return_pair[0]=$selection[$i];
					$return_pair[1]=$selection[$j];
					$return_pair[2]=$maxdist;
				}
			}
			if($min_max==0)
			{
				if ($distance <= $maxdist || $found==0)
				{
					$found=1;
					$maxdist = $distance;
					$return_pair[0]=$selection[$i];
					$return_pair[1]=$selection[$j];
					$return_pair[2]=$maxdist;
				}
			}
		}
	}
return $return_pair;
}
global proc BOVER_10_2_d1f6eb5ab8caa780647f498704025cf1()
{
    $selection=`ls-l-sl`;
    $b_lock=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
    string  $locks[];
    string  $constr[];
    $constr_point=BOVER_10_2_4a0278149f801323f33f7bb9e4ee597d($b_lock, $selection);
    select $selection;
    $children=BOVER_10_2_2edf2909df70a7e657b4b646868a0b9c();
    if(size($children)>0)
    {
        select $children;
        $locks=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
        $constr=BOVER_10_2_17431451b1be026fdeee93b86579c6b6($locks, $children);
    }
    select $selection;
    catchQuiet (`BOVER_10_2_3a25eaad774c71ebdcb06ee4d2b25ce3`);
    BOVER_10_2_9a3ce25cfdbc96f0053e2e03715d7f2b;
    catchQuiet (`delete $constr_point $constr`);
    catchQuiet (`delete $locks $b_lock`);
}
global proc string[] BOVER_10_2_e34225338b41391d68d09634ca599397(int $return_scene_like_first)
{
    $selection=`ls-l-sl`;
    string $parents[];
    string $tmp[];
    $i=0;
    string $s_selection[];
    for($obj in  $selection)
    {
        $s_selection[$i]=$selection[$i];
        $tmp=`listRelatives -f  -p $obj`;
        $parents[$i]= $tmp[0];
        if (size($tmp)==0&&$return_scene_like_first==0)
        {
            $parents[$i]="";
        }
        if (size($tmp)==0&&$return_scene_like_first==1)
        {
            $parents[$i]=$obj;
            $s_selection[$i]="";
        }
        $i++;
    }
    $diff = stringArrayRemove($s_selection, $parents);
    $diff =`ls-fl $diff`;
    return $diff;
}
global proc string[] BOVER_10_2_a2b81a3977941c0eac1cda769570172c()
{
    string $uuid_selection[] = `ls -uuid -sl`;
    string $selection[]=`ls-sl`;
    string $fin_names[];
    string $joint_uid[]={};
    string $rootj,$uuid_root[];
    string $in_place_tmp_j;
    for($uid in $uuid_selection)
    {
        $tmppp=`ls -uuid $uid `;
        if(objectType($tmppp[0])=="joint")
            appendStringArray($joint_uid,{$uid},1);
        else
            catchQuiet( `parent -w $tmppp[0]`);
    }
    for($uid in $joint_uid)
    {
        $tmppp=`ls -uuid $uid `;
        select $tmppp;
        $rootj=BOVER_10_2_933d4aecbe9d9d0ce9a6591c5b2e3770($tmppp[0]);
        $uuid_root=`ls -uuid $rootj`;
        if($uuid_root[0]!= $uid)
        {
            $tmp_j=`joint`;
            $in_place_tmp_j=`disconnectJoint  $tmppp[0]`;
            delete $tmp_j  $in_place_tmp_j;
        }
        else
            catchQuiet( `parent -w $tmppp[0]`);
    }
    $fin_names=`ls -uuid $uuid_selection`;
    select -cl;
    select $fin_names;
    return $fin_names ;
}
