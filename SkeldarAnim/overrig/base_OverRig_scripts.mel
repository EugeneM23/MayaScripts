				-l ">=3 to IK "
				bJto3IK;
		nodeIconButton -style "iconAndTextHorizontal"
		-image1 "nudgeDown.png"
		-ann "bake selected  objects to IK spline proportional system."
				-w 68
				-h $ikh
 				-c "apply_objects_spline_IK(1)"
				-l "spline"
				bIKspl_dep;
				popupMenu -button 3 -parent bIKspl_dep;
					menuItem -label "Spline individual" -ann "bake selected  objects to IK spline each individual system" -command "apply_objects_spline_IK(1)";
		button -ann "bake selected  objects bake to ribbon system."
 				-c "apply_bake_to_ribbon_system(1,0.3)"
				-w 59
