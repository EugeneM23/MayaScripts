	string $name_loc[]=BOVER_10_2_95aedc626a621231a66a091788483a9e( $selected_curve[0], 1);
	string $attribname,$node_name;
	$node_name=`createNode blindDataTemplate -n "anim_movement_on_curve_tool_sequent_control"`;
	$attribname=BOVER_10_2_65107bc37ea4a0d842be293fd78287a9("curve", $node_name);
    connectAttr -f ($selected_curve[0] + ".visibility")   $attribname;
	for($i=1;$i<size($name_loc);$i++)
	{
		$attribname=BOVER_10_2_65107bc37ea4a0d842be293fd78287a9(("loc" + $i), $node_name);
		connectAttr -f ($name_loc[$i] + ".visibility")   $attribname;
	}
    $attribname=BOVER_10_2_65107bc37ea4a0d842be293fd78287a9("base_sequent_loc", $node_name);
    connectAttr -f ($name_loc[0] + ".visibility")   $attribname;
    float $all_dist=BOVER_10_2_a358a7c27f7a7b80712d695138ed032e ($name_loc,1);
	select $name_loc;
	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(22);
	BOVER_10_2_29941243f77aa0343e79460d48136072 ($all_dist/4.0);
	$WBend_curve_control=BOVER_10_2_e706e982298fe9e8f94ae04b06b5d6b2("WB_CTRL");
	currentUnit  -l $maya_unit;
	return $WBend_curve_control;
}
global proc float[] BOVER_10_2_78b3badf5e21d9d0f6a0516171924096 (string $objects[], string $type_of_slider)
{
    float $min_range,$max_range;
    if($type_of_slider=="all")
    {
        $min_range=`playbackOptions -q -ast`;
        $max_range=`playbackOptions -q -aet`;
    }
        if($type_of_slider=="small")
    {
        $min_range=`playbackOptions -q -min`;
        $max_range=`playbackOptions -q -max`;
    }
    float $all_times[]=`keyframe -time ($min_range + ":" + $max_range) -query $objects`;
    $all_times=BOVER_10_2_d5923f3b930977b80f15c7f80da04844($all_times, 1);
    return $all_times;
}
global proc float BOVER_10_2_b970808d076db3299a05dc858ee1a1e0(float $frame1, float $frame2, string $curve_name)
{
    float $fr[]=`keyframe  -t($frame1 + ":" +  $frame2) -q $curve_name`;
    if($fr[0]!=$frame1)
        floatArrayInsertAtIndex(0, $fr, $frame1);
    if($fr[size($fr)-1]!=$frame2)
        floatArrayInsertAtIndex(size($fr), $fr, $frame2);
    float $promejutok[]=BOVER_10_2_7145e62c24cf62d609b928973d8456c7($fr, 0,1);
    int $index=$promejutok[0];
    float $half_len=$promejutok[1]/2;
    float $rand_delta =`rand 0 $half_len` - $half_len/2;
    float $fin_frame=$fr[$index] + $promejutok[1]/2 + $rand_delta;
    return  $fin_frame;
}
global proc string[] BOVER_10_2_719a69b0631e3563f3cad27518625416(float $keys_for_delete[])
{
	string $promejutki[];
	$k = 0;
	$i = 0;
	clear $promejutki;
	while ($i<size($keys_for_delete))
	{
		$start_frame=$keys_for_delete[$i];
		$j = $i;
		$pos = 0;
		do
		{
			$pos = $pos + 1;
			$j = $j + 1;
		} while ($j < size($keys_for_delete) && $keys_for_delete[$j] == $start_frame + $pos);
		$promejutki[$k]=($start_frame + ":" + $keys_for_delete[$j - 1]);
		$k++;
		$i = $j;
	}
    return $promejutki;
}
global proc BOVER_10_2_419ebd630d5f306b0e072ae65d2736e8(float $side, float $poseBias)
{
