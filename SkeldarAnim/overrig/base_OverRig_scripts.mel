global proc BOVER_10_2_13f67b1447d1fe0d15313a69cb76f8e6(string $target_position[], string $object_to_move[])
{
	int $lock_rot[];
	int $lock_trans[];
	for($i=0;$i<size($target_position);$i++)
	{
		$Rot = `getAttr ($target_position[$i] + ".rotate")`;
		$Trans = `getAttr ($target_position[$i] + ".translate")`;
		$lock_rot[0] = `getAttr -l ($object_to_move[$i] + ".rotateX")`;
		$lock_rot[1] = `getAttr -l ($object_to_move[$i] + ".rotateY")`;
		$lock_rot[2] = `getAttr -l ($object_to_move[$i] + ".rotateZ")`;
		$lock_trans[0] = `getAttr -l ($object_to_move[$i] + ".translateX")`;
		$lock_trans[1] = `getAttr -l ($object_to_move[$i] + ".translateY")`;
		$lock_trans[2] = `getAttr -l ($object_to_move[$i] + ".translateZ")`;
		if(!$lock_rot[0])
            setAttr ($object_to_move[$i] + ".rotateX")  $Rot[0];
		if(!$lock_rot[1])
            setAttr ($object_to_move[$i] + ".rotateY")  $Rot[1];
		if(!$lock_rot[2])
            setAttr ($object_to_move[$i] + ".rotateZ")  $Rot[2];
		if(!$lock_trans[0])
            setAttr ($object_to_move[$i] + ".translateX") $Trans[0];
        if(!$lock_trans[1])
            setAttr ($object_to_move[$i] + ".translateY") $Trans[1];
        if(!$lock_trans[2])
            setAttr ($object_to_move[$i] + ".translateZ") $Trans[2];
	}
}
global proc float[] BOVER_10_2_9713c7abe7f317a1eaefb22b30d9ce1c()
{
	string $obj[]=`ls-sl`;
	float $distance[];
	float $pos1[];
	float $pos2[];
	if(size($obj)<2)
	{
		warning "Select 2 object!";
		return $pos1;
	}
	else
	{
		$pos1=`xform -q  -ws -piv $obj[0]`;
		$pos2=`xform -q  -ws -piv $obj[1]`;
		for($i=0;$i<3;$i++)
			$distance[$i]=$pos1[$i]-$pos2[$i];
	}
	if (size($obj) == 2)
	{
		move -rpr $pos1[0] $pos1[1] $pos1[2] $obj[1];
		move -rpr $pos1[0] $pos1[1] $pos1[2] $obj[1];
		move -rpr $pos1[0] $pos1[1] $pos1[2] $obj[1];
		return $pos1;
	}
	if (size($obj) > 2)
	{
		$range=size($obj)-1;
		$x=$distance[0]/$range;
		$y=$distance[1]/$range;
		$z=$distance[2]/$range;
		for($i=2;$i<size($obj);$i++)
		{
		   move -rpr ($pos1[0] - $x*($i-1)) ($pos1[1] - $y*($i-1)) ($pos1[2] - $z*($i-1)) $obj[$i];
		   move -rpr ($pos1[0] - $x*($i-1)) ($pos1[1] - $y*($i-1)) ($pos1[2] - $z*($i-1)) $obj[$i];
		   move -rpr ($pos1[0] - $x*($i-1)) ($pos1[1] - $y*($i-1)) ($pos1[2] - $z*($i-1)) $obj[$i];
		}
		return $pos1;
	}
}
global proc BOVER_10_2_41b4e3b470ec48427b6ebd4f09a607e7()
{
	string $objs[] = `ls-sl`;
	for($obj in $objs)
