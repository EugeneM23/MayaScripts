global proc string[] BOVER_10_2_f0209cb5b5931bdfa7ae6801db19a0f8 ()
{
	string $uid_objs[]=`ls -uuid -sl`;
    string $curr_objs[];
    string $fin_objs[];
	string $group[];
	string $transform_grpp[];
	string $tmpp[]=BOVER_10_2_a2b81a3977941c0eac1cda769570172c();;
	for ($i=0; $i<(size($uid_objs)-1);$i++)
	{
	    $curr_objs=`ls -uuid {$uid_objs[$i+1],$uid_objs[$i]}`;
        if(objectType($curr_objs[0])=="joint" && objectType($curr_objs[1])=="joint")
        {
			select $curr_objs[0];
			$group=BOVER_10_2_e34225338b41391d68d09634ca599397(1);
			$transform_grpp=stringArrayRemove($tmpp,$group);
			$curr_objs=`ls -uuid {$uid_objs[$i+1],$uid_objs[$i]}`;
			connectJoint -pm $curr_objs[0] $curr_objs[1];
			catchQuiet(`delete $transform_grpp`);
        }
        else
             catchQuiet (`parent $curr_objs[0] $curr_objs[1]`);
	}
    $fin_objs=`ls -uuid $uid_objs`;
	select -cl;
	select $fin_objs;
	return $fin_objs;
}
global proc string[] BOVER_10_2_d68451d42d330e385dd0c090bd6877a0(string $prefix)
{
    string $uuids[]=`ls -uuid-sl`;
    string $curr_obj[], $short_name, $fin_obj[];
	for($uid in $uuids)
	{
	     $curr_obj=`ls  -l -uuid $uid`;
	     $short_name= `match "[^|\\]*$"$curr_obj[0]`;
	     rename $curr_obj[0] ($prefix +  $short_name);
	 }
	 $fin_obj= `ls  -uuid $uuids`;
	 select -cl;
	 select -r $fin_obj;
	 return $fin_obj;
}
global proc int[] BOVER_10_2_8dcf27adae2f0cd4520378fd7044ea43(float $fl_array[], int $sorting ,int $remove_duplicates)
{
    int $output_int[];
    for($i=0;$i<size($fl_array);$i++)
       $output_int[$i] =$fl_array[$i];
    if($sorting)
        $output_int=sort($output_int);
    string $tmp_str[];
    if($remove_duplicates)
    {
       for($i=0;$i<size($output_int);$i++)
           $tmp_str[$i]=$output_int[$i];
       $tmp_str=stringArrayRemoveDuplicates($tmp_str);
       $output_int={};
       for($i=0;$i<size($tmp_str);$i++)
           $output_int[$i]=$tmp_str[$i];
    }
    return $output_int;
}
