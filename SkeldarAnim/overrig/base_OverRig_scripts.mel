global proc string[] BOVER_10_2_7f0d6f1fb40a6b860ce559f2fa5a56e5(float $range[])
{
    global int $barnev_OverRig_RotateOrder;
	string $selected[]=`ls-fl-sl`;
	string $selected_short[]=`ls-sn-sl`;
	if(size($selected)<=0)
	{
		warning "Nothing selected!";
		return {""};
	}
	$locators=`BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0`;
	if($barnev_OverRig_RotateOrder==6)
	    BOVER_10_2_d1b73d0512bac8d20998bdbab9b3aed7($selected, $locators);
	else
	    BOVER_10_2_d04a25c84de52f4787d68215d32315e0($barnev_OverRig_RotateOrder,$locators);
	catchQuiet(delete(BOVER_10_2_ac2021d0d7ff3ecfad4dbca9f9f88248($selected,$locators)));
	$locators=BOVER_10_2_c9088e941b7677113499bb19ad80f9bf ("LOH_", $selected_short);
    BOVER_10_2_17431451b1be026fdeee93b86579c6b6($selected, $locators);
    BOVER_10_2_e02b9af8de573969d2834f5d4e4228fd($range[0],$range[1],$locators);
	return $locators;
}
global proc string[] BOVER_10_2_07739a1aa5203222338cc34f38597dfb()
{
	$selected=`ls-fl-sl`;
	float $range[]=BOVER_10_2_8658db3767d3086054bf3959e3ff6b41();
	if(size($selected)<=0)
	{
		warning "Nothing selected!";
		return {""};
	}
	$locators=`BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0`;
	BOVER_10_2_9a3ce25cfdbc96f0053e2e03715d7f2b;
    BOVER_10_2_ade4e354383a28fcefcaf5ce40e6639d;
    BOVER_10_2_aa074854107180f09880ea0e8edd43f8;
    BOVER_10_2_b6a5017ee305f5ba0bbf3116243cc3af;
	setKeyframe  $locators;
	$locators=BOVER_10_2_e706e982298fe9e8f94ae04b06b5d6b2("LOH");
    $time=`currentTime -q`;
    autoKeyframe -st 0;
    for($i=$range[0];$i<=$range[1];$i++)
    {
        currentTime $i;
        BOVER_10_2_847308ac6f1debf8edcc8d63e128d64c($selected, $locators);
        setKeyframe  $locators;
    }
    autoKeyframe -st 1;
	currentTime $time;
	BOVER_10_2_b0a1523d18ddbfe3c562938d09574284;
	return $locators;
}
global proc string[] BOVER_10_2_efa506dac98c500c953a9760e84a8672 (string $target[], string $object[])
{
    if(size($target)!=size($object))
		warning "size parent massives is DIFFERENT!!! Only relevant objects will be processed! This can lead to unexpected consequences!!!!";
	if(size($target)> size($object))
		$target=`ls -head (size($object)) $target`;
    string $curr_objs[];
    string $fin_objs[];
    for($i=0;$i<size($target);$i++)
    {
        catchQuiet (`parent  $object[$i] $target[$i]`);
    }
    $fin_objs=`ls $object`;
	select -cl;
	select $fin_objs;
	return $fin_objs;
}
global proc BOVER_10_2_70e1c4b7692160ed48aa4962be320af3 (string $joints[], int $lock_status)
