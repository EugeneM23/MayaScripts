	BOVER_10_2_c89bf830cdb2b9cc874e6c8604e8b257;
	BOVER_10_2_1f3f21e017b74355329202016bf1b177;
	BOVER_10_2_92de112c5c170c44ad9daf4d48b1acdd($spine_lenght*0.3);
	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(13);
	string $start_end_point_lock[];
	if (!$continuation_of_chain)
	{
		select  $start_point $end_point;
		if($orient_order)
			$start_end_point_lock = BOVER_10_2_24abb2efaf063b9b16a2b2c78969a384();
		else
			$start_end_point_lock = BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
		$start_end_point_lock = BOVER_10_2_10b1c67feba7e9570357d44ba9306692 ("", {"Pelvis","Chest"},"_ctr");
	}
	else
	{
		select  $end_point;
		if($orient_order)
			$start_end_point_lock = BOVER_10_2_24abb2efaf063b9b16a2b2c78969a384();
		else
			$start_end_point_lock = BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
		$start_end_point_lock = BOVER_10_2_10b1c67feba7e9570357d44ba9306692 ("", {"Head","Head"},"_ctr");
		$start_end_point_lock[1]=$start_end_point_lock[0];
		$start_end_point_lock[0]=$start_point;
	}
	string $null_group_name=`group -absolute -empty -name "main"`;
	if(`upAxis -q -axis`=="y")
		setAttr ($null_group_name + ".rx") -90;
string $side_lock[];
	if (!$continuation_of_chain)
            parent  $start_end_point_lock $mid_gr_name $null_group_name;
