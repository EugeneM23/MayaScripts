	expression -e -s "float $len_coeff = .I[0];\nfloat $leng_base=.I[1];\nfloat $len1=.I[2];\nfloat $len2=.I[3];\nfloat $soft_start_alpha=90*.I[4];\nfloat $full_straight_coeff=.I[5];\nfloat $scale_coeff= 1-.I[6];\nfloat $predel= ($len1 + $len2)/2 *.I[7]  ;\n\n$leg_len=($len1 + $len2);\n$delta_len=$leg_len*$len_coeff;\n$full_leg_len_f=$leg_len+$delta_len;\n$full_leg_len=$leg_len+$delta_len*$full_straight_coeff;\nfloat $cos_a= clamp(-1,1,($len1*$len1 + $leng_base*$leng_base  -  $len2*$len2)/(2 *$len1*$leng_base));\n$alpha = acosd($cos_a);\n$knee_positionX =$len1*$cos_a;\n$knee_positionY =$len1*sind ($alpha);\n\n$over_dist=   $leng_base-$leg_len;\n$feet_pos=clamp (0, $full_leg_len_f, $leng_base);\nif($len_coeff>0&&$over_dist>0)\n{\n\t$proport=$len1/$leg_len;\n\t$knee_positionX=$feet_pos*$proport;\n}\n$soft_start_positionY =$len1*sind ($soft_start_alpha);\n$first_katet =$len1*cosd ($soft_start_alpha);\n$second_katet=sqrt($len2*$len2 - $soft_start_positionY*$soft_start_positionY);\n$soft_base_len=$first_katet+$second_katet;\nfloat $soft_knee_pivotY ;\nfloat $soft_scale_range;\n\n\tif($soft_start_positionY <= $knee_positionY)\n\t{\n\t\t$soft_knee_pivotY=$knee_positionY;\n\t\t$soft_scale_range=1;\n\t}\n\telse\n\t{\n\t\t$soft_knee_pivotY = $soft_start_positionY;\n\t\t$soft_clamp_range= 1-($soft_base_len-clamp ($soft_base_len, $full_leg_len, $leng_base))/($soft_base_len-$full_leg_len);\n\t\t$soft_scale_range= 1-$scale_coeff + $scale_coeff*(1-($soft_base_len-clamp ($soft_base_len, $full_leg_len_f, $leng_base))/($soft_base_len-$full_leg_len_f)) ;\n\t\t$soft_knee_pivotY=$soft_start_positionY* $soft_clamp_range ;\n\t}\nif($soft_knee_pivotY< $predel)\n\t$soft_knee_pivotY= $predel;\n.O[0]=$knee_positionX;\n.O[1]=$feet_pos;\n.O[2]=$soft_knee_pivotY;\n.O[3]=$soft_scale_range;"  -o "" -ae 1 -uc all $expression1;
	string $multiplyDivide1=`createNode multiplyDivide -n "multiplyDivide1#"`;
		setAttr ".op" 0;
	connectAttr ($multiplyDivide1 + ".i1x") ($fin_jnt1_scale + ".sy")   ;
	connectAttr ($multiplyDivide1 + ".i1x") ($fin_jnt1_scale + ".sz")   ;
	connectAttr ($multiplyDivide1 + ".i1x") ($fin_jnt2_scale + ".sy")  ;
	connectAttr ($multiplyDivide1 + ".i1x") ($fin_jnt2_scale + ".sz")   ;
	connectAttr ($strech_ik_foot + ".show_scale") ($fin_jnt1 + ".v")  ;
	connectAttr ($fin_jnt1 + ".s") ($fin_jnt1_end + ".is");
	connectAttr ($strech_ik_foot + ".show_scale") ($fin_jnt1_scale + ".v")  ;
	connectAttr ($strech_ik_foot + ".show_scale") ($fin_jnt2 + ".v")  ;
	connectAttr ($fin_jnt2 + ".s") ($fin_jnt3 + ".is");
	string $strech_ik_foot_pointConstraint[] =`pointConstraint -offset 0 0 0 -skip y -skip z -weight 1 $strech_ik_foot $leng_base`;
	string $fin_j2_pointConstraint[] =`pointConstraint -offset 0 0 0  -weight 1 $knee_ctrl $fin_jnt2 `;
	string $fin_j3_pointConstraint[] =`pointConstraint -offset 0 0 0  -weight 1  $pivot_feet $fin_jnt3 `;
	string $fin_jnt1_aimConstraint[] =`aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "objectrotation" -worldUpVector 0 1 0 -worldUpObject $base_IK_strech  $knee_ctrl $fin_jnt1`;
	string $fin_jnt2_aimConstraint[] =`aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "objectrotation" -worldUpVector 0 1 0 -worldUpObject $base_IK_strech  $leng_base $fin_jnt2`;
	string $base_IK_strech_aimConstraint[] =`aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject $strech_ik_knee $strech_ik_foot $base_IK_strech`;
	string $fin_j1_end_pointConstraint[] =`pointConstraint -offset 0 0 0 -weight 1 $knee_ctrl $fin_jnt1_end`;
	connectAttr ($expression1 + ".out[3]") ($multiplyDivide1 + ".i1x");
	connectAttr ($expression1 + ".out[1]") ($pivot_feet + ".tx")  ;
	connectAttr ($expression1 + ".out[0]") ($soft_knee_gr + ".tx")  ;
	connectAttr ($expression1 + ".out[2]") ($soft_knee_gr + ".ty")  ;
	connectAttr ($strech_ik_foot + ".lenght_coeff") ($expression1 + ".in[0]");
	connectAttr ($leng_base + ".tx") ($expression1 + ".in[1]");
	connectAttr ($strech_ik_foot + ".lenght_joint_1") ($expression1 + ".in[2]");
	connectAttr ($strech_ik_foot + ".lenght_joint_2") ($expression1 + ".in[3]");
	connectAttr ($strech_ik_foot + ".softness") ($expression1 + ".in[4]");
	connectAttr ($strech_ik_foot + ".full_straight_coeff") ($expression1 + ".in[5]");
	connectAttr ($strech_ik_foot + ".scale_coeff") ($expression1 + ".in[6]");
	connectAttr ($strech_ik_foot + ".bend_limit") ($expression1 + ".in[7]");
	setAttr  ($expression1 +".nodeState") 0;
	select $pivot_feet $leng_base;
	BOVER_10_2_e8fab4220afb7ebae48fab83681f71a5(0);
	BOVER_10_2_e9a3d5ffe283044f2485219b12ac5f73({$pivot_feet,$leng_base,$strech_ik_foot_pointConstraint[0],$fin_j2_pointConstraint[0],$fin_j3_pointConstraint[0],$fin_jnt1_aimConstraint[0],$fin_jnt2_aimConstraint[0],$base_IK_strech_aimConstraint[0],$fin_j1_end_pointConstraint[0]}, 1);
	BOVER_10_2_90a059e9200ad500213586e0ecabdd0d({$leng_base,$pivot_feet,$soft_knee_gr,$fin_jnt1,$fin_jnt1_end,$fin_jnt2_scale,$fin_jnt2,$fin_jnt3,$fin_jnt2_scale}, 1, 1,1,1);
	BOVER_10_2_90a059e9200ad500213586e0ecabdd0d({$strech_ik_foot}, 0, 0,1,1);
	BOVER_10_2_90a059e9200ad500213586e0ecabdd0d({$strech_ik_knee,$knee_ctrl}, 0, 1,1,1);
	return {$base_IK_strech,$strech_ik_foot,$strech_ik_knee,$knee_ctrl,$fin_jnt1,$fin_jnt2,$fin_jnt3,$fin_jnt1_scale,$fin_jnt2_scale};
}
global proc string  BOVER_10_2_933d4aecbe9d9d0ce9a6591c5b2e3770(string $jnt)
{
    string $selected[]=`ls -l $jnt`;
    string $buffer[];
    string $root;
    $buffer=BOVER_10_2_465f2c70f8e4bf417e93834f61ee4f6e($selected[0], "|");
    string $var[]={};
    for($i=1;$i<size($buffer);$i++)
        $var[$i]=$var[$i-1]+"|"+$buffer[$i];
    for($i=1;$i<size($var);$i++)
    {
        if(`objectType $var[$i]`=="joint")
        {
            $root=$var[$i];
            break;
        }
    }
    return $root;
}
global proc float BOVER_10_2_a358a7c27f7a7b80712d695138ed032e(string $objects[], int $average)
{
    float $distance;
    for($i=0;$i<size($objects)-1;$i++)
        $distance=$distance + BOVER_10_2_c7822f1f10b007a6803735c105e40799($objects[$i] , $objects[$i+1]);
    if($average)
         $distance=$distance/(size($objects)-1);
    return $distance;
}
global proc int BOVER_10_2_b370e1f695c58fe83552587a1fd52907(vector $coords[])
{
	$num=size($coords);
	$posA= $coords[0];
	$posB=$coords[$num-1];
	float $dists[];
	for($i=1;$i<$num-1;$i++)
	{
		$dists[$i]=BOVER_10_2_476390711655739e4d4919b7f7336b00($posA,$posB,$coords[$i]);
	}
	$index=BOVER_10_2_d0a0b515ba819d3c77adb0bbe48cfd1d( $dists,1);
	return $index;
}
global proc int BOVER_10_2_d0a0b515ba819d3c77adb0bbe48cfd1d(float $massive[],int $min_max)
{
    $num=`size $massive`;
    int $number;
    string $str_ind_massive[];
    string $buffer[];
    for($i=0;$i<$num;$i++)
    {
        $str_ind_massive[$i]=$massive[$i] + ";" + $i;
    }
     $massive=`sort  $massive`;
     float $znach=$massive[0];
     if($min_max==1)
     {
	     if($num>0)
            $znach=$massive[$num-1];
         else
            $znach=$massive[$num];
     }
     string $obj;
     for($obj in $str_ind_massive)
     {
         tokenize $obj ";" $buffer;
         if($buffer[0]==$znach)
         {
             $number=$buffer[1];
             break;
         }
     }
     return $number;
}
global proc float BOVER_10_2_f71c299bf7b53f7243b078a9990e581c(float $input)
{
   string $un=`currentUnit -query -linear`;
   float $output;
   float $coeff;
   if($un=="mm")
       $coeff=0.1;
   if($un=="cm")
       $coeff=1;
   if($un=="m")
       $coeff=100;
   if($un=="km")
       $coeff=100000;
   if($un=="in")
       $coeff=2.54;
   if($un=="ft")
       $coeff=30.48;
   if($un=="yd")
       $coeff=91.44;
   if($un=="mi")
       $coeff=160934.4;
    $output =  $input/$coeff;
    return $output;
}
global proc string BOVER_10_2_e8f0c3b3e6300189aca31ae83320ec92(string $node_name_mask)
{
	$connected_nodes=`listConnections -t node`;
	string $nodename;
	int $has_connect_to_recalculate=0;
	string $obj;
	for($obj in $connected_nodes)
		{
		   if(`gmatch $obj $node_name_mask`)
		   {
		   $nodename=$obj;
		   $has_connect_to_recalculate=1;
		   }
		}
		return  $nodename;
}
global proc string create_toggler_node_connections(string $toggler_items[], string $nodename)
{
    string $nodenames=`createNode blindDataTemplate -n $nodename`;
    string $attribname;
    for($i=0;$i<size($toggler_items); $i++)
    {
       $attribname=BOVER_10_2_65107bc37ea4a0d842be293fd78287a9("toggler" + $i, $nodenames);
       connectAttr -f ($toggler_items[$i] + ".visibility")   $attribname;
    }
	return  $nodenames;
}
global proc string[] BOVER_10_2_6c03bcf1c4cd077aea727f60dfb001f6(int $mode, string $nodename_mask)
{
    string $prevouos[];
    string $next[];
    string  $connected_items[];
    int $current_item_index;
    int $connected_items_size;
    $select_items=`ls-sl`;
    $j=0;
    string $all_connected_items[];
	string $top_connected_items[];
	string $doted_connected_items[];
    for($obj in $select_items)
    {
        select $obj;
        $nodename=BOVER_10_2_e8f0c3b3e6300189aca31ae83320ec92($nodename_mask);
        if($nodename!="")
        {
            $connected_items=`listConnections  -d 1 $nodename`;
            $connected_items_size =size($connected_items)-1;
            for ($i=0; $i<=$connected_items_size;$i++)
            {
              if($connected_items[$i]==$obj)
                    $current_item_index=$i;
            }
        }
        if($current_item_index!=0)
            $prevouos[$j]=$connected_items[$current_item_index -1];
        else
            $prevouos[$j]=$connected_items[$connected_items_size];
        if($current_item_index!=$connected_items_size)
            $next[$j]=$connected_items[$current_item_index+1];
        else
            $next[$j]=$connected_items[0];
        appendStringArray( $all_connected_items, $connected_items, `size $connected_items`);
		appendStringArray( $top_connected_items, $connected_items, 1);
		if($mode==3)
		    $doted_connected_items[$j]=stringArrayToString($connected_items,";");
		$j++;
    }
    $doted_connected_items=stringArrayRemoveDuplicates($doted_connected_items);
    $doted_connected_items=stringArrayRemove ({""}, $doted_connected_items);
	$all_connected_items=stringArrayRemoveDuplicates($all_connected_items);
	$top_connected_items=stringArrayRemoveDuplicates($top_connected_items);
	select $select_items;
	if(`size($doted_connected_items)`==1 && $doted_connected_items[0]=="")
	    $doted_connected_items={};
	if($mode==2)
		return $top_connected_items;
    if($mode==-1)
        return $prevouos;
    if($mode==1)
        return $next;
    if($mode==0)
        return $all_connected_items;
    if($mode==3)
        return $doted_connected_items;
}
global proc string[] BOVER_10_2_8ae38033eb9a9209547e3ebd30f57827(string $nodes_masks[], int $sel)
{
    string $all_nodes[]=`ls   $nodes_masks`;
    string $connected_items[]=`listConnections  -d 1 $all_nodes`;
    if ($sel)
        select $connected_items;
    return $connected_items;
}
global proc string BOVER_10_2_5be180667c9ec255cdbc3827fe30f0f2(string $object, string $node_name_mask)
{
	$connected_nodes=`listConnections -t node $object`;
	string $nodename;
	int $has_connect_to_recalculate=0;
	string $obj;
	for($obj in $connected_nodes)
		{
		   if(`gmatch $obj $node_name_mask`)
		   {
			   $nodename=$obj;
			   $has_connect_to_recalculate=1;
		   }
		}
		return  $nodename;
}
global proc BOVER_10_2_848792586ae790c92b963cff0a2f9f1e(string $nodename)
{
	string $selected[]=`ls-sl`;
	string $nodenames[];
	int $i=0;
	for ($obj in `ls-sl`)
	{
		$nodenames[$i]=BOVER_10_2_5be180667c9ec255cdbc3827fe30f0f2($obj, $nodename);
		$i++;
	}
	$nodenames=BOVER_10_2_194c7b09c27128a45486ac17560c7a25($nodenames);
	catch(`delete $nodenames`);
	select $selected;
}
global proc BOVER_10_2_f97932bf0a9a89d861a2c21323a52981(float $Lock_Size, float $Joint_Size)
{
	string $selection[] = `ls-sl`;
	global string $BARN_curve_sword_remember_BASE_SYSTEM[];
	global string $BARN_curve_sword_remember_DELETE_AFTER_BAKE[];
	string $aim_top = $selection[0];
	string $aim_side = $selection[1];
	string $sword  = $selection[2];
	string $whrist = $selection[3];
	string $hand_lock = $selection[4];
	$num_sel = size($selection);
	if($num_sel==5)
	{
		$whrist = $selection[3];
		$hand_lock = $selection[4];
	}
	else if($num_sel==4)
		$hand_lock = $selection[3];
	else
        warning "Need select Sword, Hand or Wrist and Hand";
	$aim_p_constr=BOVER_10_2_17431451b1be026fdeee93b86579c6b6({$sword,$sword}, {$aim_top,$aim_side});
	BOVER_10_2_4b209c5c00abddc3e3509a14326e2488( {$aim_top,$aim_side},"OverRig_knots");
	select -r $hand_lock;
	BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0;
	BOVER_10_2_d68451d42d330e385dd0c090bd6877a0("Sword_sys_");
	$BARN_curve_sword_remember_BASE_SYSTEM=`ls-sl`;
		BOVER_10_2_4b209c5c00abddc3e3509a14326e2488($BARN_curve_sword_remember_BASE_SYSTEM,"OverRig_knots");
	string $hand_SWST_lock[] = `ls-sl`;
	BOVER_10_2_6de8028af587b467034457b4d6349f89($Lock_Size/1.5);
	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(13);
	string $or_cnstr;
	select -r $hand_lock $hand_SWST_lock;
	$or_cnstr=BOVER_10_2_e0b44e5f427a869b704a743cf1d3614c();
	BOVER_10_2_e9a3d5ffe283044f2485219b12ac5f73({$or_cnstr},1);
	select -r $aim_top $aim_side $hand_SWST_lock;
	BOVER_10_2_18ecfb9c58f1a9c19cff7819d9a88813(`ls-sl`, {0.9,0.5,0.5});
	$or_cnstr=BOVER_10_2_29a2189faa1ce9571a1184989dc7f462();
	BOVER_10_2_e9a3d5ffe283044f2485219b12ac5f73({$or_cnstr},1);
	select -r $hand_SWST_lock $sword ;
	BOVER_10_2_f2d5a2798ed7cfee36eb77ee8a281ed8;
	BOVER_10_2_d68451d42d330e385dd0c090bd6877a0("Sword_sys_");
	$hand_SWST_jnts = `ls-sl`;
	BOVER_10_2_15760bd5ac6225f582185bab24346a67($Joint_Size);
	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(18);
	select -r $hand_SWST_jnts[0] $hand_SWST_lock;
	parent;
	makeIdentity -apply true -t 0 -r 1 -s 0 -n 0;
	joint -e -oj xyz -secondaryAxisOrient xup -ch -zso;
	select -r $aim_top $aim_side $hand_SWST_jnts[1];
	BOVER_10_2_29a2189faa1ce9571a1184989dc7f462();
	select $hand_SWST_jnts[1];
	$sword_correct_lock=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
	$sword_correct_lock=BOVER_10_2_e706e982298fe9e8f94ae04b06b5d6b2("Sword_Correct_by_len");
	BOVER_10_2_c89bf830cdb2b9cc874e6c8604e8b257;
	parent $sword_correct_lock $hand_SWST_jnts[1];
	BOVER_10_2_6de8028af587b467034457b4d6349f89($Lock_Size/1.6);
	setAttr ($sword_correct_lock[0] + ".localScaleY") 0;
	BOVER_10_2_74b3586ec5f33152020ca1d5764043c3();
	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(13);
	select -r $sword  $hand_SWST_jnts[1];
	BOVER_10_2_e0b44e5f427a869b704a743cf1d3614c;
	if($num_sel==5)
	{
		select -r $whrist  $hand_SWST_jnts[0];
		BOVER_10_2_dfb2ed0c2c53945ca7515c674763faa0();
	}
	else
	{
		select -r $hand_lock $hand_SWST_jnts[0];
		BOVER_10_2_dfb2ed0c2c53945ca7515c674763faa0();
	}
	select -r $hand_SWST_jnts $hand_SWST_lock;
	BOVER_10_2_c89bf830cdb2b9cc874e6c8604e8b257;
	select -tgl $hand_SWST_jnts[0];
	BOVER_10_2_b6a5017ee305f5ba0bbf3116243cc3af;
	select -r $hand_SWST_jnts[0];
	BOVER_10_2_1f3f21e017b74355329202016bf1b177;
	select -r $hand_SWST_jnts $hand_SWST_lock $aim_top $aim_side;
	BOVER_10_2_de88efca2929f0080ae1d45ff5db42d4;
	delete $aim_p_constr;
	select -r $sword_correct_lock[0] $sword ;
	BOVER_10_2_3ed0416e2547f09f133c132ecd5ccd97;
	select -r $hand_SWST_jnts[1];
	BOVER_10_2_b76d22f29f0df28efe8f00a67d5635f7(2);
	group -r;
	xform -os -piv 0 0 0;
	BOVER_10_2_d68451d42d330e385dd0c090bd6877a0("Sword_sys_");
	$gr_name=`ls-sl`;
	BOVER_10_2_c89bf830cdb2b9cc874e6c8604e8b257;
	BOVER_10_2_e9a3d5ffe283044f2485219b12ac5f73( $hand_SWST_jnts,1);
	if($num_sel==5)
	{
		select -r  $gr_name[0] $whrist ;
		BOVER_10_2_dfb2ed0c2c53945ca7515c674763faa0;
	}
	else
	{
		select -r  $gr_name[0] $hand_lock;
		BOVER_10_2_dfb2ed0c2c53945ca7515c674763faa0;
	}
	select -r  $gr_name[0] $hand_lock;
	BOVER_10_2_e0b44e5f427a869b704a743cf1d3614c;
	select -r  $hand_SWST_jnts[0];
	euler_filter_on_selected;
	select -r $hand_SWST_jnts;
	BOVER_10_2_b76d22f29f0df28efe8f00a67d5635f7(2);
	BOVER_10_2_d68451d42d330e385dd0c090bd6877a0("h_");
	select -r $aim_top $aim_side;
	cutKey -cl -t ":" -f ":" -at "rx" -at "ry" -at "rz" $aim_top $aim_side;
	BOVER_10_2_b6a5017ee305f5ba0bbf3116243cc3af;
	select -r $aim_top;
	$BARN_curve_sword_remember_DELETE_AFTER_BAKE={$aim_top, $aim_side,$hand_SWST_lock[0]};
}
global proc BOVER_10_2_9b29b86e5de4ada4b19840df4e8973d5()
{
	$Names = `ls -sl`;
	$mt=`ls "motionTrail*"`;
	if(size($mt))
	{
		catchQuiet (`select $mt`);
		updateMotionTrail;
		select $Names;
	}
	else
		warning "No motion trails in scene";
}
global proc string[] BOVER_10_2_d1e3370b8e860ec07368697d9ae6b53b(string $objects[])
{
    string $connected_MT[]=`listHistory -f 1 -lf 0 -pdo 1 $objects`;
    $connected_MT=`ls -type motionTrail $connected_MT`;
    $connected_MT= stringArrayRemoveDuplicates(`listConnections -s 0 -d 1 $connected_MT`);
    return $connected_MT;
}
global proc BOVER_10_2_216cd5229394f893f58516bc1517892a(int $knots, int $bake_anim, int $create_MT, int $besier_mode)
{
	undoInfo -ock -cn "curve_motion_path";
	$maya_unit=`currentUnit -q -l`;
	if ($maya_unit!="cm")
	{
		currentUnit  -l cm;
	}
	optionVar -intValue animBlendingOpt 1;
	optionVar -intValue animBlendBrokenInputOpt 1;
	$mayaVersion = `getApplicationVersionAsFloat` ;
    string $eval_mode[];
    if ($mayaVersion>=2019)
    {
		python("from maya.plugin.evaluator.cache_preferences import CachePreferenceEnabled");
		python("CachePreferenceEnabled().set_value( False )");
    }
	global string $eval_mode[];
	if ($mayaVersion>=2016)
	{
		$eval_mode=`evaluationManager -q -mode`;
		evaluationManager -mode "off";
	}
	$knots-=1;
	int $degrees=3;
    if($knots<=1)
        $knots=1;
	float $frame_range[]=BOVER_10_2_dfc2513778a513e560ec81c8f3df6563();
	if( ($frame_range[1]- $frame_range[0])==1)
	{
		warning "need select framerange!!!!";
		currentUnit  -l $maya_unit;
		evaluationManager -mode $eval_mode;
		undoInfo -cck;
		return;
	}
	string $selection[]=`ls-sl`;
	if( size($selection)==0)
	{
		warning "need select object!!!!";
		currentUnit  -l $maya_unit;
		evaluationManager -mode $eval_mode;
		undoInfo -cck;
		return;
	}
	global string $BARN_curve_motion_path_remember1[];
	global string $BARN_curve_motion_path_remember2[];
	global string $BARN_curve_motion_path_remember3[];
	BOVER_10_2_ac692345fba3e827ad5d6e26de39ba07;
	$BARN_curve_motion_path_remember1=$selection;
	BOVER_10_2_4b209c5c00abddc3e3509a14326e2488({$selection[0]},"OverRig_rig_objects");
	int $mt_error=catchQuiet($mot_tra=`snapshot  -motionTrail 1  -increment 1 -startTime $frame_range[0] -endTime ($frame_range[1]-1) $selection[0]`);
	if( $mt_error)
	{
		warning "something wrong, may be you select vertex???";
		currentUnit  -l $maya_unit;
		evaluationManager -mode $eval_mode;
		undoInfo -cck;
		return;
	}
	string $motion_trails[]=`ls -type motionTrail`;
	if(size($motion_trails)!=0)
    	for($obj in $motion_trails)
            catchQuiet (`setAttr ($obj + ".nodeState") 2`);
	vector $coords[]=BOVER_10_2_4ad38bb85176eb981038083a281c91d6($selection[0], {$frame_range[0],$frame_range[1]-1});
	string $curve_name=BOVER_10_2_83a9015d514ecd1326a1648b28396ba2($coords,1);
	string $cuve_dubli[];
	if($bake_anim)
	{
		$cuve_dubli=`duplicate -rr $curve_name`;
		$dup_cuve_shapes=BOVER_10_2_5e702211108f11813c411c94f8b1b380($cuve_dubli[0]);
		setAttr ($dup_cuve_shapes[0] +".dispCV") 1;
		select $cuve_dubli;
		BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(13);
	}
	string $curves[]=`rebuildCurve -ch 1 -rpo 1 -rt 0 -end 1 -kr 0 -kcp 0 -kep 1 -kt 0 -s $knots -d $degrees -tol 0.01 $curve_name`;
    string $cuv_shape[];
    int $colo[];
    int $numCVs;
    if($besier_mode)
    {
        select $curves;
        nurbsCurveToBezier;
        $numCVs = `getAttr -size ($curves[0] + ".controlPoints")`;
        $cuv_shape=BOVER_10_2_5e702211108f11813c411c94f8b1b380($curves[0]);
        setAttr ($cuv_shape[0] + ".dispCV") 1;
        $colo=BOVER_10_2_3de1f2433d756c53274925f7253b3c51({$curves[0]});
		BOVER_10_2_cc20e95399a3b6da44eb78e45451d764($colo[0]);
        setAttr -lock true ($cuv_shape[0] + ".cp[0].xv");
        setAttr -lock true ($cuv_shape[0] + ".cp[0].yv");
        setAttr -lock true ($cuv_shape[0] + ".cp[0].zv");
        setAttr -lock true ($cuv_shape[0] + ".cp[" + ($numCVs -1) + "].xv");
        setAttr -lock true ($cuv_shape[0] + ".cp[" + ($numCVs -1) + "].yv");
        setAttr -lock true ($cuv_shape[0] + ".cp[" + ($numCVs -1) + "].zv");
    }
    string $clusters[],$cluster_lock[];
    if(!$besier_mode)
    {
		for($i=1;$i<($knots+2);$i++)
		{
			$tmpp=`cluster ($curve_name + ".cv[" + $i + "]")`;
			$clusters[$i-1]=$tmpp[1];
		}
		select -cl;
		select $clusters;
		BOVER_10_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
		$cluster_lock=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
		BOVER_10_2_c89bf830cdb2b9cc874e6c8604e8b257;
		BOVER_10_2_b6a5017ee305f5ba0bbf3116243cc3af;
		BOVER_10_2_34cdd1e4469c2d3c695448db824d2ecb(1);
		$colo=BOVER_10_2_3de1f2433d756c53274925f7253b3c51({$cluster_lock[0]});
		BOVER_10_2_cc20e95399a3b6da44eb78e45451d764($colo[0]);
		BOVER_10_2_6de8028af587b467034457b4d6349f89(0.1);
		BOVER_10_2_4a0278149f801323f33f7bb9e4ee597d($cluster_lock,$clusters);
	}
	$lock_on_curve=`spaceLocator`;
	BOVER_10_2_3323b46f97bc12510f86536ae21ff525;
	$BARN_curve_motion_path_remember2=$lock_on_curve;
	BOVER_10_2_34cdd1e4469c2d3c695448db824d2ecb(1);
	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(13);
	BOVER_10_2_6de8028af587b467034457b4d6349f89(0);
	if(!$besier_mode)
		catchQuiet(`select $clusters $cluster_lock $curve_name $cuve_dubli`);
	else
		catchQuiet(`select $curve_name $cuve_dubli`);
	catchQuiet($gr_name=`group -w -n "curve_path"`);
	xform -piv 0 0 0;
	BOVER_10_2_4b209c5c00abddc3e3509a14326e2488(`ls-sl`,"OverRig_knots");
	BOVER_10_2_5fce4865a9fd47748e6796c1be9d64b2;
	$BARN_curve_motion_path_remember3=`ls-sl`;
	undoInfo -cck;
	$motion_path=BOVER_10_2_7b95c992be7b036735f7298f89ab9556($selection[0],$curve_name,$frame_range, $lock_on_curve[0],1);
	undoInfo -ock -cn "curve_motion_path";
	string $markers[]=BOVER_10_2_cfc20aa23531f881688ec3a171beaae5($motion_path);
	string $mark;
	$j=0;
	$i=0;
	string $colored_markers[];
	for ($mark in $markers)
	{
	    setAttr ($mark  +  ".lodVisibility") 0;
		setAttr ($mark  +  ".visibility") 0;
		setAttr ($mark  +  ".hideOnPlayback") 1;
		setAttr ($mark  +  ".hiddenInOutliner") 1;
		$marker_shape=BOVER_10_2_5e702211108f11813c411c94f8b1b380($mark);
		setAttr ($marker_shape[0]  +  ".lodVisibility") 0;
		setAttr ($marker_shape[0]  +  ".visibility") 0;
		setAttr ($marker_shape[0]  +  ".hideOnPlayback") 1;
		setAttr ($marker_shape[0]  +  ".hiddenInOutliner") 1;
	    if($j==4)
	    {
	        $j=0;
	        $colored_markers[$i]=$mark;
	        $i++;
	    }
	    $j++;
	}
	select $markers;
	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(8);
	select $colored_markers;
	print $colored_markers;
	BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(22);
    parent    $lock_on_curve $mot_tra $gr_name;
	string $p_constr[]=`parentConstraint -skipRotate x -skipRotate y -skipRotate z -weight 1 $lock_on_curve $selection[0]`;
	catch(BOVER_10_2_f0549514de82c9ee2236723b537462e7($lock_on_curve, {$p_constr[0]},"Curve_trajectory", $frame_range, 1));
	select $lock_on_curve;
	currentUnit  -l $maya_unit;
	evaluationManager -mode $eval_mode;
	 if(!$create_MT)
        delete $mot_tra[0];
	undoInfo -cck;
}
global proc string[] BOVER_10_2_89ca12a1050c943f0c5eb395eaa18d85(float $size_j)
{
    string $bake_grupp[],$option_dynamic_bone[],$inside_jnts[],$tempp[];
    string $selection[]=`ls-sl`;
    int $i=0;
    global string $bar_jiggle_plane[];
	$bar_jiggle_plane={};
    for($obj in $selection)
    {
        $tempp=BOVER_10_2_5a2b5b4dfd3b6570564880a01e903707($size_j);
        $bake_grupp[$i]= $tempp[0];
        $option_dynamic_bone[$i]=$tempp[1];
        $inside_jnts[$i]= $tempp[2];
		$bar_jiggle_plane[$i]= $tempp[3];
        $i++;
    }
    for($b in $option_dynamic_bone)
    		setAttr ($b + ".Enable") 0;
    BOVER_10_2_847308ac6f1debf8edcc8d63e128d64c($selection, $bake_grupp);
	BOVER_10_2_7f958423a7cfe1774157efdcb79ac0be($selection, $bake_grupp);
	BOVER_10_2_17431451b1be026fdeee93b86579c6b6($selection, $bake_grupp);
	select $bake_grupp;
	BOVER_10_2_de88efca2929f0080ae1d45ff5db42d4;
	euler_filter_on_selected;
	BOVER_10_2_17431451b1be026fdeee93b86579c6b6($inside_jnts, $selection);
	for($b in $option_dynamic_bone)
		setAttr ($b + ".Enable") 1;
	select $option_dynamic_bone;
    return $bake_grupp;
}
global proc string BOVER_10_2_7f3473239f5affa2a0790f0c6db6aaf9(string $clth_j[], float $len, float $sdvig,   float $sdvig_side, float $smooth_end, int $cycle,   int $abs_mode, int $save_edge, float $min_fr, float $max_fr, int $zero_percent, int $partial_mode)
{
    if(size($clth_j)<=1)
	{
		warning "select something!!";
		return "";
	}
	string $sv_edge_lock[],$layer,$edge_layer_name;
	string $hvost;
	float $scene_range[];
	float $min=`playbackOptions -q -ast`;
	float $max=`playbackOptions -q -aet`;
	$scene_range={$min,$max};
    if($save_edge)
    {
        select $clth_j;
        currentTime $min_fr;
        $sv_edge_lock=BOVER_10_2_24abb2efaf063b9b16a2b2c78969a384();
        setKeyframe -breakdown 0   -hierarchy none -controlPoints 0 -shape 1 $sv_edge_lock;
        currentTime $max_fr;
        BOVER_10_2_5e8af8371c687e5c50d7ded5040ffe13($clth_j, $sv_edge_lock);
        setKeyframe -breakdown 0   -hierarchy none -controlPoints 0 -shape 1 $sv_edge_lock;
    }
    $hvost =BOVER_10_2_ddf3e35ed988fd159dd82159edfce03a($clth_j, $len, $sdvig,   $sdvig_side,   $smooth_end,$cycle,   $abs_mode ) ;
    if ($hvost!="break")
    {
    	select $clth_j;
    	$layer=BOVER_10_2_c830bbb3bb6041f72a5fb76403fcabe8();
    	setAttr ($layer + ".rotationAccumulationMode") 1;
    	euler_filter_on_selected;
        if($partial_mode)
            BOVER_10_2_402263cc1b8de1e793411a0a2dc0e8ec({$layer}, $scene_range, 1.0, "flat", 0);
    	delete_constraint_attributes_on_objects($clth_j);
    	delete $hvost ;
        if($save_edge)
        {
            $edge_layer_name=BOVER_10_2_bdd2d2262c150fe16a261bb2e2e76046(1);
            currentTime $min_fr;
            BOVER_10_2_7f958423a7cfe1774157efdcb79ac0be($sv_edge_lock, $clth_j);
            setKeyframe -breakdown 0   -hierarchy none -controlPoints 0 -shape 1 $clth_j;
            currentTime ($min_fr + $zero_percent);
            setKeyframe -breakdown 0   -id -itt flat  -ott flat -dd true -hierarchy none -controlPoints 0 -shape 1 $clth_j;
            currentTime ($max_fr - $zero_percent);
            setKeyframe -breakdown 0   -id -itt flat  -ott flat -dd true -hierarchy none -controlPoints 0 -shape 1 $clth_j;
            currentTime $max_fr;
            BOVER_10_2_7f958423a7cfe1774157efdcb79ac0be($sv_edge_lock, $clth_j);
            setKeyframe -breakdown 0   -hierarchy none -controlPoints 0 -shape 1 $clth_j;
            delete $sv_edge_lock;
            animLayer -edit -parent $layer $edge_layer_name;
        }
    	select -cl;
    	if($save_edge)
    	{
    	    BOVER_10_2_92974e563427b6856d49efc764f12d33($edge_layer_name);
    	    rename $edge_layer_name "edge_additive";
    	}
    	else
    	    BOVER_10_2_92974e563427b6856d49efc764f12d33($layer);
    }
    return $layer;
}
global proc string BOVER_10_2_8bc545beef54e0c34e7362b4f7218a00(int $num_ctrl, float $ctrl_size)
{
    string $selected[]=`ls-sl`;
	if(size($selected)<1)
	{
		warning "select 2 or more object!";
		return "";
	}
	string $curve=BOVER_10_2_a8d1933a966541e62d79a2fcbf6e4ea4(2);
    string $jnts[]=`BOVER_10_2_2948842313131fcddb41ac6ad1efd38c`;
    BOVER_10_2_17431451b1be026fdeee93b86579c6b6($selected, $jnts);
    float $spine_lenght=BOVER_10_2_a358a7c27f7a7b80712d695138ed032e($selected, 0)/BOVER_10_2_f71c299bf7b53f7243b078a9990e581c(1);
    select -cl;
    string $ribbon_ctrl[];
    string $loc_crv[];
    string $loc_crv_gr[];
   if ($num_ctrl>=0)
    {
        $len=getAttr ($curve + ".maxValue");
        float $distrib=$len/($num_ctrl + 1.0);
        for($i=0;$i<=$num_ctrl+1;$i++)
            select -add ($curve + ".u[" + $distrib*$i + "]") ;
        $ribbon_ctrl=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
        select $curve $ribbon_ctrl;
        $loc_crv=BOVER_10_2_d646a70340f6ca544557c45c16b7a914(2, 1);
        $loc_crv_gr=`pickWalk -d up $loc_crv`;
        delete $ribbon_ctrl;
    }
     for($i=size($loc_crv)-2; $i>=0; $i=$i-1)
        aimConstraint -mo -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "objectrotation" -worldUpVector 0 0 1 -worldUpObject $loc_crv[$i+1] -skip y -skip z $loc_crv[$i+1] $loc_crv[$i];
    select $loc_crv[size($loc_crv)-1];
    $top_lock=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
    move -r -os -wd 0 ($spine_lenght/2) 0 $top_lock;
    parentConstraint -mo -weight 1 $loc_crv[size($loc_crv)-1] $top_lock;
    select  $top_lock;
    BOVER_10_2_de88efca2929f0080ae1d45ff5db42d4;
    aimConstraint -mo -weight 1 -aimVector 1 0 0 -upVector 0 1 0 -worldUpType "object" -worldUpObject $selected[0] $top_lock $loc_crv[size($loc_crv)-1];
    string $rib_ctrl_obj[]=$loc_crv;
    select $rib_ctrl_obj;
    $ribbon_ctrl=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
    BOVER_10_2_c89bf830cdb2b9cc874e6c8604e8b257;
    BOVER_10_2_17431451b1be026fdeee93b86579c6b6($rib_ctrl_obj, $ribbon_ctrl);
    string $rib_prop_gr[];
    if ($num_ctrl>0)
    {
        select -d $ribbon_ctrl[0] $ribbon_ctrl[size($ribbon_ctrl)-1] ;
        string $inner_rib_ctrls[]=`ls-sl`;
        $rib_prop_gr=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
        BOVER_10_2_e8fab4220afb7ebae48fab83681f71a5(0);
        rotate 0 0 0 $rib_prop_gr;
        select $ribbon_ctrl[0] $ribbon_ctrl[size($ribbon_ctrl)-1] $rib_prop_gr;
        BOVER_10_2_9713c7abe7f317a1eaefb22b30d9ce1c;
        for($i=0;$i<size($rib_prop_gr);$i++)
        {
            select $ribbon_ctrl[0] $ribbon_ctrl[size($ribbon_ctrl)-1];
            select -add $rib_prop_gr[$i];
            BOVER_10_2_b142decaa1526dfbc704c277d5c70c28;
        }
        BOVER_10_2_32a3829df17c3736d9757e423eeaf0e3($rib_prop_gr,$inner_rib_ctrls);
    	BOVER_10_2_90a059e9200ad500213586e0ecabdd0d($rib_prop_gr, 1,1,1,1);
    }
    select $jnts $ribbon_ctrl;
    BOVER_10_2_de88efca2929f0080ae1d45ff5db42d4;
    delete $jnts $curve $loc_crv_gr $top_lock;
    select $selected;
    string $inner[]=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
    BOVER_10_2_e8fab4220afb7ebae48fab83681f71a5(0);
    string $tot_gr=BOVER_10_2_c94e889a43233139ecf15566d05e5a78($ribbon_ctrl,$inner);
	BOVER_10_2_e9a3d5ffe283044f2485219b12ac5f73({$tot_gr},1);
    global string $ribbon_curve_rig_aimers_FloatMath_nodes[];
    select $selected;
    string $inner_in[]=BOVER_10_2_43f7908f4d02441c32d7d9e17f11c41d($inner, $selected);
    select $inner_in;
	BOVER_10_2_6de8028af587b467034457b4d6349f89($ctrl_size/3);
    BOVER_10_2_7b3fcad445e0b73cf535b7be3635a572();
    $inner_in=BOVER_10_2_10b1c67feba7e9570357d44ba9306692 ("",$selected,"_rib_ctrl");
    BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(18);
    select $ribbon_ctrl;
    BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(13);
    BOVER_10_2_6de8028af587b467034457b4d6349f89($ctrl_size);
    select $ribbon_ctrl[size($ribbon_ctrl)-1];
    BOVER_10_2_6de8028af587b467034457b4d6349f89($ctrl_size + $ctrl_size/2);
    BOVER_10_2_90a059e9200ad500213586e0ecabdd0d($inner, 1,1,1,1);
    BOVER_10_2_cc20e95399a3b6da44eb78e45451d764(22);
    select $ribbon_ctrl;
    BOVER_10_2_7b3fcad445e0b73cf535b7be3635a572();
    $ribbon_ctrl=BOVER_10_2_e706e982298fe9e8f94ae04b06b5d6b2("Ribbon_ctrls");
    string $fin_grpp=`group  $ribbon_ctrl[0] $ribbon_ctrl[size($ribbon_ctrl)-1] $rib_prop_gr  $tot_gr $inner`;
    $fin_grpp=`rename $fin_grpp "ribbon_bake_system"`;
     select $ribbon_ctrl[size($ribbon_ctrl)-1];
    return $fin_grpp;
}
global proc string BOVER_10_2_6d7498dd5c0b89568073ed9206fd5cd0(int $continuation_of_chain, int $orient_order)
{
    float $coeff=1.0;
	string $selection[]=`ls-sl`;
	string $start_point = $selection[0];
	string $end_point =$selection[size($selection)-1];
