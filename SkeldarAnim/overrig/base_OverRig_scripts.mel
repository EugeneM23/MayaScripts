global proc string BOVER_10_2_dfb2ed0c2c53945ca7515c674763faa0()
{
	string $obj[]=`ls-sl`;
	string $tmp_constr[];
	$rx_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".rx")`;
	$ry_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".ry")`;
	$rz_lock=`getAttr -lock ($obj[(size($obj)-1)] + ".rz")`;
	$h=$rx_lock+$ry_lock+$rz_lock;
	if ($h<3)
	{
		$skipX= "";
		$skipY= "";
		$skipZ= "";
		if($rx_lock)
			$skipX= " -skipRotate x";
		if($ry_lock)
			$skipY= " -skipRotate y";
		if($rz_lock)
			$skipZ= " -skipRotate z";
		string $objects = "";
		$skipped = $skipX + $skipY + $skipZ;
		for($i=0;$i<size($obj);$i++)
			$objects = $objects + $obj[$i] + " ";
		$tmp_constr=`eval ("parentConstraint -mo -skipTranslate x -skipTranslate y -skipTranslate z " + $skipped + " " + $objects)`;
	}
	return $tmp_constr[0];
}
