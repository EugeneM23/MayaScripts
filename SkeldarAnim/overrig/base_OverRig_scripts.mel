					-ebg true
					-l "1/2>"
					bb1_2;
			button -ann "open noise menue"
					-c "overRig_noise_window()"
					-w ($wt_small*1.5 +5) -h $height_small
					-bgc 0.7 0.880 0.7
					-ebg true
					-l "noise"
					b_noise;
			button -ann "open noise menue"
					-c "overRig_tween_window()"
					-w ($wt_small*1.5 +5) -h $height_small
					-bgc 0.7 0.880 0.7
					-ebg true
					-l "tween"
					b_tween;
			text "";
			button -ann "if keys selected - set inverse mirror keys by Z axis. Or set 1/2 inverse oscillate"
					-c " double_inv_oscillate_or_mirror(2,\"x\", \"z\")"
