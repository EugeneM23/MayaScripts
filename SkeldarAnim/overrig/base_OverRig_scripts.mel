    if(!$continuation_of_chain)
        select $bar_recalc_basee_lock $ANM_EASY_gr_spine_system;
	else
         select $bar_recalc_basee_lock[1] $ANM_EASY_gr_spine_system;
    BOVER_10_2_de88efca2929f0080ae1d45ff5db42d4;
    euler_filter_on_selected;
    delete_constraint_attributes_on_objects(`ls-sl`);
    if(!$continuation_of_chain)
        BOVER_10_2_17431451b1be026fdeee93b86579c6b6({ $bar_recalc_basee_lock[0]},{$bar_recalc_selected_objects[0]});
