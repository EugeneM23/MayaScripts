global proc BOVER_10_2_b5eac6c5d1d1e456134860b0acb0b451()
{
    if(`window -query -exists "multiple_parent_across"`)deleteUI("multiple_parent_across");
    window -title "multiple parent across" -sizeable 1 -titleBar true -minimizeButton false -maximizeButton false -menuBar false -toolbox true -titleBarMenu true   "multiple_parent_across";
    columnLayout -adj 1 -parent "multiple_parent_across" "mass_constr";
    global string $BAR_OVR_MPA_CONSTR_target[];
    global string $BAR_OVR_MPA_CONSTR_object[];
    global string $BAR_OVR_MPA_CONSTR_swap_object[];
                rowLayout   -parent "multiple_parent_across"  -numberOfColumns 7 "m_constr_row";
                    columnLayout  -parent "m_constr_row" "mcr_column";
                            rowLayout -parent "mcr_column"  -numberOfColumns 3  ;
                                button -command "print (\"in Targets \" + `size($BAR_OVR_MPA_CONSTR_target)` + \" objects\\n\");" -label "n" -annotation "print number of targets";
                                button -command "select $BAR_OVR_MPA_CONSTR_target; print (\"in Targets>>>\\n\"); print $BAR_OVR_MPA_CONSTR_target;" -label "S" -annotation "select targets";
                                button -command "$BAR_OVR_MPA_CONSTR_target=`ls -sl`; print (\"remember Targets>>>\\n\"); print $BAR_OVR_MPA_CONSTR_target;" -label "Targets" -w 50 -annotation "remember target object to which you need to contraints";
                                setParent..;
                            rowLayout -parent "mcr_column"  -numberOfColumns 3  ;
                                button -command "print (\"in Objects \" + `size($BAR_OVR_MPA_CONSTR_object)` + \" objects\\n\");" -label "n" -annotation "print number of objects";
                                button -command "select $BAR_OVR_MPA_CONSTR_object; print (\"in Objects>>>\\n\"); print $BAR_OVR_MPA_CONSTR_object;" -label "S" -annotation "select objects";
                                button -command "$BAR_OVR_MPA_CONSTR_object=`ls -sl`; print (\"remember Objects>>>\\n\"); print $BAR_OVR_MPA_CONSTR_object;" -label "Objects" -w 50 -annotation "remember object to contraints to Target";
								 setParent..;
						rowLayout -parent  "m_constr_row"  -numberOfColumns 11 "mcr_row";
                            button -command "$BAR_OVR_MPA_CONSTR_swap_object=$BAR_OVR_MPA_CONSTR_object; $BAR_OVR_MPA_CONSTR_object=$BAR_OVR_MPA_CONSTR_target; $BAR_OVR_MPA_CONSTR_target = $BAR_OVR_MPA_CONSTR_swap_object; print \"\\n swap Targets >>> Objects\\n\";" -label "swap" -annotation "swap Targets\Objects";
                            text "<<<";
                            button -command "BOVER_10_2_9f70c99453e90c76f29da27a6fc9915b( $BAR_OVR_MPA_CONSTR_target,$BAR_OVR_MPA_CONSTR_object,`checkBox -q -v mAcross_r`,`checkBox -q -v mAcross_t`,1);" -label "across" -h 50 -w 60 -annotation "multiple parent across the same number of objects Objects>Targets";
							columnLayout ;
								checkBox -v 1 -ann "Rotation"    -l "rotation"     mAcross_r;
								checkBox -v 1 -ann "Transtation" -l "translation"  mAcross_t;
							setParent..;
    	showWindow "multiple_parent_across";
}
