 bake_BOR_fr_lay_ui;
{
columnLayout -adj 1 bake_BOR_fr_column;
	rowLayout  -nc 4  -adj 4 -p "bake_BOR_fr_column";
		nodeIconButton -style "iconAndTextHorizontal"
			-image1 "nudgeDown.png"
			-ann "fast bake selected"
 				-c "apply_Fast_Bake"
				-w 61
				-h $ikh
				-l "bake"
				bbake;
				popupMenu -button 3 -parent bbake;
					menuItem -label "bake min max or range" -ann "bake selected min-max or framerange (save outside keys)" -command "apply_range_Fast_Bake()";
		nodeIconButton -style "iconAndTextHorizontal"
			-image1 "nudgeDown.png"
				-ann "fast bake selected to override layer"
 				-c " apply_Bake_to_layer"
				-w 61
				-h $ikh
				-l ">layer"
				bto_layer;
				popupMenu -button 3 -parent bto_layer;
					menuItem -label "bake to Overide min max or range" -ann "bake selected min-max or framerange (save outside keys)" -command "apply_range_Bake_to_Over_layer()";
		button
				-ann "delete Constraint channels from objects"
				-c " delete_constraint_attributes_on_objects(`ls-sl`);"
				-w 40
				-h $ikh
				-l "delCH"
				BdelCH;
		button -ann "show display if something doing wrong"
 				-c "OVR_en_viewport()"
				-w 16 -h 20 -l "vp";
	rowLayout -nc 2 -adj 1 -p "bake_BOR_fr_column";
		nodeIconButton -style "iconAndTextHorizontal"
			-image1 "nudgeDown.png"
			-ann "select all rig source objects, bake, and delete knot objects"
			-c " barn_fast_bake_source_obj_and_delete_knots();"
			-h $ikh
			-l "bake source and delete"
			BS_and_del;
		popupMenu -button 3  -parent BS_and_del;
					menuItem -label "bake min max or range" -ann "select all rig source objects, bake, and delete knot objects on min-max or framerange (save outside keys)" -command "barn_fast_bake_min_max_or_range_source_obj_and_delete_knots()";
button -ann "fast euler filter from zero"
 				-c " euler_filter_on_selected();"
				   -l "euler" EUler_ovrrg;
}
frameLayout -ann $Overrig_version
	-p "ovrrig_columnLayout1_ui"
