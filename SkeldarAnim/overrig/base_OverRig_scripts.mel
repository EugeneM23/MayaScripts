 -l "hierarchy"
 -la "top"
 -lw $lf_w  -mw 0 -cc "catchQuiet(`window -e -h 100 basicOverRigScripts`)"
 hierarchy_BOR_fr_lay_ui;
{
	rowLayout    -nc 3;
		button -ann "bakes animation of selected objects to forward chain of bones (this allows the rig to be controlled like a single chain)"
 				-c "apply_ForwHierarhy (1)"
				-w 54
				-h $ikh
				-ebg true
				-l "forward"
				bforward;
		button -ann "bakes animation of selected objects to REVERS chain of bones (this allows the rig to be controlled like a single chain)"
 				-c "apply_ReverseHierarhy (1)"
				-w 59
				-h $ikh
				-l "reverse"
				breverse;
		button
		-ann "bake selected chain on Spine rig. First selected - baking as ROOT controller"
				-w 68
				-h $ikh
 				-c "create_recalc_spine_rig_menue()"
				-l "vertebra"
				b_spine_rig;
}
frameLayout -ann $Overrig_version -p "ovrrig_columnLayout1_ui"
