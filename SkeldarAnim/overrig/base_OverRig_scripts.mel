global proc string[] BOVER_10_2_8a435c1e94becce7728e63b61ba412bd(float $radius)
{
	$selection = `ls -fl -sl `;
	string $curve_sphere[];
	if(size($selection)>0)
	{
		for($i=0;$i<size($selection);$i++)
			$curve_sphere[$i]=BOVER_10_2_1a0417e38be183894da98c3ef5716f0d($radius);
		BOVER_10_2_847308ac6f1debf8edcc8d63e128d64c( $selection, $curve_sphere);
		BOVER_10_2_7f958423a7cfe1774157efdcb79ac0be( $selection,$curve_sphere);
	}
	else
		$curve_sphere[0]=BOVER_10_2_1a0417e38be183894da98c3ef5716f0d($radius);
	BOVER_10_2_a204d82b0cc11ef9adf835ab99270c74($curve_sphere);
	select $curve_sphere ;
	return $curve_sphere;
}
global proc string BOVER_10_2_1a0417e38be183894da98c3ef5716f0d(float $radius)
{
	string $curves[];
	$crv=`curve -d 1
        -p 0  0.5  0
        -p 0  -0.5  0
        -p 0  0  0
        -p 0.5  0  0
        -p -0.5  0  0
        -p 0  0  0
        -p 0  0  0.5
        -p 0  0  -0.5 ` ;
        scale -a (1*$radius) (1*$radius) (1*$radius)  $crv;
        makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
        select $crv;
        return $crv;
}
global proc string BOVER_10_2_c31045748f3c557589184e51283ed2cd(float $radius)
{
	string $curves[];
	$crv=`curve -d 1
        -p  -0.5 0.5 -0.5
        -p  -0.5 0.5 0.5
        -p  0.5 0.5 0.5
        -p 0.5 0.5 -0.5
        -p -0.5 0.5 -0.5
        -p -0.5 -0.5 -0.5
        -p 0.5 -0.5 -0.5
        -p 0.5 0.5 -0.5
        -p 0.5 0.5 0.5
        -p 0.5 -0.5 0.5
        -p 0.5 -0.5 -0.5
        -p -0.5 -0.5 -0.5
        -p -0.5 -0.5 0.5
        -p 0.5 -0.5 0.5
        -p 0.5 0.5 0.5
        -p -0.5 0.5 0.5
        -p -0.5 -0.5 0.5` ;
        scale -a (1*$radius) (1*$radius) (1*$radius)  $crv;
        makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1;
        select $crv;
        return $crv;
}
global proc string[] BOVER_10_2_95aedc626a621231a66a091788483a9e(string $curveName, int $sequent_parent)
{
	string $curve_Shape[] = `listRelatives -shapes -f -type "nurbsCurve" $curveName`;
	int $numCVs = `getAttr -size ($curve_Shape[0] + ".controlPoints")`;
	catchQuiet(`setAttr ($curve_Shape[0] + ".lockLength") 0`);
	string $loks[];
	string $clusters[], $tmppo[];
	for($i=0;$i< $numCVs;$i++)
	{
		$tmppo=`cluster ($curveName + ".cv[" + $i + "]")`;
		$clusters[$i]=$tmppo[1];
	}
	$loks=BOVER_10_2_526c020cd7c9a859fd08d49719a4fddf($clusters);
	BOVER_10_2_32a3829df17c3736d9757e423eeaf0e3($loks,$clusters);
	BOVER_10_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
	BOVER_10_2_113374ba19bc1f4dc9b1cc9706816f86($clusters);
	BOVER_10_2_b6a5017ee305f5ba0bbf3116243cc3af;
	BOVER_10_2_ade4e354383a28fcefcaf5ce40e6639d;
	BOVER_10_2_aa074854107180f09880ea0e8edd43f8;
	BOVER_10_2_8071326ac26a590fcb224ddba406d389();
	BOVER_10_2_1b3bfd1d62d966ea966f5caca72bac5d($clusters, 1);
	if($sequent_parent)
	{
		select  $loks;
		BOVER_10_2_f0209cb5b5931bdfa7ae6801db19a0f8;
	}
	return $loks;
}
global proc string[] BOVER_10_2_465f2c70f8e4bf417e93834f61ee4f6e(string $stroka, string $poisk)
{
	string $buffer[]={};
	string $fin_str=$stroka;
    $fin_str=BOVER_10_2_aaae31cd6214ce45ea5c64f8ba3950fa( $poisk, $fin_str,"###^@@@") ;
	tokenize $fin_str "^" $buffer;
	for($i=0;$i<size($buffer);$i++)
	{
	    $buffer[$i]=`substitute "###" $buffer[$i] ""`;
	    $buffer[$i]=`substitute "@@@" $buffer[$i] ""`;
	}
	return $buffer;
}
global proc string BOVER_10_2_aaae31cd6214ce45ea5c64f8ba3950fa(string $search, string $originalString, string $replace)
{
    string $prev= $originalString,$finstr;
    int $found=1;
    while ($found)
    {
        $finstr=`substitute $search  $prev $replace `;
        if($finstr==$prev)
            $found=0;
        $prev=$finstr;
    }
    return $finstr;
}
global proc BOVER_10_2_b8c78ceb987ce7e962297e68eebc8c12(string $base_obj, string $oriented_obj)
{
   $vec_lock=BOVER_10_2_5b85a4b79f18d1c94d20e84bce8d3507({ $base_obj, $base_obj, $base_obj, $base_obj, $base_obj, $base_obj});
    move -r-os 100 0 0 $vec_lock[0];
    move -r-os -100 0 0 $vec_lock[1];
    move -r-os 0 100 0 $vec_lock[2];
    move -r-os 0 -100 0 $vec_lock[3];
    move -r-os 0 0 100 $vec_lock[4];
    move -r-os 0 0 -100 $vec_lock[5];
   $axis_lock=BOVER_10_2_5b85a4b79f18d1c94d20e84bce8d3507({ $oriented_obj, $oriented_obj});
    move -r-os 100 0 0 $axis_lock[0];
    move -r-os   0 0  100 $axis_lock[1];
    float $min_distX=500;
    float $min_distZ=500;
    float $distX, $distZ;
    int $numX, $numZ;
    for($i=0;$i<6;$i++)
    {
        $distX=BOVER_10_2_c7822f1f10b007a6803735c105e40799($axis_lock[0] , $vec_lock[$i]);
        if($distX<$min_distX)
        {
            $min_distX=$distX;
            $numX=$i;
        }
        $distZ=BOVER_10_2_c7822f1f10b007a6803735c105e40799($axis_lock[1] , $vec_lock[$i]);
        if($distZ<$min_distZ)
        {
            $min_distZ=$distZ;
            $numZ=$i;
        }
    }
    delete (`aimConstraint -offset 0 0 0 -weight 1 -aimVector 0 0 1 -upVector 1 0 0 -worldUpType "object" -worldUpObject $vec_lock[$numX] $vec_lock[$numZ] $oriented_obj`);
    delete  $vec_lock $axis_lock;
}
global proc string[] BOVER_10_2_b7a3eaedfdd36f19d784ed92e904bc98(string $i1[], string $i2[], string $O[], int $operation_type)
{
	string $dump_mult_node= `createNode multiplyDivide`;
	float $tmp_var;
	string $attr;
	string $node;
	string $a;
    string $channels[]={".input1X",".input1Y",".input1Z"};
    int $i=0;
    for($a in $i1)
    {
        if($a!="")
        {
            $attr = `substitute "^[^.]*\\."  $a ""`;
            $node = `match "^[^\.]*" $a`;
            if(attributeExists($attr,$node))
                connectAttr -f $a ($dump_mult_node + $channels[$i]);
            else
            {
                $tmp_var=$a;
                setAttr ($dump_mult_node + $channels[$i]) $tmp_var;
            }
        }
        $i++;
    }
    $i=0;
    string $channels2[]={".input2X",".input2Y",".input2Z"};
    for($a in $i2)
    {
        if($a!="")
        {
            $attr = `substitute "^[^.]*\\."  $a ""`;
            $node = `match "^[^\.]*" $a`;
            if(attributeExists($attr,$node))
                connectAttr -f $a ($dump_mult_node + $channels2[$i]);
            else
            {
                $tmp_var=$a;
                setAttr ($dump_mult_node + $channels2[$i]) $tmp_var;
            }
        }
        $i++;
    }
    string $o_channels[]={".outputX",".outputY",".outputZ"};
    $i=0;
    for($a in $O)
    {
        if($a!="")
        {
            $attr = `substitute "^[^.]*\\."  $a ""`;
            $node = `match "^[^\.]*" $a`;
            if(attributeExists($attr,$node))
                connectAttr -f  ($dump_mult_node + $o_channels[$i]) $a;
            else
                warning ($a + "  not exists");
        }
        $i++;
    }
    setAttr ($dump_mult_node + ".operation")  $operation_type;
    return {$dump_mult_node + ".outputX",$dump_mult_node + ".outputY",$dump_mult_node + ".outputZ",$dump_mult_node};
}
global proc string[] BOVER_10_2_518c144ece64ffa54be80bdb48935d74(string $name, float $size, int $translate_output)
{
    string $text=BOVER_10_2_902ba8d3934f616530e335e4c6433f01($name, "Arial", $size/3,"center");
    setAttr  .overrideEnabled  1;
    setAttr  .overrideDisplayType  2;
    string $gr_up=`group -em -n ($name + "_group#")`;
    string $gr_ctrl[]=BOVER_10_2_e52ed91bd5c84901d59d7d8a0117fc7e(1);
    BOVER_10_2_19c8ef40419bea353742fe791e238558($gr_ctrl,3);
    $gr_ctrl[0]=`rename $gr_ctrl[0] ($name + "#")`;
    rotate -a -os -fo 0 -90 0 $gr_ctrl;
    scale $size $size $size $gr_ctrl;
    setAttr -keyable false -channelBox false ($gr_ctrl[0] + ".sx");
    setAttr -keyable false -channelBox false ($gr_ctrl[0] + ".sy");
    setAttr -keyable false -channelBox false ($gr_ctrl[0] + ".sz");
    string $md_rot_nodes[];
    string $md_tr_nodes[];
    if($translate_output)
    {
        addAttr -ln "pos_x"  -at double  -min 0   $gr_ctrl[0];
        addAttr -ln "pos_y"  -at double  -min 0   $gr_ctrl[0];
        addAttr -ln "pos_z"  -at double  -min 0   $gr_ctrl[0];
        addAttr -ln "position_mult"  -at double  -min 0   $gr_ctrl[0];
        setAttr -e -keyable true ($gr_ctrl[0] + ".position_mult") 1;
    }
    addAttr -ln "direction_x"  -at double  -min 0   $gr_ctrl[0];
    addAttr -ln "direction_y"  -at double  -min 0   $gr_ctrl[0];
    addAttr -ln "direction_z"  -at double  -min 0   $gr_ctrl[0];
    addAttr -ln "direction_mult"  -at double  -min 0   $gr_ctrl[0];
    setAttr -e -keyable true ($gr_ctrl[0] + ".direction_mult") 1;
	string $gr_calc=`group -em -n ($name + "_calc_gr#")`;
    pointConstraint $gr_ctrl $gr_calc;
    makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1 $gr_ctrl;
    string $up_lock[]=`spaceLocator -n ($name + "_out_vector#")`;
    string $gr_rot=`group -em -n ($name + "_rot_gr#")`;
    setAttr ($up_lock[0] + ".visibility") 0;
    move -a -ls -wd 0 0 1 $up_lock;
    parent $up_lock $gr_rot $text $gr_calc;
    parentConstraint -mo $gr_rot $up_lock;
    orientConstraint -mo  $gr_ctrl $gr_rot;
    parent $gr_ctrl $gr_calc $gr_up;
    $md_rot_nodes=BOVER_10_2_b7a3eaedfdd36f19d784ed92e904bc98({$up_lock[0] + ".translateX",$up_lock[0] + ".translateY",$up_lock[0] + ".translateZ"},{$gr_ctrl[0] + ".direction_mult",$gr_ctrl[0] + ".direction_mult",$gr_ctrl[0] + ".direction_mult"}, {$gr_ctrl[0] + ".direction_x",$gr_ctrl[0] + ".direction_y",$gr_ctrl[0] + ".direction_z"}, 1);
	setAttr -e -lock 1 -channelBox true ($gr_ctrl[0] + ".direction_x") ;
	setAttr -e -lock 1 -channelBox true ($gr_ctrl[0] + ".direction_y") ;
	setAttr -e -lock 1 -channelBox true ($gr_ctrl[0] + ".direction_z") ;
	setAttr ($md_rot_nodes[3] + ".isHistoricallyInteresting") 0;
    if($translate_output)
    {
        $md_tr_nodes=BOVER_10_2_b7a3eaedfdd36f19d784ed92e904bc98 ({$gr_calc + ".translateX",$gr_calc + ".translateY",$gr_calc + ".translateZ"},{$gr_ctrl[0] + ".position_mult",$gr_ctrl[0] + ".position_mult",$gr_ctrl[0] + ".position_mult"}, {$gr_ctrl[0] + ".pos_x",$gr_ctrl[0] + ".pos_y",$gr_ctrl[0] + ".pos_z"}, 1);
        setAttr -e -lock 1 -channelBox true ($gr_ctrl[0] + ".pos_x") ;
        setAttr -e -lock 1 -channelBox true ($gr_ctrl[0] + ".pos_y") ;
        setAttr -e -lock 1 -channelBox true ($gr_ctrl[0] + ".pos_z") ;
        setAttr ($md_tr_nodes[3] + ".isHistoricallyInteresting") 0;
    }
    BOVER_10_2_1b3bfd1d62d966ea966f5caca72bac5d({$gr_calc}, 1);
    BOVER_10_2_90a059e9200ad500213586e0ecabdd0d({$up_lock[0],$gr_calc, $gr_rot}, 1, 1, 1, 1) ;
    BOVER_10_2_90a059e9200ad500213586e0ecabdd0d($gr_ctrl, 0, 0, 0, 1) ;
    select $gr_ctrl[0];
    return {$gr_up,$gr_ctrl[0],$up_lock[0]};
}
global proc string BOVER_10_2_902ba8d3934f616530e335e4c6433f01(string $text, string $font, float $size, string $positioning)
{
    string $base_gr=`group -em -n ("tx_" + $text)`;
    string $curves[] = `textCurves -ch 0  -font $font -t $text`;
    string $axis=`upAxis -q -axis`;
    if($axis=="z")
        rotate -a -os -fo 90 0 0 $curves;
    string $shpss[];
    scale $size $size $size $curves[0];
    float $bbox[]=`exactWorldBoundingBox`;
    if($positioning == "center")
        move ($bbox[3]/-2) 0 0 $curves[0];
    if($positioning == "right")
        move ($bbox[3]*-1) 0 0 $curves[0];
    select -hi;
    string $sel_crve[]=BOVER_10_2_1ed150b12535ee196bee8b74a6bf5f5c(`ls-sl`, "nurbsCurve");
    $sel_crve=`parent $sel_crve $base_gr`;
    makeIdentity -apply true -t 1 -r 1 -s 1 -n 0 -pn 1 $sel_crve;
    makeIdentity -apply 0 -t 1 -r 1 -s 1 -n 0 -pn 1 $sel_crve;
    for($obj in $sel_crve)
    {
        $shpss=BOVER_10_2_5e702211108f11813c411c94f8b1b380($obj);
        parent -s -r $shpss $base_gr;
    }
	BOVER_10_2_a204d82b0cc11ef9adf835ab99270c74({$base_gr});
    delete $sel_crve $curves;
    select $base_gr;
    return $base_gr;
}
global proc string BOVER_10_2_c94e889a43233139ecf15566d05e5a78(string $controls[], string $selected_jnts[])
{
 	catchQuiet(`loadPlugin lookdevKit`);
	select $selected_jnts;
	int $num_control=size($controls);
	int $num=size($selected_jnts);
	string $base_curves_obj[]=BOVER_10_2_4874f5c758343518c484dc3cb8ee48b0(2, $num_control, 1, 1);
	string $base_curve_loc[]=`ls -head (size($base_curves_obj)-2)$base_curves_obj`;
	select $base_curve_loc;
	BOVER_10_2_a9acebc46d5277d92e6d954501ac53c7("x",  "up", "");
	string $curve_name[]=`ls  -tail 2 $base_curves_obj`;
	for($i=1;$i<$num-1;$i++)
		aimConstraint -offset 0 0 0 -weight 1 -aimVector 1 0 0 -upVector 0 0 1 -worldUpType "objectrotation" -worldUpVector 0 0 1 -worldUpObject $base_curve_loc[$i+1] $base_curve_loc[$i+1] $base_curve_loc[$i];
	select $base_curve_loc;
	string $lock_bottom_aim[]=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
	BOVER_10_2_32a3829df17c3736d9757e423eeaf0e3($base_curve_loc,$lock_bottom_aim);
	for($i=0;$i<$num-1;$i++)
		aimConstraint -offset 0 0 0 -weight 1 -aimVector -1 0 0 -upVector 0 0 1 -worldUpType "objectrotation" -worldUpVector 0 0 1 -worldUpObject $lock_bottom_aim[$i] $lock_bottom_aim[$i] $lock_bottom_aim[$i+1];
	select $base_curve_loc;
	string $rotator[]=BOVER_10_2_54d92f8424c4459e6d996d9fd93902f0();
	BOVER_10_2_32a3829df17c3736d9757e423eeaf0e3($base_curve_loc,$rotator);
	global string $ribbon_curve_rig_aimers_FloatMath_nodes[];
	$ribbon_curve_rig_aimers_FloatMath_nodes={};
	for($i=1;$i<$num-1;$i++)
	{
		string $float_math_node=`createNode floatMath`;
		appendStringArray($ribbon_curve_rig_aimers_FloatMath_nodes,{$float_math_node},1);
		connectAttr -f ($lock_bottom_aim[$i] + ".rotateX") ($float_math_node + ".floatA");
		setAttr ($float_math_node + ".operation") 2;
		float $distr=1-$i/($num*1.0);
		setAttr ($float_math_node + ".floatB") $distr;
		connectAttr -f  ($float_math_node + ".outFloat") ($rotator[$i] + ".rotateX");
	}
	BOVER_10_2_c99bdb5a898efbfb1d4fa2221eba881b($rotator,$selected_jnts);
	string $clusters[];
	string $tmpp[]=`cluster ($curve_name[0] + ".cv[0]") ($curve_name[0]  + ".cv[1]")`;
	float $pos[]=BOVER_10_2_174b5e03acbe9a8ba7bf83b031094a2e($controls[0]);
	move -a $pos[0] $pos[1] $pos[2] ($tmpp[1] + ".scalePivot") ($tmpp[1] + ".rotatePivot") ;
	$clusters[0]=$tmpp[1];
	$j=1;
	for($i=2;$i<$num_control;$i++)
	{
		$tmpp=`cluster ($curve_name[0] + ".cv[" + $i + "]") `;
		$pos=BOVER_10_2_174b5e03acbe9a8ba7bf83b031094a2e($controls[$j]);
		move -a $pos[0] $pos[1] $pos[2] ($tmpp[1] + ".scalePivot") ($tmpp[1] + ".rotatePivot") ;
		$clusters[$j]=$tmpp[1];
		$j++;
	}
	$tmpp=`cluster ($curve_name[0] + ".cv[" + $num_control + "]")  ($curve_name[0]  + ".cv[" + ($num_control + 1) + "]") `;
	$pos=BOVER_10_2_174b5e03acbe9a8ba7bf83b031094a2e($controls[$num_control -1]);
	move -a $pos[0] $pos[1] $pos[2] ($tmpp[1] + ".scalePivot") ($tmpp[1] + ".rotatePivot") ;
	$clusters[$num_control -1]=$tmpp[1];
	BOVER_10_2_17431451b1be026fdeee93b86579c6b6($controls, $clusters);
	select $controls[$num_control -1] $base_curve_loc[$num-1];
	BOVER_10_2_dfb2ed0c2c53945ca7515c674763faa0;
	select $controls[0] $base_curve_loc[0];
	BOVER_10_2_dfb2ed0c2c53945ca7515c674763faa0;
	string $fin_groupp=`group  $base_curve_loc $curve_name  $clusters`;
	xform -piv 0 0 0;
	BOVER_10_2_4c2952dd9f486573856c8eb6a0dc46ac(0);
	return $fin_groupp;
}
global proc string[] BOVER_10_2_d646a70340f6ca544557c45c16b7a914(int $second_obj_is_side, float $screen_size)
{
    string $selection[]=`ls-fl-sl`;
    string $objects[];
    string $side_obj;
    string $inner_obj[];
    $curve_name=$selection[0];
	vector $WUV_perp;
    if(size(`filterExpand -sm 9 $selection[0]`)==0)
    {
        warning "select curve first!!!\n ******************************************************";
        return {};
    }
    if($second_obj_is_side==1&&size($selection)<3)
    {
        warning "select 3 and more objects!!! Curve, side object and connect objects!!!!\n ******************************************************";
        return {};
    }
    if($second_obj_is_side==0&&size($selection)<2)
    {
        warning "select 2 and more objects!!! Curve and connect objects!!!!\n ******************************************************";
        return {};
    }
    if($second_obj_is_side==1)
    {
        $side_obj=$selection[1];
        $objects=`ls -tail (size($selection)-2) $selection`;
    }
    else if($second_obj_is_side==2)
	{
		$side_obj=$curve_name;
		$WUV_perp=BOVER_10_2_b2bb441f7665fb6e6f9e58a22cb5e462($curve_name);
        $objects=`ls -tail (size($selection)-1) $selection`;
	}
	else
    {
        $side_obj="";
        $objects=`ls -tail (size($selection)-1) $selection`;
    }
    for($object in $objects)
    {
        BOVER_10_2_97bb4fedbc7cf5833843579d493a26a3($curve_name, $side_obj, $object, $WUV_perp);
        appendStringArray($inner_obj,`ls-sl`,1);
    }
    select $inner_obj;
    BOVER_10_2_6de8028af587b467034457b4d6349f89($screen_size);
    return $inner_obj;
}
global proc string BOVER_10_2_97bb4fedbc7cf5833843579d493a26a3(string $curve_name, string $top_object, string $object, vector $WUV_perp)
{
	float $time=`currentTime-q`;
	select -cl;
	string $curve_movement_loc[]=BOVER_10_2_e6d1cc62e700198ddfd8906d663761ba();
	string $inside[]=`ls-sl`;
	$inside=BOVER_10_2_e706e982298fe9e8f94ae04b06b5d6b2($object + "_CRV");
	addAttr -ln "u"  -at double  -dv 0 $inside[0];
    setAttr -e-keyable true ($inside[0] + ".u");
    BOVER_10_2_90a059e9200ad500213586e0ecabdd0d($inside,0,0, 1,1) ;
	rotate 0 0 0 $inside;
	$curve_movement_loc[0]=`rename $curve_movement_loc "b_cuv_move"`;
	string $m_path;
	if ($top_object=="")
	    $m_path=`pathAnimation -fractionMode 0 -follow true -followAxis x -upAxis z -worldUpType "scene" -inverseUp false -inverseFront false -bank false -startTimeU $time -endTimeU $time $curve_name $curve_movement_loc[0]`;
	else if($curve_name==$top_object)
        $m_path=`pathAnimation -fractionMode 0 -follow true -followAxis x -upAxis z -worldUpType "objectrotation" -worldUpObject $curve_name  -worldUpVector ($WUV_perp.x) ($WUV_perp.y) ($WUV_perp.z) -inverseUp false -inverseFront false -bank false -startTimeU $time -endTimeU $time $curve_name $curve_movement_loc[0]`;
	else
	    $m_path=`pathAnimation -fractionMode 0 -follow true -followAxis x -upAxis z -worldUpType "object" -worldUpObject $top_object -inverseUp false -inverseFront false -bank false -startTimeU $time -endTimeU $time $curve_name $curve_movement_loc[0]`;
