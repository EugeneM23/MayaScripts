	if($end_lock[0]!="")
		select -d $objects[size($objects)-1];
	string $rot_lock[]=BOVER_10_2_24abb2efaf063b9b16a2b2c78969a384();
	string $currentPanel = `getPanel -withFocus`;
	catchQuiet(`isolateSelect -addSelectedObjects  $currentPanel`);
	BOVER_10_2_6de8028af587b467034457b4d6349f89(1);
	BOVER_10_2_34cdd1e4469c2d3c695448db824d2ecb(1);
	string $rot_gr[]=BOVER_10_2_9e011938cc58f7485f1dc49c9ffda589();
	BOVER_10_2_32a3829df17c3736d9757e423eeaf0e3($rot_gr,$rot_lock);
	$rot_lock=BOVER_10_2_c9088e941b7677113499bb19ad80f9bf ("rotate_piv_", $objects);
	BOVER_10_2_4a0278149f801323f33f7bb9e4ee597d($objects,$rot_lock);
	BOVER_10_2_c99bdb5a898efbfb1d4fa2221eba881b($rot_lock,$objects);
	BOVER_10_2_90a059e9200ad500213586e0ecabdd0d( $rot_lock ,1, 0, 1, 1);
	string $fin_gr=`group -n "ovr_temp_rotate_piv_gr#" $rot_gr `;
	xform -piv 0 0 0;
	select -cl;
	for($i=0;$i<size($rot_lock);$i++)
	    if($sel_ind[$i]!=-1)
	        select -add $rot_lock[$i];
	return $fin_gr;
}
